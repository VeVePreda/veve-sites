      {_p === 'duree' && <p class="etiq" style="margin:0 0 var(--s3)">Durée refusée : un entier de 0 à {JOURS_MAX} (0 retire).</p>}
      {_p === 'porte' && <p class="etiq" style="margin:0 0 var(--s3)">Porte inconnue.</p>}
      {_p === 'palier' && <p class="etiq" style="margin:0 0 var(--s3)">Palier inconnu.</p>}
      {_p === 'ecriture' && <p class="etiq" style="margin:0 0 var(--s3)">L’écriture a échoué — la base est-elle montée ?</p>}
      {_p === 'forme' && <p class="etiq" style="margin:0 0 var(--s3)">Formulaire illisible.</p>}

      {/* ⭐ LES SEPT PORTES SONT TOUJOURS TOUTES LISTÉES, surchargées ou non.
