---
// ⚠️ VeVePreda/veve-sites — src/pages/compte/index.astro  (FICHIER NEUF)
// ═══════════════════════════════════════════════════════════════════════════
// L'ESPACE MEMBRE — la première page qui dépend de QUI regarde.
// ═══════════════════════════════════════════════════════════════════════════
// ⚠️ `prerender` CONDITIONNEL, ET IL LE DOIT : une route `prerender = false`
// fait ÉCHOUER le build en mode static (NoAdapterInstalled). Même motif que
// src/pages/api/sante.js — c'est le contrat du socle hybride.
// ⛔ Conséquence à connaître : en mode static, cette page est PRÉ-GÉNÉRÉE, donc
// elle affichera toujours l'état « visiteur ». Ce n'est pas un bug, c'est ce
// que « statique » veut dire. veveprice tourne en `rendering: server`.
// ⭐ LITTERAL, ET C'EST LE POINT. Astro exige que `prerender` soit
// statiquement analysable ; une EXPRESSION n'est pas evaluee et retombe
// silencieusement sur `true`. La valeur reelle est posee par l'integration
// `veve:routes-compte` (engine/lib/astro_routes_compte.mjs) selon le mode du
// manifeste. `true` ici est le defaut SUR : sans adaptateur, un build static
// ne peut pas rendre cette route a la demande.
export const prerender = true;

import Base from '../../layouts/Base.astro';
import { manifest } from '../../../engine/lib/manifest.mjs';
import { acces, palierVisiteur, porte, franchit } from '../../../engine/lib/access.mjs';
import { t, localize, locales } from '../../../engine/lib/i18n.mjs';

// ⭐ CES PAGES SONT RENDUES À LA DEMANDE : elles peuvent donc lire l'en-tête
// `Accept-Language`, ce qu'une page pré-générée ne peut pas faire. Autant s'en
// servir — sinon un francophone connecté lit son compte en anglais.
// ⚠️ On ne fait confiance qu'aux langues que le SITE déclare : un en-tête est
// une donnée d'entrée comme une autre, il ne choisit pas dans un ensemble
// ouvert. `def` reste le repli, jamais une valeur devinée.
const { active, def } = locales();
const souhait = (Astro.request.headers.get('accept-language') || '')
  .split(',').map((x) => x.split(';')[0].trim().slice(0, 2).toLowerCase());
const lang = souhait.find((l) => active.includes(l)) || def;
const m = manifest();
const { tiers } = acces();
const palier = palierVisiteur(Astro.locals);
const connecte = palier !== 'visitor';

// ⭐ LES MODULES SONT TOUJOURS LISTÉS, MÊME VERROUILLÉS. Un membre non payant
// voit le NOM et la promesse de chaque module, jamais son contenu. C'est la
// différence entre « il n'y a rien ici » et « il y a quelque chose ici, et
// c'est à vous » — et c'est ce qui fait qu'un mur vend au lieu de frustrer.
// ⚠️ CE TABLEAU ÉTAIT EN FRANÇAIS, EN DUR — donc en français sur la page
// anglaise, en production. ⭐ Dans un dépôt multilingue, tout texte destiné à
// être lu est soit une clé i18n, soit une carte par langue. Jamais une chaîne
// nue dans un gabarit : c'est invisible au build, et `test:langues` ne le voit
// pas non plus (il mesure la couverture éditoriale, pas le code).
const MODULES = ['price_history', 'extremes', 'modules', 'alerts', 'wallet_watch']
  .map((cle) => ({ cle, nom: t(lang, `mod.${cle}`), d: t(lang, `mod.${cle}.d`) }));
---
      {/* ⛔ UNE SEULE LANGUE DÉCLARÉE, ET C'EST LE CORRECTIF DU 404.
          `/compte/` et `/connexion/` sont rendues À LA DEMANDE et lisent
          `Accept-Language` : elles n'ont qu'UNE adresse, sans préfixe. Sans
          `langs`, la barre de langues et les `hreflang` proposaient
          `/fr/compte/`, `/es/compte/`, `/de/compte/` — trois 404.
          ⭐ Le mécanisme existait déjà : Base.astro le porte depuis le 28/07,
          posé pour exactement cette raison — « un hreflang vers une URL absente
          est une promesse rompue faite à un moteur, et le sélecteur de langue,
          qui lit la même liste, y envoyait le visiteur ». Je l'ai recommis en
          créant deux pages neuves sans lire ce que le gabarit savait déjà. */}
<Base langs={[def]} lang={lang} path="/compte/" title={t(lang, 'account.title')}
      crumbs={[{ name: t(lang, 'home.crumb'), url: localize(lang, '/') }, { name: t(lang, 'account.title') }]}>

  <span class="logo logo--xl" aria-hidden="true">VP</span>
  <h1 class="mono-t">{t(lang, 'account.title')}</h1>

  {!connecte && (
    <section class="panneau champ" style="margin-bottom:var(--s5)">
      <h2 style="margin-top:0">{t(lang, 'account.signedout')}</h2>
      <p class="respire" style="margin-bottom:var(--s4)">{t(lang, 'account.signedout.d')}</p>
      {/* ⛔ UN BOUTON QUI NE MÈNE NULLE PART COÛTE PLUS CHER EN CONFIANCE QU'IL
          NE RAPPORTE EN PROMESSE. Tant que `offer.url` est vide, on n'affiche
          PAS d'appel à l'action — on affiche ce qui existe, et rien de plus. */}
      {m.offer?.url
        ? <a class="btn btn--principal btn--sm" href={m.offer.url}>{t(lang, 'account.subscribe')}</a>
        : <p class="muted">{t(lang, 'account.soon')}</p>}
    </section>
  )}

  {connecte && (
    <div class="stats">
      <div class="stat"><div class="k">{t(lang, 'account.tier')}</div><div class="v">{palier}</div></div>
      <div class="stat"><div class="k">{t(lang, 'account.alerts')}</div>
        {/* ⚠️ `-1` veut dire ILLIMITÉ et il faut le traduire ici : afficher
            « -1 alerte » serait un bug visible depuis la page d'accueil. */}
        <div class="v">{(() => { const c = porte('alerts').caps?.[palier]; return c === -1 ? '∞' : (c ?? 0); })()}</div></div>
    </div>
  )}

  {/* ⛔ `titre-affiche` etait un nom v3 : le theme ne l'habille plus.
      Le vocabulaire de la maquette dit `sect-t sect-t--gd`. */}
  <div class="sect-t sect-t--gd"><h2>{t(lang, 'account.modules')}</h2></div>
  <div class="modules">
    {MODULES.map((mo) => {
      const ouvert = franchit(mo.cle, Astro.locals);
      return (
        <div class={ouvert ? 'module module--ouvert' : 'module'}>
          <span class="module__n">{mo.nom}</span>
          <span class="module__d">{mo.d}</span>
          <div class="f" style="font-size:12px">
            {ouvert
              ? <span class="up">✓ {t(lang, 'account.open')}</span>
              : <span class="muted">🔒 {porte(mo.cle).tier}</span>}
          </div>
        </div>
      );
    })}
  </div>

  {/* ⭐ LA TRANSPARENCE EST UN ARGUMENT DE VENTE, PAS UNE CONCESSION. Dire quels
      paliers existent, y compris ceux qu'on n'a pas, est ce qui rend crédible
      la promesse de celui qu'on vend. */}
  <p class="etiq" style="margin-top:var(--s5)">
    {t(lang, 'account.tiers')} : {tiers.join(' · ')}
  </p>
</Base>
