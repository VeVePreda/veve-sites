            <input class="champ" name="jours" type="number" min="1" max={JOURS_MAX} value="7"
                   required aria-label={`jours pour ${x.nom}`} style="width:90px" />
            <button class="btn btn--sm" type="submit">Poser</button>
          </form>
          {(x.surchargee || x.expiree) && (
            <form method="POST" action="/api/portes" style="margin:8px 0 0">
              <input type="hidden" name="porte" value={x.nom} />
              <input type="hidden" name="jours" value="0" />
