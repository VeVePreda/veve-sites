  {connecte && (
  <>
  <div class="sect-t sect-t--gd"><h2>{t(lang, 'account.del')}</h2></div>
  <details style="margin-bottom:var(--s5)">
    <summary class="etiq" style="cursor:pointer;padding:var(--s3) 0">{t(lang, 'account.del.open')}</summary>
    <section class="panneau champ" style="margin-top:var(--s3)">
      <p class="respire" style="margin:0 0 var(--s4)">{t(lang, 'account.del.d')}</p>
      <form method="POST" action="/api/supprimer" style="margin:0">
        <label class="etiq" for="conf" style="display:block;margin-bottom:6px">{t(lang, 'account.del.ask')}</label>
