        </p>
        {monVu && (
          <p class="muted" style="font-size:13px;margin:0 0 var(--s3)">
            {monVu.expire
              ? `Dernière observation (« ${monVu.palier} ») expirée — votre palier réel a repris la main.`
              : `En cours : « ${monVu.palier} », jusqu’à ${new Date(monVu.jusqu_a).toISOString().slice(11, 16)} UTC.`}
          </p>
        )}
        <form method="POST" action="/api/palier-vu"
              style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
          <select class="champ" name="palier" aria-label="palier à observer" style="max-width:150px">
            <option value="visitor">visitor</option>
            <option value="member">member</option>
            <option value="crevette">crevette</option>
            <option value="langouste">langouste</option>
            <option value="whale">whale</option>
          </select>
          {/* ⛔ `required`, `min` et `max` : du confort. La borne qui COMPTE
              est dans `/api/palier-vu` ET dans le magasin — deux fois, parce
              qu'une élévation de privilège n'a pas droit à une seule garde. */}
          <input class="champ" name="minutes" type="number" min="1" max={MINUTES_MAX}
                 value={MINUTES_DEFAUT} required aria-label="durée en minutes" style="width:90px" />
          <button class="btn btn--sm" type="submit">Observer</button>
        </form>
        {monVu && !monVu.expire && (
          <form method="POST" action="/api/palier-vu" style="margin:8px 0 0">
