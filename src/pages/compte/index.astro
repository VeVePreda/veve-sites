---
// ⚠️ VeVePreda/veve-sites — src/pages/compte/index.astro  (FICHIER NEUF)
// ═══════════════════════════════════════════════════════════════════════════
// L'ESPACE MEMBRE — la première page qui dépend de QUI regarde.
// ═══════════════════════════════════════════════════════════════════════════
// ⚠️ `prerender` CONDITIONNEL, ET IL LE DOIT : une route `prerender = false`
// fait ÉCHOUER le build en mode static (NoAdapterInstalled). Même motif que
// src/pages/api/sante.js — c'est le contrat du socle hybride.
// ⛔ Conséquence à connaître : en mode static, cette page est PRÉ-GÉNÉRÉE, donc
// elle affichera toujours l'état « visiteur ». Ce n'est pas un bug, c'est ce
// que « statique » veut dire. veveprice tourne en `rendering: server`.
// ⭐ LITTERAL, ET C'EST LE POINT. Astro exige que `prerender` soit
// statiquement analysable ; une EXPRESSION n'est pas evaluee et retombe
// silencieusement sur `true`. La valeur reelle est posee par l'integration
// `veve:routes-compte` (engine/lib/astro_routes_compte.mjs) selon le mode du
// manifeste. `true` ici est le defaut SUR : sans adaptateur, un build static
// ne peut pas rendre cette route a la demande.
export const prerender = true;

import Base from '../../layouts/Base.astro';
import { manifest } from '../../../engine/lib/manifest.mjs';
import { acces, palierVisiteur, porte, franchit, sessionDe } from '../../../engine/lib/access.mjs';
import { t, localize, locales, localeNames } from '../../../engine/lib/i18n.mjs';
import { comptesActifs } from '../../../engine/lib/features.mjs';

// ⭐ CES PAGES SONT RENDUES À LA DEMANDE : elles peuvent donc lire l'en-tête
// `Accept-Language`, ce qu'une page pré-générée ne peut pas faire. Autant s'en
// servir — sinon un francophone connecté lit son compte en anglais.
// ⚠️ On ne fait confiance qu'aux langues que le SITE déclare : un en-tête est
// une donnée d'entrée comme une autre, il ne choisit pas dans un ensemble
// ouvert. `def` reste le repli, jamais une valeur devinée.
const { active, def } = locales();
const souhait = (Astro.request.headers.get('accept-language') || '')
  .split(',').map((x) => x.split(';')[0].trim().slice(0, 2).toLowerCase());
const lang = souhait.find((l) => active.includes(l)) || def;
const m = manifest();
const { tiers } = acces();
// ⛔ DÉCISION PREDA DU 03/08/2026 : vevewiki n'aura JAMAIS d'espace membre.
// La question était ouverte depuis le lot 42 ; elle est close, on ne la
// repose pas.
// ⭐ Même dispositif que `/inscription/` : un `redirect` produit un talon que
// l'intégration `veve:fonctionnalites-eteintes` efface ensuite. Les deux
// moitiés vont ENSEMBLE — ce `redirect` seul laisserait une page fantôme, et
// l'audit SEO rouge en permanence (le défaut du 27/07).
if (!comptesActifs()) return Astro.redirect('/');

const palier = palierVisiteur(Astro.locals);
// 🔴🔴 CORRIGÉ LE 06/08/2026 — `connecte` LISAIT LE PALIER, DONC IL MENTAIT.
// Sous `access.demo: crevette`, tout visiteur portait un palier : cette page
// annonçait « connecté » à quelqu'un qui n'avait jamais eu de compte, et
// `/connexion/` lui proposait de se déconnecter de rien.
// ⭐⭐⭐ LE PALIER DIT CE QU'ON A LE DROIT DE VOIR, LA SESSION DIT QUI ON EST.
const session = sessionDe(Astro.locals);
const connecte = session === 'reelle';
const enDemo = session === 'demo';

// ═══════════════════════════════════════════════════════════════════════════
// 🔴 IL N'Y A PAS DE PAGE COMPTE PUBLIQUE — arbitrage Preda du 06/08/2026.
// ═══════════════════════════════════════════════════════════════════════════
// Jusqu'ici cette page servait DEUX choses à qui n'avait pas de session : un
// panneau « vous n'êtes pas connecté » et la liste des réglages, affichée
// verrouillée. C'était le bon choix TANT QU'AUCUN SERVICE D'IDENTITÉ N'EXISTAIT
// — le commentaire ci-dessous le disait : « réserver le bloc aux membres le
// rendrait invisible à tout le monde, y compris à Preda ».
// ⭐⭐ CETTE JUSTIFICATION A EXPIRÉ LE 06/08 À 15 h, quand l'inscription par
// courriel est passée en production. Un avertissement qui survit à sa cause
// devient un mensonge qui se cite : la raison d'être du repli, c'était
// l'absence du service ; le service existe.
//
// ⭐ ON REDIRIGE VERS `/connexion/` ET NON VERS `/inscription/` : quelqu'un qui
// tape `/compte/` a déjà un compte, dans neuf cas sur dix. La page de connexion
// porte le lien vers l'inscription ; l'inverse n'est pas vrai.
// ⛔ ET NON UN 404 : un membre dont la session a expiré au bout de trente jours
// tomberait sur une erreur au lieu d'une porte.
//
// 🔴🔴 `locals.rendu` ET NON `Astro.isPrerendered`. Sur une page PRÉ-GÉNÉRÉE,
// il n'y a pas de visiteur : personne n'est jamais connecté, donc cette
// redirection se figerait DANS LE FICHIER et /compte/ deviendrait un renvoi
// permanent — y compris pour un abonné. Le drapeau est posé par
// `src/middleware.js`, juste sous la ligne qui décide (`isPrerendered`), et
// vaut `undefined` partout ailleurs. ⭐ On lit le signal du dépôt, pas une
// propriété du framework dont le nom et le sens changent de version en
// version : ici, se tromper ferme la porte à tout le monde sans une erreur.
const aLaDemande = Astro.locals?.rendu === 'demande';
// ⭐ `enDemo` PASSE, ET IL LE DOIT. Le jeton nominatif signé donne un palier
// sans identité — et c'est SUR CETTE PAGE que vit le seul bouton pour en
// sortir (`/api/demo?sortir=1`). L'oublier enfermerait la démonstration : on
// verrait la vue d'un abonné sans plus aucun moyen de la refermer.
if (aLaDemande && !connecte && !enDemo) return Astro.redirect('/connexion/', 302);
// 🌐🎨 Les réglages descendent ICI (demande de Preda du 06/08). Le gabarit ne
// le décide pas : le manifeste le dit, comme pour tout le reste du moteur.
const reglagesIci = (m.identity?.langues_dans === 'compte') || (m.identity?.theme_dans === 'compte');
const langueIci = m.identity?.langues_dans === 'compte';
const themeIci = m.identity?.theme_dans === 'compte';
// ⚠️ Cette page n'a QU'UNE adresse (elle lit `Accept-Language`) : pour changer
// de langue on envoie vers l'ACCUEIL de la langue voulue, pas vers /xx/compte/
// qui n'existe pas. C'est la même raison qui impose `langs={[def]}` plus bas.
const languesDispo = active.map((l) => ({ l, n: localeNames[l] || l.toUpperCase(), h: localize(l, '/') }));

// ⭐ LES MODULES SONT TOUJOURS LISTÉS, MÊME VERROUILLÉS. Un membre non payant
// voit le NOM et la promesse de chaque module, jamais son contenu. C'est la
// différence entre « il n'y a rien ici » et « il y a quelque chose ici, et
// c'est à vous » — et c'est ce qui fait qu'un mur vend au lieu de frustrer.
// ⚠️ CE TABLEAU ÉTAIT EN FRANÇAIS, EN DUR — donc en français sur la page
// anglaise, en production. ⭐ Dans un dépôt multilingue, tout texte destiné à
// être lu est soit une clé i18n, soit une carte par langue. Jamais une chaîne
// nue dans un gabarit : c'est invisible au build, et `test:langues` ne le voit
// pas non plus (il mesure la couverture éditoriale, pas le code).
const MODULES = ['price_history', 'extremes', 'modules', 'alerts', 'wallet_watch']
  .map((cle) => ({ cle, nom: t(lang, `mod.${cle}`), d: t(lang, `mod.${cle}.d`) }));
---
      {/* ⛔ UNE SEULE LANGUE DÉCLARÉE, ET C'EST LE CORRECTIF DU 404.
          `/compte/` et `/connexion/` sont rendues À LA DEMANDE et lisent
          `Accept-Language` : elles n'ont qu'UNE adresse, sans préfixe. Sans
          `langs`, la barre de langues et les `hreflang` proposaient
          `/fr/compte/`, `/es/compte/`, `/de/compte/` — trois 404.
          ⭐ Le mécanisme existait déjà : Base.astro le porte depuis le 28/07,
          posé pour exactement cette raison — « un hreflang vers une URL absente
          est une promesse rompue faite à un moteur, et le sélecteur de langue,
          qui lit la même liste, y envoyait le visiteur ». Je l'ai recommis en
          créant deux pages neuves sans lire ce que le gabarit savait déjà. */}
{/* ⭐ `noindex` — lot 97. La page ne peut plus être atteinte sans session,
    donc un robot n'y verra jamais qu'une redirection ; l'en-tête le dit quand
    même, parce qu'une page de membre indexée est une promesse de contenu qu'on
    ne peut pas tenir. `follow` reste : les liens du gabarit gardent leur rôle. */}
<Base noindex langs={[def]} lang={lang} path="/compte/" title={t(lang, 'account.title')}
      crumbs={[{ name: t(lang, 'home.crumb'), url: localize(lang, '/') }, { name: t(lang, 'account.title') }]}>

  <span class="logo logo--xl" aria-hidden="true">VP</span>
  <h1 class="mono-t">{t(lang, 'account.title')}</h1>

  {/* ⛔ LE PANNEAU « VOUS N'ÊTES PAS CONNECTÉ » A ÉTÉ RETIRÉ AU LOT 97, et
      pas parce qu'il était laid : il est devenu INATTEIGNABLE. La redirection
      du haut renvoie tout anonyme vers `/connexion/`. Un bloc conservé « au
      cas où » derrière une condition qui ne peut plus être vraie est du code
      mort qui se relit comme une fonctionnalité — on le lit, on le croit, on
      cherche pourquoi il ne s'affiche jamais.
      ⚠️ Les clés `account.signedout`, `account.signedout.d`, `account.subscribe`
      et `account.soon` RESTENT dans les cinq langues, exprès : le mur de vente
      les reprendra le jour où `offer.url` existera, et une clé retirée puis
      réécrite est une traduction perdue cinq fois. */}
  {connecte && (
    <div class="stats">
      <div class="stat"><div class="k">{t(lang, 'account.tier')}</div><div class="v">{palier}</div></div>
      <div class="stat"><div class="k">{t(lang, 'account.alerts')}</div>
        {/* ⚠️ `-1` veut dire ILLIMITÉ et il faut le traduire ici : afficher
            « -1 alerte » serait un bug visible depuis la page d'accueil. */}
        <div class="v">{(() => { const c = porte('alerts').caps?.[palier]; return c === -1 ? '∞' : (c ?? 0); })()}</div></div>
    </div>
  )}

  {/* ⛔ `titre-affiche` etait un nom v3 : le theme ne l'habille plus.
      Le vocabulaire de la maquette dit `sect-t sect-t--gd`. */}
  <div class="sect-t sect-t--gd"><h2>{t(lang, 'account.modules')}</h2></div>
  <div class="modules">
    {MODULES.map((mo) => {
      const ouvert = franchit(mo.cle, Astro.locals);
      return (
        <div class={ouvert ? 'module module--ouvert' : 'module'}>
          <span class="module__n">{mo.nom}</span>
          <span class="module__d">{mo.d}</span>
          <div class="f" style="font-size:12px">
            {ouvert
              ? <span class="up">✓ {t(lang, 'account.open')}</span>
              : <span class="muted">🔒 {porte(mo.cle).tier}</span>}
          </div>
        </div>
      );
    })}
  </div>

  {enDemo && (
    /* ⭐⭐ LE JETON NOMINATIF SE DIT. Un palier prêté qui ne s'annonce pas est
       une capture d'écran qu'on croira être la page d'un abonné — et c'est
       comme ça qu'on finit par livrer une promesse qu'on n'a pas tenue. */
    <section class="panneau champ" style="margin-bottom:var(--s5)">
      <h2 style="margin-top:0">{t(lang, 'account.demo')}</h2>
      <p class="respire" style="margin-bottom:var(--s4)">{t(lang, 'account.demo.d')}</p>
      <a class="btn btn--fantome btn--sm" href="/api/demo?sortir=1" rel="nofollow">{t(lang, 'account.demo.out')}</a>
    </section>
  )}

  {/* 🔴 `&& connecte` — LES RÉGLAGES SONT RÉSERVÉS AUX MEMBRES (Preda, 06/08).
      Aujourd'hui la redirection du haut suffirait : seul un membre ou un jeton
      de démonstration atteint cette ligne. ⭐ ON L'ÉCRIT QUAND MÊME, parce que
      la condition dit ce que la page GARANTIT, et non ce que le chemin d'accès
      rend improbable aujourd'hui. Un garde-fou qui ne tient que par la route
      qui y mène tombe le jour où quelqu'un ajoute une deuxième route.
      ⛔ CONSÉQUENCE ASSUMÉE, TRANCHÉE PAR PREDA : avec `theme_dans: compte`, la
      bascule jour/nuit n'existe QUE dans ce bloc — un visiteur non connecté ne
      peut donc plus passer en mode jour du tout. C'est un argument
      d'inscription, pas un oubli. La langue, elle, reste atteignable par le
      globe de l'en-tête, qui ne quitte jamais le DOM (sinon Google perd les
      traductions). */}
  {reglagesIci && connecte && (
    /* ═════════════════════════════════════════════════════════════════════
       LES RÉGLAGES DESCENDENT DU HEADER ET DU PIED DE PAGE — Preda, 06/08.
       ═════════════════════════════════════════════════════════════════════
       ⭐ La maquette portait déjà cette phrase depuis des semaines : « le
       sélecteur de langue a quitté l'en-tête […] et le réglage persistant est
       dans les paramètres du compte. » Le moteur ne l'avait jamais appliquée.
       ⛔ CE BLOC N'INVENTE PAS UN RÉGLAGE : il DÉPLACE deux commandes qui
       existaient. La langue reste atteignable par le globe du menu (les liens
       ne quittent jamais le DOM, sinon Google perd les traductions) ; la
       bascule jour/nuit, elle, n'a plus qu'ici.
       ⚠️ AUJOURD'HUI PERSONNE N'EST CONNECTÉ — aucun service d'identité n'est
       branché. Réserver le bloc aux membres le rendrait donc invisible à tout
       le monde, y compris à Preda. On le MONTRE, verrouillé, en le disant : un
       réglage annoncé et fermé se comprend, un réglage absent se croit perdu. */
    <>
      <div class="sect-t sect-t--gd"><h2>{t(lang, 'account.settings')}</h2></div>
      <section class="panneau champ" style="margin-bottom:var(--s5)">
        <p class="muted respire" style="margin-bottom:var(--s4)">{t(lang, 'account.settings.d')}</p>

        {langueIci && languesDispo.length > 1 && (
        <div style="margin-bottom:var(--s5)">
          <span class="etiq" style="display:block;margin-bottom:6px">{t(lang, 'account.language')}</span>
          {languesDispo.map((x) => (
            <a class="tag" href={x.h} hreflang={x.l}
               aria-current={x.l === lang ? 'true' : undefined}>{x.n}</a>
          ))}
        </div>
        )}

        {themeIci && (
        <div>
          <span class="etiq" style="display:block;margin-bottom:6px">{t(lang, 'account.theme')}</span>
          {/* ⛔ LE BOUTON GARDE L'IDENTIFIANT `bascule-theme` ET LA CLASSE
              `bascule` — le script du pied de page les cherche par ces deux
              noms-là, et le thème n'habille que celui-là. Le renommer « parce
              qu'il a déménagé » aurait produit un bouton parfaitement visible
              et parfaitement inerte : la panne qui se croit une réussite. */}
          <button type="button" id="bascule-theme" class="bascule"
                  aria-label={t(lang, 'theme.toggle')} title={t(lang, 'theme.toggle')}
                  aria-pressed="false"></button>
          <p class="muted" style="font-size:13px;margin-top:var(--s3)">{t(lang, 'account.theme.d')}</p>
        </div>
        )}
      </section>
    </>
  )}

  {/* ⭐ LA TRANSPARENCE EST UN ARGUMENT DE VENTE, PAS UNE CONCESSION. Dire quels
      paliers existent, y compris ceux qu'on n'a pas, est ce qui rend crédible
      la promesse de celui qu'on vend. */}
  <p class="etiq" style="margin-top:var(--s5)">
    {t(lang, 'account.tiers')} : {tiers.join(' · ')}
  </p>
</Base>
