---
// ⚠️ VeVePreda/veve-sites — src/pages/compte/index.astro  (FICHIER NEUF)
// ═══════════════════════════════════════════════════════════════════════════
// L'ESPACE MEMBRE — la première page qui dépend de QUI regarde.
// ═══════════════════════════════════════════════════════════════════════════
// ⚠️ `prerender` CONDITIONNEL, ET IL LE DOIT : une route `prerender = false`
// fait ÉCHOUER le build en mode static (NoAdapterInstalled). Même motif que
// src/pages/api/sante.js — c'est le contrat du socle hybride.
// ⛔ Conséquence à connaître : en mode static, cette page est PRÉ-GÉNÉRÉE, donc
// elle affichera toujours l'état « visiteur ». Ce n'est pas un bug, c'est ce
// que « statique » veut dire. veveprice tourne en `rendering: server`.
// ⭐ LITTERAL, ET C'EST LE POINT. Astro exige que `prerender` soit
// statiquement analysable ; une EXPRESSION n'est pas evaluee et retombe
// silencieusement sur `true`. La valeur reelle est posee par l'integration
// `veve:routes-compte` (engine/lib/astro_routes_compte.mjs) selon le mode du
// manifeste. `true` ici est le defaut SUR : sans adaptateur, un build static
// ne peut pas rendre cette route a la demande.
export const prerender = true;

import Base from '../../layouts/Base.astro';
import { manifest } from '../../../engine/lib/manifest.mjs';
// ⛔ `porte` et `franchit` ont quitté cet import au lot 98, avec la liste des
// modules qui les employait. Un import qui survit à son usage n'est pas
// inoffensif : `imports-orphelins` le signale, et surtout il laisse croire que
// cette page décide encore de droits d'accès — elle n'en décide plus aucun.
import { acces, palierVisiteur, sessionDe } from '../../../engine/lib/access.mjs';
import { t, localize, locales, localeNames, languesInterface, choisirLangue, COOKIE_LANGUE } from '../../../engine/lib/i18n.mjs';
import { comptesActifs } from '../../../engine/lib/features.mjs';
// ❤️ LOT 141 — `avoirsDeLaSession()` VIT DANS LE MOTEUR, PAS ICI.
// ⭐⭐ Elle porte QUATRE ÉTATS NOMMÉS (liste · vide · inconnu · nonverifie) et
// c'est un module Node, donc `test:membre` §8 peut l'IMPORTER et l'exercer sur
// ses huit cas. Écrite dans ce frontmatter, la même logique aurait été
// invérifiable : un fichier `.astro` ne s'importe pas depuis un banc, et la
// seule mesure possible aurait été de relire du texte.
// ⭐ `secretDeService` EST IMPORTÉE, PLUS RECOPIÉE : cette page en portait sa
// propre définition depuis le lot 98, et `engine/lib/compte.mjs` la porte
// depuis le 140-3. Deux copies d'un même prédicat sont deux copies qui
// divergeront le jour où un troisième nom de variable apparaît — c'est la
// panne P30 du lot 139, et le commentaire de `compte.mjs` le dit déjà.
import { avoirsDeLaSession, secretDeService, compteDeLaSession } from '../../../engine/lib/compte.mjs';
// 🌍 LOT 154-B — le magasin des préférences de compte. ⭐ Ouverture paresseuse :
// l'importer ne touche pas `/data`, seul le premier `poserPref()` l'ouvre.
// 🔴 LOT 160-A, point `ae` — `lirePref` REJOINT `poserPref` ICI, ET NULLE PART
//   AILLEURS. Le magasin ne connaît pas la clé `mail_news` : il range des
//   couples (clé, valeur) et rien d'autre (`prefs.mjs`, l. 16). C'est cet
//   appelant-ci qui borne le SENS — même partage que la langue au 154-B et que
//   `/api/portes` au 164.
import { poserPref, lirePref } from '../../../engine/lib/prefs.mjs';
// 🔴 LOT 164 — LE RÉGLAGE DES PORTES. ⛔ `porte()` est importée pour LIRE le
//   palier effectif (surcharge comprise) : c'est elle le point unique, et
//   recalculer « manifeste ou surcharge » ici en ferait une seconde loi.
import { PORTES_CONNUES, porte as porteDe } from '../../../engine/lib/access.mjs';
import { etatBrut as portesBrutes, JOURS_MAX } from '../../../engine/lib/portes_surcharge.mjs';
// 👓 LOT 187 — « voir comme » (demande de Preda du 24/08).
import { etatVu, MINUTES_MAX, MINUTES_DEFAUT } from '../../../engine/lib/palier_vu.mjs';
// 💳 LOT 200 — LA CAISSE. ⛔ L'ÉCRAN D'ACHAT VIT ICI, ET PAS DANS UNE PAGE
// `/caisse/` : une route de compte se déclare à SEPT endroits, dont un hors
// dépôt (Cloudflare). `/compte/` est déjà déclarée partout. Le chemin le moins
// cher n'est pas le plus court à écrire, c'est celui qui ne rouvre pas un
// dossier déjà fermé.
import CaisseAchat from '../../components/CaisseAchat.astro';
import { grille } from '../../../engine/lib/caisse.mjs';

// ⭐ CES PAGES SONT RENDUES À LA DEMANDE : elles peuvent donc lire l'en-tête
// `Accept-Language`, ce qu'une page pré-générée ne peut pas faire. Autant s'en
// servir — sinon un francophone connecté lit son compte en anglais.
// ⚠️ On ne fait confiance qu'aux langues que le SITE déclare : un en-tête est
// une donnée d'entrée comme une autre, il ne choisit pas dans un ensemble
// ouvert. `def` reste le repli, jamais une valeur devinée.
const { active, def } = locales();
const souhait = (Astro.request.headers.get('accept-language') || '')
  .split(',').map((x) => x.split(';')[0].trim().slice(0, 2).toLowerCase());
// 🌍 LOT 120 — `languesInterface()` ET NON `active`.
// `active` ne contient plus qu'`en` : ce sont les langues qui ont une ADRESSE.
// Cette page-ci n'a qu'une adresse et négocie sa langue à la demande — elle
// n'est jamais mise en cache partagé (`private, no-store`), donc elle peut
// servir des libellés différents sans risque et sans URL supplémentaire.
// ⭐⭐⭐ C'EST EXACTEMENT LA DÉCISION DE PREDA : « le contenu de base en
// anglais, l'interface traduite ». L'espace membre est le seul endroit où
// « l'interface » est encore une page à part entière.
// 🌍 LOT 123 — `?lang=` → cookie → Accept-Language. Voir `choisirLangue()`.
// ⭐ Cette page est celle où le réglage se FAIT : c'est donc ici, plus que
//   partout ailleurs, que l'oubli se voyait. Preda l'a signalé le 10/08 —
//   « je règle sur français, la navigation me remet en anglais ».
const _ch = choisirLangue({
  demande: new URL(Astro.request.url).searchParams.get('lang'),
  cookie: Astro.cookies.get(COOKIE_LANGUE)?.value,
  accept: Astro.request.headers.get('accept-language'),
  dispo: languesInterface(), def,
});
const lang = _ch.lang;
if (_ch.aPoser) {
  Astro.cookies.set(COOKIE_LANGUE, lang, {
    path: '/', maxAge: 60 * 60 * 24 * 365, sameSite: 'lax', secure: true, httpOnly: false,
  });
}
const m = manifest();
const { tiers } = acces();
// ⛔ DÉCISION PREDA DU 03/08/2026 : vevewiki n'aura JAMAIS d'espace membre.
// La question était ouverte depuis le lot 42 ; elle est close, on ne la
// repose pas.
// ⭐ Même dispositif que `/inscription/` : un `redirect` produit un talon que
// l'intégration `veve:fonctionnalites-eteintes` efface ensuite. Les deux
// moitiés vont ENSEMBLE — ce `redirect` seul laisserait une page fantôme, et
// l'audit SEO rouge en permanence (le défaut du 27/07).
if (!comptesActifs()) return Astro.redirect('/');

const palier = palierVisiteur(Astro.locals);
// 🔴🔴 CORRIGÉ LE 06/08/2026 — `connecte` LISAIT LE PALIER, DONC IL MENTAIT.
// Sous `access.demo: crevette`, tout visiteur portait un palier : cette page
// annonçait « connecté » à quelqu'un qui n'avait jamais eu de compte, et
// `/connexion/` lui proposait de se déconnecter de rien.
// ⭐⭐⭐ LE PALIER DIT CE QU'ON A LE DROIT DE VOIR, LA SESSION DIT QUI ON EST.
const session = sessionDe(Astro.locals);
const connecte = session === 'reelle';
// 🗑️ LOT 161 — `enDemo` a disparu avec la session de démonstration (demande `r`).
// ⛔ La ligne au-dessus reste, et elle n'est PAS un reste de la démo : elle
// existe parce que le palier et la session répondent à deux questions
// différentes, ce qui reste vrai sans aucun mécanisme de démonstration.

// ═══════════════════════════════════════════════════════════════════════════
// 🌍 LOT 154-B — LA LANGUE CHOISIE ICI SUIT LE COMPTE, PLUS SEULEMENT LE NAVIGATEUR
// ═══════════════════════════════════════════════════════════════════════════
// ⭐ Le cookie est posé plus haut (l. 71) et RESTE : c'est lui que lisent les
// ~3 000 pages pré-générées via `55-langue.js`. Ce bloc n'en change rien — il
// ajoute la seconde moitié : ranger le choix sous le COMPTE, pour que
// `/api/entrer` le repose au prochain appareil.
//
// ⭐⭐ IL NE TOURNE QUE SUR UN CHANGEMENT (`_ch.aPoser`), ET C'EST TOUT LE
// DIMENSIONNEMENT DE CE LOT. Résoudre le compte coûte un aller-retour de 4 s
// vers veveid : le faire à chaque affichage de `/compte/` serait une taxe
// permanente pour une écriture qui n'arrive qu'au clic sur le sélecteur.
// `aPoser` vaut vrai quand `?lang=` diffère du cookie — c'est-à-dire au clic,
// et à rien d'autre.
//
// 🔴 ET IL NE PEUT PAS FAIRE ÉCHOUER LA PAGE. Même règle que `/api/entrer` :
// une préférence d'affichage n'est pas un droit. Si veveid est muet ou si
// `/data` n'est pas monté, la langue reste posée dans le cookie et le membre ne
// voit aucune différence AUJOURD'HUI — il la reperdra en changeant d'appareil,
// ce qui est exactement l'état d'avant ce lot. ⛔ Une page de compte en 500
// pour un dictionnaire serait une régression bien pire que le défaut corrigé.
if (_ch.aPoser && connecte) {
  try {
    const _sid = Astro.cookies.get('vp_session')?.value || null;
    const _compte = await compteDeLaSession(_sid);
    // ⛔ `lang` est DÉJÀ validé — il sort de `choisirLangue()`, qui n'a retenu
    //    que ce qui est dans `languesInterface()`. On ne revalide pas : deux
    //    juges pour une même question finissent par diverger.
    if (_compte) poserPref(_compte, 'langue', lang);
  } catch { /* ⭐ silence VOLONTAIRE — voir le paragraphe ci-dessus */ }
}

// ═══════════════════════════════════════════════════════════════════════════
// 🔴 IL N'Y A PAS DE PAGE COMPTE PUBLIQUE — arbitrage Preda du 06/08/2026.
// ═══════════════════════════════════════════════════════════════════════════
// Jusqu'ici cette page servait DEUX choses à qui n'avait pas de session : un
// panneau « vous n'êtes pas connecté » et la liste des réglages, affichée
// verrouillée. C'était le bon choix TANT QU'AUCUN SERVICE D'IDENTITÉ N'EXISTAIT
// — le commentaire ci-dessous le disait : « réserver le bloc aux membres le
// rendrait invisible à tout le monde, y compris à Preda ».
// ⭐⭐ CETTE JUSTIFICATION A EXPIRÉ LE 06/08 À 15 h, quand l'inscription par
// courriel est passée en production. Un avertissement qui survit à sa cause
// devient un mensonge qui se cite : la raison d'être du repli, c'était
// l'absence du service ; le service existe.
//
// ⭐ ON REDIRIGE VERS `/connexion/` ET NON VERS `/inscription/` : quelqu'un qui
// tape `/compte/` a déjà un compte, dans neuf cas sur dix. La page de connexion
// porte le lien vers l'inscription ; l'inverse n'est pas vrai.
// ⛔ ET NON UN 404 : un membre dont la session a expiré au bout de trente jours
// tomberait sur une erreur au lieu d'une porte.
//
// 🔴🔴 `locals.rendu` ET NON `Astro.isPrerendered`. Sur une page PRÉ-GÉNÉRÉE,
// il n'y a pas de visiteur : personne n'est jamais connecté, donc cette
// redirection se figerait DANS LE FICHIER et /compte/ deviendrait un renvoi
// permanent — y compris pour un abonné. Le drapeau est posé par
// `src/middleware.js`, juste sous la ligne qui décide (`isPrerendered`), et
// vaut `undefined` partout ailleurs. ⭐ On lit le signal du dépôt, pas une
// propriété du framework dont le nom et le sens changent de version en
// version : ici, se tromper ferme la porte à tout le monde sans une erreur.
const aLaDemande = Astro.locals?.rendu === 'demande';
// 🗑️ LOT 161 — la condition portait `&& !enDemo` : le jeton de démonstration
// devait PASSER, parce que c'est ici que vivait le seul bouton pour en sortir.
// Le jeton n'existe plus, la dérogation non plus. ⚠️ Conséquence à connaître :
// cette page est désormais fermée à qui n'a pas de vraie session, sans aucune
// exception — c'est exactement ce que « supprimer tout » veut dire.
if (aLaDemande && !connecte) return Astro.redirect('/connexion/', 302);
// 🌐🎨 Les réglages descendent ICI (demande de Preda du 06/08). Le gabarit ne
// le décide pas : le manifeste le dit, comme pour tout le reste du moteur.
const reglagesIci = (m.identity?.langues_dans === 'compte') || (m.identity?.theme_dans === 'compte');
const langueIci = m.identity?.langues_dans === 'compte';
const themeIci = m.identity?.theme_dans === 'compte';
// 🔴🔴 LOT 120 — LE SÉLECTEUR NE FABRIQUE PLUS D'ADRESSE LOCALISÉE.
// Il envoyait vers `localize(l, '/')`, c'est-à-dire `/fr/`, `/es/`, `/de/`.
// Ces accueils N'EXISTENT PLUS : nginx les redirige désormais en 301 vers `/`.
// ⛔ Le sélecteur aurait donc proposé de « passer en français » et livré la
//    page anglaise, après un aller-retour de redirection. Un réglage qui ne
//    règle rien et qui a l'air de marcher — la pire des deux façons d'échouer.
// ⭐ Il pose maintenant `?lang=` sur CETTE page, comme `/connexion/` et
//   `/inscription/` : une seule adresse, aucune URL créée, et la langue est un
//   RÉGLAGE, ce qu'elle a toujours été ici.
// ⚠️ `languesInterface()` et non `active` : ce sont deux questions
//   différentes depuis ce lot — « quelles langues existent en libellés » n'est
//   plus « quelles langues ont une adresse ».
const languesDispo = languesInterface().map((l) => ({ l, n: localeNames[l] || l.toUpperCase(), h: `?lang=${l}` }));

// ⛔ LA LISTE DES MODULES A QUITTÉ CETTE PAGE — arbitrage Preda du 06/08/2026.
// Elle y était pour vendre : montrer le nom et la promesse de chaque module,
// verrouillés, « pour qu'un mur vende au lieu de frustrer ». L'argument était
// bon et il reste vrai — mais sa PLACE n'est pas ici. Un espace compte répond
// à « qui suis-je, et que puis-je régler » ; l'argumentaire de vente vit sur
// `/offre/`, où il s'adresse aussi aux gens qui n'ont pas de compte.
// ⭐ Les clés `mod.*` RESTENT dans les cinq langues : `/offre/` les emploie.

// ═══════════════════════════════════════════════════════════════════════════
// ⭐⭐⭐ L'ÉTAT DU COMPTE VIENT DE VeVe ID — il n'est écrit nulle part ici.
// ═══════════════════════════════════════════════════════════════════════════
// 🔴 LE COOKIE NE PORTE QU'UN IDENTIFIANT DE SESSION. Recopier l'adresse
// e-mail ou l'état du portefeuille dans un cookie signé les FIGERAIT : un
// portefeuille vérifié ce matin s'afficherait « non vérifié » pendant trente
// jours. La même raison qui interdit d'y mettre le palier interdit d'y mettre
// le reste. On demande, à chaque affichage, au service qui sait.
//
// ⭐⭐ ET ON DEMANDE AVEC LE `sid`, PAS AVEC UN IDENTIFIANT DE COMPTE. Ce site
// ne DÉTIENT pas l'identifiant du compte : il a un cookie, et c'est tout. Lui
// faire porter l'identifiant reviendrait à le laisser DÉSIGNER un compte — et
// avec le secret de service, il pourrait alors lire n'importe lequel.
//
// ⚠️ UN APPEL RÉSEAU DE PLUS, SUR CETTE PAGE SEULEMENT. Les ~8 500 pages de
// contenu restent des fichiers et ne passent jamais par là. Délai maximum et
// échec FERMÉ : sans réponse, on n'invente pas un compte, on affiche ce que
// la session garantit déjà — le palier — et on le dit.
const sid = Astro.cookies.get('vp_session')?.value || null;
const idApi = process.env.SESSION_API || '';

let dossier = null;
if (aLaDemande && connecte && sid && idApi) {
  try {
    const r = await fetch(`${idApi}/api/session?sid=${encodeURIComponent(sid)}`, {
      headers: { accept: 'application/json', 'x-service': secretDeService() },
      signal: AbortSignal.timeout(2500),
    });
    if (r.ok) dossier = await r.json();
  } catch {
    // ⚠️ ÉCHOUER FERMÉ, comme le middleware. `dossier` reste nul, la page le
    // dit, et rien ne se devine. Un repli qui afficherait « aucun
    // portefeuille » sur une panne réseau enverrait quelqu'un refaire une
    // vérification qu'il a déjà faite.
    dossier = null;
  }
}
// ═══════════════════════════════════════════════════════════════════════════
// 🔴🔴🔴 LOT 164 — LE BLOC D'EXPLOITATION : RÉGLER LES PORTES
// ═══════════════════════════════════════════════════════════════════════════
// ⭐⭐ AUCUN APPEL RÉSEAU AJOUTÉ, ET C'EST CE QUI A DÉCIDÉ DE L'ENDROIT.
//   Cette page interroge DÉJÀ `${idApi}/api/session?sid=` vingt lignes plus
//   haut, et `dossier` porte déjà l'adresse (`email`, rendue par veveid). Une
//   page `/admin/` séparée aurait refait cet appel, et aurait coûté en plus :
//   une route à déclarer, un secret à poser, un secret dans une URL.
//
// ⛔ VIDE = PERSONNE. `ADMIN_COMPTES` absente ne doit pas ouvrir le bloc à
//   tous — c'est la faute de la liste blanche vide, et elle est silencieuse.
//   ⚠️ Ce test-ci ne fait qu'AFFICHER : le vrai garde est dans
//   `/api/portes`, qui refait la même vérification. Un contrôle d'affichage
//   n'est pas un contrôle d'accès, et les deux doivent exister.
//
// ⭐ CE BLOC N'EST PAS TRADUIT, ET C'EST DÉLIBÉRÉ. C'est un outil
//   d'exploitation, vu par une personne. Poser quinze clés dans les CINQ
//   dictionnaires pour un écran qu'un seul compte peut voir coûterait plus
//   cher que ce qu'il rapporte, et chaque clé voyage dans les cinq fichiers.
const _admins = String(process.env.ADMIN_COMPTES || '')
  .split(',').map((x) => x.trim().toLowerCase()).filter(Boolean);
const estAdmin = aLaDemande && connecte && _admins.length > 0
  && _admins.includes(String(dossier?.email ?? '').trim().toLowerCase());

// ⚠️ ON NE LIT LA BASE QUE SI ON AFFICHE. `portesBrutes()` ne lève jamais,
//   mais l'appeler pour tout le monde ouvrirait un descripteur sur la base à
//   chaque affichage de `/compte/`, pour une ligne que personne ne verra.
const _brut = estAdmin ? portesBrutes() : [];

// ═══════════════════════════════════════════════════════════════════════════
// 💳 LOT 200 — CE QUI SE VEND, ET SI LA CAISSE PEUT SEULEMENT OUVRIR
// ═══════════════════════════════════════════════════════════════════════════
// ⭐ LES PRIX VIENNENT DE `grille()`, QUI LIT LE MANIFESTE — la même source que
// `/offre/`. ⛔ Un tarif recalculé ici serait un second tarif : `/offre/`
// afficherait un prix et la caisse en réclamerait un autre, sans qu'aucun banc
// puisse dire lequel est le bon. `test:caisse` compare les deux formules.
// ⚠️ LES NOMS VIENNENT DU MANIFESTE AUSSI, et ce sont des CARTES PAR LANGUE
// (`nom: {fr:…, en:…}`) — comme `site.tagline`. Une chaîne nue s'afficherait en
// français sur la page anglaise ; le repli est l'anglais, puis la clé.
// 🔑 `caisseOuverte` : l'adresse d'encaissement est-elle posée ? Sans elle, la
// section entière disparaît. *Un bouton qui ne mène nulle part coûte plus cher
// en confiance qu'il ne rapporte en promesse* — c'est la règle de `offer.url`,
// et elle vaut ici pour la même raison.
const _grille = (() => { try { return grille(); } catch { return {}; } })();
const _plansCaisse = (m.offer?.plans || [])
  .filter((p) => _grille[p?.cle] && tiers.includes(p?.cle))
  .map((p) => ({
    cle: p.cle,
    nom: (p.nom && typeof p.nom === 'object' ? (p.nom[lang] || p.nom.en) : p.nom) || p.cle,
    mensuel: _grille[p.cle][1],
    annuel: _grille[p.cle][12],
  }));
// ⛔ `process.env`, PAS `import.meta.env`, ET C'EST MESURÉ. `import.meta.env`
// est FIGÉ À LA COMPILATION : Vite n'y expose que ce qui est préfixé ou déclaré
// dans `define`, donc `CAISSE_ADRESSE` y vaudrait `undefined` pour toujours —
// et la section d'achat resterait invisible sur un serveur parfaitement
// configuré. C'est exactement la panne de la sonde qui répondait
// `"mode":"static"` sur un site en mode server.
// ⭐ L'ADRESSE EST LUE UNE FOIS, ET LES DEUX QUI S'EN SERVENT LISENT LA MÊME
//   VARIABLE : le prédicat « la caisse est-elle ouverte ? » et le code QR.
//   Deux lectures de `process.env` à deux endroits, c'est une section d'achat
//   ouverte avec un QR vide le jour où l'une des deux se trompe de nom.
// 🔔 LOT 201 — LE COMPTE À REBOURS DE LA BANNIÈRE.
// ⭐ LE SEUIL EST ÉCRIT ICI, ET NULLE PART AILLEURS. Le middleware dépose le
//   nombre brut ; c'est cette page qui décide à partir de quand elle prévient.
//   Le même cinq vit chez veveid (`JOURS_AVANT`) pour le COURRIEL — deux
//   canaux, deux endroits, et c'est assumé : le service d'identité ne connaît
//   pas les pages de ce site, et ce site ne pilote pas les envois. ⛔ Les
//   coupler aurait demandé une route de plus pour lire une constante.
// ⚠️ `null` N'EST PAS `0`. Quelqu'un qui n'a jamais payé n'a pas de compte à
//   rebours : lui annoncer « il vous reste 0 jour » serait annoncer la fin
//   d'un droit qu'il n'a jamais eu.
const RAPPEL_JOURS = 5;
const _joursRestants = Number.isFinite(Astro.locals?.joursRestants)
  ? Number(Astro.locals.joursRestants) : null;
const _bientotFini = _joursRestants !== null && _joursRestants <= RAPPEL_JOURS;

const _adresseCaisse = String(process.env.CAISSE_ADRESSE || '').trim();
const _caisseOuverte = connecte && _plansCaisse.length > 0
  && /^0x[0-9a-fA-F]{40}$/.test(_adresseCaisse);
const _parPorte = new Map(_brut.map((x) => [x.porte, x]));
const lesPortes = estAdmin ? [...PORTES_CONNUES].map((nom) => {
  const p = porteDe(nom);              // ⭐ le palier EFFECTIF, surcharge comprise
  const l = _parPorte.get(nom) ?? null;
  return {
    nom, tier: p.tier, surchargee: Boolean(p.surcharge),
    // ⚠️ « rien » et « ouvert jusqu'à avant-hier » sont deux états différents.
    //   Le second se relit avec profit le jour où on cherche pourquoi
    //   quelqu'un a vu quelque chose.
    expiree: Boolean(l && !l.active),
