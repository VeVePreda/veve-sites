            <span class="muted" style="font-size:13px">
              {x.surchargee ? `surchargée jusqu’au ${x.jusqu_a}`
                : x.expiree ? `expirée le ${x.jusqu_a} — le manifeste a repris la main`
                : 'manifeste'}
            </span>
          </div>
          {/* ⛔ POST, JAMAIS GET. Un geste qui écrit derrière un GET s'exécute
