---
// ⚠️ DEPOT : VeVePreda/veve-sites
// CHEMIN : src/pages/[locale]/comics/[serie]/[numero]/[rarete].astro
//
// LA JUMELLE LOCALISEE DE src/pages/comics/[serie]/[numero]/[rarete].astro.
//
// 🔴 POURQUOI ELLE N'EXISTAIT PAS, ET CE QUE CA A COUTE (29/07/2026).
// Quand `publication.comic_leaf: issue-rarity` a fait passer l'adresse des
// comics a TROIS niveaux (/comics/<serie>/<numero>/<rarete>/), la paire de
// routes a ete creee cote NON localise seulement. Cote localise il ne restait
// que la route a deux niveaux, sans filtre de profondeur, qui decoupait ainsi :
//
//     const [, , serie, feuille] = e.path.split('/');   // feuille = p[3]
//
// Sur `/comics/a-force-vol-1/1/secret-rare/` cela prend le NUMERO pour la
// rarete : la page partait a `/de/comics/a-force-vol-1/1/` pendant que son
// canonical, ses hreflang, son selecteur de langue et le sitemap la
// designaient a `/de/comics/a-force-vol-1/1/secret-rare/`.
// ⭐ Aucun build n'a jamais echoue : la page se construisait, simplement pas la
// ou tout le reste du site la cherchait. 1 128 fiches construites a une
// adresse et declarees a une autre, 1 200 URL de sitemap en 404, et un
// canonical vers un 404 fait abandonner la page qui le porte.
//
// ⭐ LES DEUX ROUTES LOCALISEES COEXISTENT, comme leurs jumelles non
// localisees, et pour la meme raison : chacune ne prend QUE les items dont
// l'adresse a SA profondeur. Un site qui reste en `comic_leaf: rarity` marche
// sans rien casser, et basculer ne demande de SUPPRIMER aucun fichier —
// l'upload web de GitHub n'efface rien, et une route orpheline reclamant un
// parametre disparu casse le build alors que l'arbre local passe (18/07/2026).
//
// ⛔ NE PAS « SIMPLIFIER » EN UNE SEULE ROUTE ATTRAPE-TOUT : c'est l'absence de
// filtre de profondeur qui a produit le defaut ci-dessus.
import { priceEnabled } from '../../../../../../engine/lib/features.mjs';
import Item from '../../../../../components/pages/Item.astro';
import { dataset } from '../../../../../../engine/lib/dataset.mjs';
import { localeParams, langFromParam } from '../../../../../../engine/lib/i18n.mjs';
export async function getStaticPaths() {
  if (!priceEnabled()) return [];
  const ds = await dataset();
  const comics = ds.items
    .filter((e) => e.type === 'comic')
    .map((e) => ({ e, p: e.path.split('/').filter(Boolean) }))   // [comics, serie, numero, rarete]
    .filter(({ p }) => p.length === 4);                          // 3 niveaux seulement
  const out = [];
  for (const { param } of localeParams()) {
    if (param === undefined) continue;
    for (const { e, p } of comics) {
      out.push({
        params: { locale: param, serie: p[1], numero: p[2], rarete: p[3] },
        props: { item: e, updatedAt: ds.updatedAt },
      });
    }
  }
  return out;
}
const { item, updatedAt } = Astro.props;
const lang = langFromParam(Astro.params.locale);
---
<Item lang={lang} item={item} updatedAt={updatedAt} />
