---
import RarityPage from '../../../components/pages/RarityPage.astro';
import { dataset } from '../../../../engine/lib/dataset.mjs';
import { locales } from '../../../../engine/lib/i18n.mjs';
export async function getStaticPaths() {
  const ds = await dataset();
  const { active, def } = locales();
  const out = [];
  for (const l of active.filter((x) => x !== def)) {
    for (const e of [...ds.rarities.values()]) out.push({ params: { locale: l, slug: e.slug }, props: { rar: e, updatedAt: ds.updatedAt } });
  }
  return out;
}
const { rar, updatedAt } = Astro.props;
const lang = Astro.params.locale;
---
<RarityPage lang={lang} rar={rar} updatedAt={updatedAt} />
