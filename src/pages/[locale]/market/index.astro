---
// ⚠️ VeVePreda/veve-sites — src/pages/[locale]/market.astro
// 🔴 LOT 104 — la variante par langue. Même mur, mêmes raisons : tout est dit
// dans `src/pages/market.astro`, et ce fichier ne le redit pas.
//
// ⛔⛔ `getStaticPaths()` EST OBLIGATOIRE ET IL REND UNE LISTE VIDE EN STATIC.
// Astro : « GetStaticPathsRequired » sur toute route dynamique pré-générée.
// ⭐ Et la réponse honnête EST « aucun » : en mode static il n'y a pas de
// serveur, donc pas de session, donc aucun palier — une page de marché n'y a
// pas de sens. ⛔ NE PAS y remettre les langues « pour que ça marche aussi en
// static » : ça écrirait dans `dist/` un fichier par langue contenant les 200
// montants, servi en clair par nginx. C'est exactement la fuite du lot 101.
export const prerender = true;

import { priceEnabled } from '../../../../engine/lib/features.mjs';
import Market from '../../../components/pages/Market.astro';
import { locales } from '../../../../engine/lib/i18n.mjs';
import { franchit, connecte } from '../../../../engine/lib/access.mjs';
import { lireCotes, lireMarche } from '../../../../engine/lib/cote.mjs';

export function getStaticPaths() {
  // ⭐ En mode server cette fonction n'est pas appelée ; en static elle rend
  // vide. Une seule forme, deux modes, aucune branche à maintenir.
  return [];
}

const lang = Astro.params.locale;
if (!priceEnabled()) return Astro.redirect('/');

const aLeDroit = connecte(Astro.locals) && franchit('cote', Astro.locals);
if (!aLeDroit) {
  return Astro.redirect(`/connexion/?suite=%2F${encodeURIComponent(lang)}%2Fmarket%2F`, 302);
}

Astro.response.headers.set('cache-control', 'private, no-store');
Astro.response.headers.set('vary', 'cookie');

// 🔴🔴🔴 LOT 125 — `lireMarche()` ET PLUS `await dataset()`. MESURE : 10 328 ms
// contre 2 ms. `dataset()` retelechargeait 2,37 millions de lignes de prix et
// REECRIVAIT `.reserve/cote/` a chaque demarrage du conteneur, dans le
// processus qui sert la page. Le raisonnement complet est dans `cote.mjs`.
// ⛔ Pas de repli vers `dataset()` si le fichier manque : `lireMarche()` leve,
// et `test:marche` l'aurait dit au build.
const ds = lireMarche();
const cotes = lireCotes(ds.marche.map((i) => i.uuid));
---
<Market lang={lang} cotes={cotes} ds={ds} />
