// Route générique des pages éditoriales (langues secondaires). getStaticPaths =
// sections actives × locales ≠ défaut. Chaque langue a sa propre adresse
// (/fr/glossary/…), reliée par hreflang dans Base ; aucune redirection auto.
import Editorial from '../../components/pages/Editorial.astro';
