---
import BlogPost from '../../../components/pages/BlogPost.astro';
import { postsFor } from '../../../../engine/lib/blog.mjs';
import { locales } from '../../../../engine/lib/i18n.mjs';
import { dataset } from '../../../../engine/lib/dataset.mjs';
export async function getStaticPaths() {
  const { active, def } = locales();
  const ds = await dataset();
  const out = [];
  for (const l of active.filter((x) => x !== def)) {
    for (const p of await postsFor(l)) {
      out.push({ params: { locale: l, slug: p.slug }, props: { post: p, updatedAt: ds.updatedAt } });
    }
  }
  return out;
}
const { post, updatedAt } = Astro.props;
---
<BlogPost lang={Astro.params.locale} post={post} updatedAt={updatedAt} />
