---
import BlogTag from '../../../../components/pages/BlogTag.astro';
import { tagsFor, languesBlog } from '../../../../../engine/lib/blog.mjs';
import { locales} from '../../../../../engine/lib/i18n.mjs';
import { dataset } from '../../../../../engine/lib/dataset.mjs';
export async function getStaticPaths() {
  // 🔴 LOT 120 — `languesBlog()` ET NON `active` : `active` ne contient plus
  //    qu'`en` (les langues qui ont une adresse sur le SITE), alors que le
  //    blog garde `en` + `fr`. ⭐ Et `languesBlog()` mesure les articles qui
  //    EXISTENT — une langue déclarée sans article ne produit aucune page.
  const { def } = locales();
  const active = await languesBlog();
  const ds = await dataset();
  const out = [];
  for (const l of active.filter((x) => x !== def)) {
    for (const x of await tagsFor(l)) out.push({ params: { locale: l, tag: x.tag }, props: { updatedAt: ds.updatedAt } });
  }
  return out;
}
const { updatedAt } = Astro.props;
---
<BlogTag lang={Astro.params.locale} tag={Astro.params.tag} updatedAt={updatedAt} />
