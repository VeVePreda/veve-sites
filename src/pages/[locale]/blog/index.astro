---
import BlogIndex from '../../../components/pages/BlogIndex.astro';
import { locales } from '../../../../engine/lib/i18n.mjs';
import { languesBlog } from '../../../../engine/lib/blog.mjs';
import { dataset } from '../../../../engine/lib/dataset.mjs';
// ⛔ Plus d'index d'articles VIDE dans une langue sans article. Il etait emis
// en `noindex` — mais une page emise EXISTE : elle est liee par la nav, elle
// est atteignable, et un visiteur espagnol y trouvait « aucun article ».
export async function getStaticPaths() {
  const { def } = locales();
  return (await languesBlog()).filter((l) => l !== def).map((l) => ({ params: { locale: l } }));
}
const ds = await dataset();
---
<BlogIndex lang={Astro.params.locale} updatedAt={ds.updatedAt} />
