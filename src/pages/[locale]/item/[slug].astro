---
import Item from '../../../components/pages/Item.astro';
import { dataset } from '../../../../engine/lib/dataset.mjs';
import { locales } from '../../../../engine/lib/i18n.mjs';
export async function getStaticPaths() {
  const ds = await dataset();
  const { active, def } = locales();
  const out = [];
  for (const l of active.filter((x) => x !== def)) {
    for (const e of ds.items) out.push({ params: { locale: l, slug: e.slug }, props: { item: e, updatedAt: ds.updatedAt } });
  }
  return out;
}
const { item, updatedAt } = Astro.props;
const lang = Astro.params.locale;
---
<Item lang={lang} item={item} updatedAt={updatedAt} />
