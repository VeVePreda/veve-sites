---
import BlogTag from '../../../components/pages/BlogTag.astro';
import { tagsFor } from '../../../../engine/lib/blog.mjs';
import { locales } from '../../../../engine/lib/i18n.mjs';
import { dataset } from '../../../../engine/lib/dataset.mjs';
export async function getStaticPaths() {
  const { def } = locales();
  const ds = await dataset();
  const tags = await tagsFor(def);
  return tags.map((x) => ({ params: { tag: x.tag }, props: { updatedAt: ds.updatedAt } }));
}
const { updatedAt } = Astro.props;
const lang = locales().def;
---
<BlogTag lang={lang} tag={Astro.params.tag} updatedAt={updatedAt} />
