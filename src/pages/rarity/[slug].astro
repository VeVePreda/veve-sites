---
import Base from '../../layouts/Base.astro';
import { dataset } from '../../../engine/lib/dataset.mjs';
export async function getStaticPaths() {
  const ds = await dataset();
  return [...ds.rarities.values()].map((r) => ({ params: { slug: r.slug }, props: { rar: r } }));
}
const { rar } = Astro.props;
const items = [...rar.items].sort((a, b) => (b.floor ?? 0) - (a.floor ?? 0));
const money = (v) => (v === null || v === undefined ? '—' : v.toLocaleString('fr-FR', { maximumFractionDigits: 2 }));
---
<Base title={`Rareté ${rar.name}`} description={`Collectibles VeVe de rareté ${rar.name} : prix plancher et offres.`} crumbs={[{ name: 'Accueil', url: '/' }, { name: 'Raretés', url: '/rarity/' }, { name: rar.name }]}>
  <h1>Rareté : {rar.name}</h1>
  <p class="lead">{items.length} collectibles.</p>
  <table>
    <thead><tr><th>Collectible</th><th class="hide">Collection</th><th class="num">Plancher</th></tr></thead>
    <tbody>
      {items.map((i) => (<tr><td><a href={`/item/${i.slug}/`}>{i.name}</a></td><td class="hide">{i.series}</td><td class="num">{money(i.floor)}</td></tr>))}
    </tbody>
  </table>
</Base>
