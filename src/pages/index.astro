---
import Base from '../layouts/Base.astro';
import { dataset } from '../../engine/lib/dataset.mjs';
import { manifest } from '../../engine/lib/manifest.mjs';

const m = manifest();
const ds = await dataset();
const up = ds.movers.up.slice(0, 6);
const down = ds.movers.down.slice(0, 6);
const featured = [...ds.items].sort((a, b) => (b.points || 0) - (a.points || 0)).slice(0, 8);
const collections = [...ds.collections.values()].sort((a, b) => b.items.length - a.items.length).slice(0, 8);
const pct = (v) => (v === null || v === undefined ? '—' : `${v > 0 ? '+' : ''}${v.toFixed(1)} %`);
const money = (v) => (v === null || v === undefined ? '—' : v.toLocaleString('fr-FR', { maximumFractionDigits: 2 }));
---
<Base title={null} updatedAt={ds.updatedAt}>
  <h1>{m.site.tagline}</h1>
  <p class="lead">{m.site.description}</p>

  <input id="q" class="searchbox" type="search" placeholder="Rechercher un collectible…" autocomplete="off" aria-label="Rechercher un collectible" />
  <div id="results" class="grid" style="margin-top:14px"></div>

  <div class="stats">
    <div class="stat"><div class="k">Fiches suivies</div><div class="v">{ds.items.length.toLocaleString('fr-FR')}</div></div>
    <div class="stat"><div class="k">Catalogue couvert</div><div class="v">{ds.catalogueSize.toLocaleString('fr-FR')}</div></div>
    <div class="stat"><div class="k">Collections</div><div class="v">{ds.collections.size}</div></div>
  </div>

  <h2>Plus fortes hausses (7 jours)</h2>
  <div class="grid">
    {up.map((i) => (
      <a class="item" href={`/item/${i.slug}/`}>
        <div class="n">{i.name}</div>
        <div class="s">{i.series} · {i.rarity}</div>
        <div class="f">{money(i.floor)} <span class="up" style="font-size:14px">{pct(i.change7d)}</span></div>
      </a>
    ))}
  </div>

  <h2>Plus fortes baisses (7 jours)</h2>
  <div class="grid">
    {down.map((i) => (
      <a class="item" href={`/item/${i.slug}/`}>
        <div class="n">{i.name}</div>
        <div class="s">{i.series} · {i.rarity}</div>
        <div class="f">{money(i.floor)} <span class="down" style="font-size:14px">{pct(i.change7d)}</span></div>
      </a>
    ))}
  </div>

  <h2>Historiques les plus fournis</h2>
  <div class="grid">
    {featured.map((i) => (
      <a class="item" href={`/item/${i.slug}/`}>
        <div class="n">{i.name}</div>
        <div class="s">{i.points} points d'historique</div>
        <div class="f">{money(i.floor)}</div>
      </a>
    ))}
  </div>

  <h2>Collections</h2>
  <p>{collections.map((c) => (<a class="tag" href={`/collection/${c.slug}/`}>{c.name} ({c.items.length})</a>))}</p>

  <script is:inline>
    (function () {
      var q = document.getElementById('q'), out = document.getElementById('results'), idx = null;
      function render(list) {
        out.innerHTML = list.slice(0, 24).map(function (i) {
          return '<a class="item" href="/item/' + i.s + '/"><div class="n">' + i.n + '</div></a>';
        }).join('');
      }
      q.addEventListener('input', function () {
        var v = q.value.trim().toLowerCase();
        if (!v) { out.innerHTML = ''; return; }
        if (!idx) {
          fetch('/search-index.json').then(function (r) { return r.json(); }).then(function (d) { idx = d; filter(v); });
        } else filter(v);
      });
      function filter(v) {
        if (!idx) return;
        render(idx.filter(function (i) { return i.n.toLowerCase().indexOf(v) !== -1; }));
      }
    })();
  </script>
</Base>
