---
// ⚠️ VeVePreda/veve-sites — src/pages/dashboard/index.astro   (FICHIER NEUF)
// ═══════════════════════════════════════════════════════════════════════════
// 🔴 LOT 104 — LE TABLEAU DE BORD : UNE COQUILLE QUI DIT QU'ELLE EST VIDE
// ═══════════════════════════════════════════════════════════════════════════
// ARBITRAGE PREDA DU 07/08, choisi parmi trois : « une coquille vide
// accessible » plutôt que rien, et plutôt que de le spécifier maintenant.
//
// CE QU'ELLE RÉPARE. `nav.dashboard` pointait sur `/` avec ce commentaire dans
// le manifeste : « l'accueil fait office de tableau de bord ». Un libellé qui
// promet une page et en sert une autre. Le menu disait vrai sur l'adresse et
// faux sur le contenu — le pire des deux.
//
// ⛔⛔ ET ELLE RESTE `bientot: true` DANS `offer.modules`. C'est délibéré, et
// c'est la distinction que ce lot doit tenir : UNE PAGE QUI EXISTE N'EST PAS
// UN MODULE QUI EXISTE. C'est le module qui se vend. Basculer le drapeau parce
// que la route répond 200 serait exactement la promesse rompue que le brief
// interdit — et `test:promesses` ne pourrait plus rien dire, puisqu'il ne
// verrait plus de module en attente.
//
// ⭐⭐ ELLE NE FAIT AUCUNE PROMESSE DE DATE. « Bientôt », « en cours », « d'ici
// peu » sont des engagements qu'on tient rarement et qu'on ne mesure jamais.
// Elle dit ce qu'elle N'EST PAS et renvoie vers ce qui existe DÉJÀ — c'est la
// seule chose utile qu'une page vide puisse faire.
export const prerender = true;

import Base from '../../layouts/Base.astro';
import { t, localize } from '../../../engine/lib/i18n.mjs';
import { locales } from '../../../engine/lib/i18n.mjs';
import { connecte } from '../../../engine/lib/access.mjs';
import { priceEnabled } from '../../../engine/lib/features.mjs';

const lang = locales().def;
if (!priceEnabled()) return Astro.redirect('/');

// ⭐ Même mur que `/market/`, et pour la même raison : Preda a demandé un
// tableau de bord « accessible » — accessible aux COMPTES. ⛔ `connecte()`
// seul, sans `franchit()` : cette page ne montre aucune donnée réservée, donc
// exiger un palier PAYANT pour une page vide serait vendre le vide.
if (!connecte(Astro.locals)) {
  return Astro.redirect('/connexion/?suite=%2Fdashboard%2F', 302);
}
Astro.response.headers.set('cache-control', 'private, no-store');
Astro.response.headers.set('vary', 'cookie');
---
<Base sect="dashboard" lang={lang} path="/dashboard/" title={t(lang, 'dash.title')}
      description={t(lang, 'dash.desc')} noindex
      crumbs={[{ name: t(lang, 'home.crumb'), url: localize(lang, '/') }, { name: t(lang, 'dash.title') }]}>

  <p class="etiq etiq--bleu">// {t(lang, 'dash.title').toUpperCase()}</p>
  <h1 class="mono-t">{t(lang, 'dash.title')}</h1>

  {/* ⭐ LE TEXTE DIT L'ÉTAT RÉEL, SANS DATE. Une page vide qui promet une date
      devient fausse toute seule ; une page vide qui décrit ce qui manque reste
      vraie jusqu'à ce qu'on la remplisse. */}
  <div class="panneau">
    <h2 class="mono-t">{t(lang, 'dash.empty')}</h2>
    <p class="respire">{t(lang, 'dash.empty.d')}</p>
  </div>

  {/* ⭐ ET ELLE RENVOIE VERS CE QUI EXISTE. Sans ces liens, la seule chose que
      cette page apporte est une déception ; avec eux, elle est un carrefour. */}
  <div class="sect-t sect-t--gd"><h2 class="mono-t">{t(lang, 'dash.meanwhile')}</h2></div>
  <span class="sep-v" aria-hidden="true"></span>
  <div class="boites">
    <a class="boite" href={localize(lang, '/market/')}>
      <span class="boite__n">001</span>
      <span class="boite__t">{t(lang, 'nav.movers')}</span>
      <span class="boite__d">{t(lang, 'mod.market.d')}</span>
    </a>
    <a class="boite" href={localize(lang, '/analytics/')}>
      <span class="boite__n">002</span>
      <span class="boite__t">{t(lang, 'nav.analytics')}</span>
      <span class="boite__d">{t(lang, 'mod.modules.d')}</span>
    </a>
    <a class="boite" href={localize(lang, '/collections/')}>
      <span class="boite__n">003</span>
      <span class="boite__t">{t(lang, 'nav.collections')}</span>
      <span class="boite__d">{t(lang, 'dash.sets.d')}</span>
    </a>
  </div>
</Base>
