---
// ⚠️ VeVePreda/veve-sites — src/pages/connexion/index.astro  (FICHIER NEUF)
// ═══════════════════════════════════════════════════════════════════════════
// LA CONNEXION — un aiguillage, pas un formulaire.
// ═══════════════════════════════════════════════════════════════════════════
// ⛔⛔ CETTE PAGE NE VÉRIFIE AUCUN MOT DE PASSE, ET C'EST VOLONTAIRE.
// Stocker des mots de passe, c'est se charger du hachage, du salage, de la
// limitation de débit, de la réinitialisation, des fuites et de leur
// notification. Sur un site à un seul développeur, c'est la dette la plus
// coûteuse qu'on puisse contracter — et la seule dont l'échec se paie en
// données d'autrui.
// Ici on DÉLÈGUE à `veveid`, qui existe déjà, qui tourne déjà sur Coolify, et
// qui porte déjà la notion d'identité VeVe. Cette page ne fait qu'envoyer la
// personne au bon endroit et l'y ramener.
// ⭐ LITTERAL, ET C'EST LE POINT. Astro exige que `prerender` soit
// statiquement analysable ; une EXPRESSION n'est pas evaluee et retombe
// silencieusement sur `true`. La valeur reelle est posee par l'integration
// `veve:routes-compte` (engine/lib/astro_routes_compte.mjs) selon le mode du
// manifeste. `true` ici est le defaut SUR : sans adaptateur, un build static
// ne peut pas rendre cette route a la demande.
export const prerender = true;

import Base from '../../layouts/Base.astro';
import { palierVisiteur, sessionDe } from '../../../engine/lib/access.mjs';
import { t, localize, locales } from '../../../engine/lib/i18n.mjs';
import { comptesActifs } from '../../../engine/lib/features.mjs';

// ⭐ CES PAGES SONT RENDUES À LA DEMANDE : elles peuvent donc lire l'en-tête
// `Accept-Language`, ce qu'une page pré-générée ne peut pas faire. Autant s'en
// servir — sinon un francophone connecté lit son compte en anglais.
// ⚠️ On ne fait confiance qu'aux langues que le SITE déclare : un en-tête est
// une donnée d'entrée comme une autre, il ne choisit pas dans un ensemble
// ouvert. `def` reste le repli, jamais une valeur devinée.
const { active, def } = locales();
const souhait = (Astro.request.headers.get('accept-language') || '')
  .split(',').map((x) => x.split(';')[0].trim().slice(0, 2).toLowerCase());
const lang = souhait.find((l) => active.includes(l)) || def;
// ⛔ DÉCISION PREDA DU 03/08/2026 : vevewiki n'aura JAMAIS d'espace membre.
// La question était ouverte depuis le lot 42 ; elle est close, on ne la
// repose pas.
// ⭐ Même dispositif que `/inscription/` : un `redirect` produit un talon que
// l'intégration `veve:fonctionnalites-eteintes` efface ensuite. Les deux
// moitiés vont ENSEMBLE — ce `redirect` seul laisserait une page fantôme, et
// l'audit SEO rouge en permanence (le défaut du 27/07).
if (!comptesActifs()) return Astro.redirect('/');

// 🔴🔴 CORRIGÉ LE 06/08/2026 — CETTE PAGE LISAIT UN PALIER POUR RÉPONDRE À UNE
// QUESTION D'IDENTITÉ. Sous `access.demo: crevette`, elle annonçait « vous êtes
// connecté » à tout le monde et offrait un bouton « Se déconnecter » qui
// effaçait un cookie jamais posé : au coup d'après la démo redonnait le palier.
// ⭐⭐ SE DÉCONNECTER ÉTAIT IMPOSSIBLE, ET CE N'ÉTAIT PAS UNE PANNE — c'était la
// conséquence exacte d'une porte ouverte à tout le monde. Preda l'a signalé
// comme un bug ; c'était la démo, vue par le seul écran qui pouvait la trahir.
// ⭐⭐⭐ LE PALIER DIT CE QU'ON A LE DROIT DE VOIR, LA SESSION DIT QUI ON EST.
const session = sessionDe(Astro.locals);
const connecte = session === 'reelle';
const palier = palierVisiteur(Astro.locals);
const idBase = process.env.VEVEID_URL || '';

// ⚠️ LE RETOUR EST CONSTRUIT CÔTÉ SERVEUR, JAMAIS REPRIS D'UN PARAMÈTRE.
// Un `?retour=` accepté tel quel est une redirection ouverte : il suffit d'un
// lien pour renvoyer la personne, jeton en main, vers un site tiers.
const retour = new URL('/compte/', Astro.site || 'https://veveprice.com').href;
const lien = idBase ? `${idBase}/oauth/start?retour=${encodeURIComponent(retour)}` : '';
---
      {/* ⛔ UNE SEULE LANGUE DÉCLARÉE, ET C'EST LE CORRECTIF DU 404.
          `/compte/` et `/connexion/` sont rendues À LA DEMANDE et lisent
          `Accept-Language` : elles n'ont qu'UNE adresse, sans préfixe. Sans
          `langs`, la barre de langues et les `hreflang` proposaient
          `/fr/compte/`, `/es/compte/`, `/de/compte/` — trois 404.
          ⭐ Le mécanisme existait déjà : Base.astro le porte depuis le 28/07,
          posé pour exactement cette raison — « un hreflang vers une URL absente
          est une promesse rompue faite à un moteur, et le sélecteur de langue,
          qui lit la même liste, y envoyait le visiteur ». Je l'ai recommis en
          créant deux pages neuves sans lire ce que le gabarit savait déjà. */}
<Base langs={[def]} lang={lang} path="/connexion/" title={t(lang, 'login.title')}
      crumbs={[{ name: t(lang, 'home.crumb'), url: localize(lang, '/') }, { name: t(lang, 'login.title') }]}>

  <span class="logo logo--xl" aria-hidden="true">VP</span>
  <h1 class="mono-t">{t(lang, 'login.title')}</h1>

  {connecte ? (
    <section class="panneau">
      <p>{t(lang, 'login.already')}</p>
      <a class="btn btn--principal btn--sm" href={localize(lang, '/compte/')}>{t(lang, 'account.title')}</a>
      {/* ⚠️ La déconnexion est un POST, pas un lien. Un GET destructeur est
          déclenchable par un simple <img src>, et les préchargeurs de liens du
          navigateur le suivent tout seuls : on déconnecterait les gens sans
          qu'ils aient rien cliqué. */}
      <form class="champ" method="POST" action="/api/deconnexion" style="margin-top:var(--s4)">
        <button type="submit" class="btn btn--fantome btn--sm">{t(lang, 'login.out')}</button>
      </form>
    </section>
  ) : (
    <section class="panneau">
      <p class="respire">{t(lang, 'login.lead')}</p>
      {lien
        ? <a class="btn btn--principal btn--sm" href={lien} rel="nofollow">{t(lang, 'login.veveid')}</a>
        : /* ⛔ Pas de service d'identité configuré : on le DIT. Un bouton mort
             ferait croire à une panne du site plutôt qu'à une étape à venir. */
          <p class="muted">{t(lang, 'login.nosvc')}</p>}
      <p class="muted" style="font-size:13px;margin-top:var(--s4)">{t(lang, 'login.why')}</p>
    </section>
  )}
</Base>
