---
import Base from '../../layouts/Base.astro';
import { dataset } from '../../../engine/lib/dataset.mjs';
import { itemListLd } from '../../../engine/lib/seo.mjs';
import { siteUrl } from '../../../engine/lib/manifest.mjs';

export async function getStaticPaths() {
  const ds = await dataset();
  return [...ds.collections.values()].map((c) => ({ params: { slug: c.slug }, props: { col: c } }));
}
const { col } = Astro.props;
const root = siteUrl();
const items = [...col.items].sort((a, b) => (b.floor ?? 0) - (a.floor ?? 0));
const money = (v) => (v === null || v === undefined ? '—' : v.toLocaleString('fr-FR', { maximumFractionDigits: 2 }));
const ld = [itemListLd(items.map((i) => ({ name: i.name, url: `${root}/item/${i.slug}/` })), `${root}/collection/${col.slug}/`)];
---
<Base title={`${col.name} — prix des collectibles`} description={`Tous les collectibles de la collection ${col.name} : prix plancher, offres et historique.`} crumbs={[{ name: 'Accueil', url: '/' }, { name: 'Collections', url: '/collections/' }, { name: col.name }]} ld={ld}>
  <h1>{col.name}</h1>
  <p class="lead">{items.length} collectibles suivis dans cette collection.</p>
  <table>
    <thead><tr><th>Collectible</th><th class="hide">Rareté</th><th class="num">Plancher</th><th class="num hide">Offres</th></tr></thead>
    <tbody>
      {items.map((i) => (
        <tr>
          <td><a href={`/item/${i.slug}/`}>{i.name}</a></td>
          <td class="hide">{i.rarity}</td>
          <td class="num">{money(i.floor)}</td>
          <td class="num hide">{i.listings ?? '—'}</td>
        </tr>
      ))}
    </tbody>
  </table>
</Base>
