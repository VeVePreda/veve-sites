---
import { priceEnabled } from '../../../engine/lib/features.mjs';
import CollectionPage from '../../components/pages/CollectionPage.astro';
import { dataset } from '../../../engine/lib/dataset.mjs';
import { locales } from '../../../engine/lib/i18n.mjs';
// 🎯 LOT N — UNE PAGE = UN SET (`series_uuid`), ET LES ALIAS.
// `col.alias` : les anciennes adresses (clé du lot 71) qu'AUCUN set ne porte
// plus, parce que leurs pièces ont rejoint ce set-ci. On les sert AUSSI, avec
// le même contenu : `CollectionPage` pose le canonical sur `/collection/
// ${col.slug}/`, donc l'alias se déclare lui-même doublon de la vraie page.
// ⛔ Pas un talon `http-equiv=refresh` (page fantôme, lot 139) ; pas un 301
//    (nginx sert `/collection/` sans Node). Voir `engine/lib/sets.mjs` § 3 bis.
export async function getStaticPaths() {
  if (!priceEnabled()) return [];
  const ds = await dataset();
  const out = [];
  for (const e of ds.collections.values()) {
    out.push({ params: { slug: e.slug }, props: { col: e, updatedAt: ds.updatedAt } });
    for (const a of (e.alias || [])) out.push({ params: { slug: a }, props: { col: e, updatedAt: ds.updatedAt } });
  }
  return out;
}
const { col, updatedAt } = Astro.props;
const lang = locales().def;
---
<CollectionPage lang={lang} col={col} updatedAt={updatedAt} />
