---
import { priceEnabled } from '../../../engine/lib/features.mjs';
import CollectionPage from '../../components/pages/CollectionPage.astro';
import { dataset } from '../../../engine/lib/dataset.mjs';
import { locales } from '../../../engine/lib/i18n.mjs';
export async function getStaticPaths() {
  if (!priceEnabled()) return [];
  const ds = await dataset();
  return [...ds.collections.values()].map((e) => ({ params: { slug: e.slug }, props: { col: e, updatedAt: ds.updatedAt } }));
}
const { col, updatedAt } = Astro.props;
const lang = locales().def;
---
<CollectionPage lang={lang} col={col} updatedAt={updatedAt} />
