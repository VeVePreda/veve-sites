    <div>
      <h2>{t(lang, 'footer.col.explore')}</h2>
      <ul>
        {menuComplet.filter((e) => !e.membre).map((e) => (
          <li><a href={e.href}>{e.label}</a></li>
        ))}
      </ul>
    </div>

    {/* ── COLONNE 3 · légal ───────────────────────────────────────────── */}
    {/* ⚠️ LA CLASSE `legal-links` SUIT LES LIENS DANS LEUR NOUVELLE COLONNE.
        Elle n'est pas décorative : elle est habillée par le SOCLE de
        `feuille_theme.mjs` (hors des thèmes), par `encyclopedie` (4 règles),
        et surtout la feuille d'impression des DEUX thèmes s'en sert pour ne
