  (function () {
    try {
      if (localStorage.getItem('langChoice') || localStorage.getItem('langDismiss')) return;
      var nav = (navigator.language || '').slice(0, 2).toLowerCase();
      var match = suggestData.filter(function (s) { return s.l === nav; })[0];
      if (!match) return;
