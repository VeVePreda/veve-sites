{/* ═══════════════════════════════════════════════════════════════════════════
    LA PALETTE DE RECHERCHE — disponible sur TOUTES les pages.
    ═══════════════════════════════════════════════════════════════════════════
    ⭐ Elle lit `/search-index.json`, deja genere par le moteur : aucune donnee
    neuve, aucune collecte, aucun index a maintenir.
    ⚠️ SON STYLE EST AUTONOME. Ce fichier sert les 15 sites du reseau, et
    `boite`, `carte`, `panneau` n'existent QUE dans le theme `vitrine` — mesure
    le 03/08 : 31 classes sur 35. On n'utilise donc que les JETONS que chaque
    site emet depuis son manifeste (`--surface`, `--text`, `--muted`, `--rule`),
    verifies presents sur veveprice ET vevewiki.
    ⛔ Ne pas y mettre une classe de theme « parce que c'est plus joli » : elle
    serait inerte sur l'encyclopedie, et personne ne le verrait avant un
    utilisateur. */}
<dialog id="palette" aria-label={t(lang, 'search.placeholder')}>
  <input id="palette-q" type="search" autocomplete="off" placeholder={t(lang, 'search.placeholder')} />
  <div id="palette-r" role="listbox"></div>
</dialog>
<style>
  #palette{border:1px solid var(--rule,#3a3a3a);border-radius:12px;padding:0;width:min(620px,92vw);
    background:var(--surface,#222);color:var(--text,#fff);box-shadow:0 24px 60px #00000080}
  #palette::backdrop{background:#000000A6}
  #palette-q{width:100%;box-sizing:border-box;border:0;border-bottom:1px solid var(--rule,#3a3a3a);
    background:transparent;color:inherit;font:inherit;font-size:17px;padding:16px 18px;outline:0}
  #palette-r{max-height:min(58vh,420px);overflow:auto;padding:6px}
  #palette-r a{display:block;padding:10px 12px;border-radius:8px;color:inherit;text-decoration:none;
    font-size:14px;line-height:1.35}
  #palette-r a:hover,#palette-r a[aria-selected="true"]{background:var(--surface-2,#33333a);text-decoration:none}
  #palette-r p{padding:14px 12px;margin:0;color:var(--muted,#999);font-size:14px}
</style>
<script is:inline define:vars={{ prefixe: localize(lang, ''), rien: t(lang, 'search.none') }}>
  (function () {
    var d = document.getElementById('palette');
    if (!d || typeof d.showModal !== 'function') return;   // pas de dialog : le lien vers l'accueil reste
    var q = document.getElementById('palette-q'), r = document.getElementById('palette-r');
    var idx = null, sel = -1;

    function rendre(list) {
      sel = -1;
      if (!list.length) { r.innerHTML = '<p>' + rien + '</p>'; return; }
      r.innerHTML = list.slice(0, 30).map(function (i) {
        return '<a role="option" href="' + prefixe + i.s + '">' + i.n + '</a>';
      }).join('');
    }
    function filtrer() {
      var v = q.value.trim().toLowerCase();
      if (!v) { r.innerHTML = ''; return; }
      if (!idx) return;
      rendre(idx.filter(function (i) { return i.n.toLowerCase().indexOf(v) !== -1; }));
    }
    // ⭐ L'index n'est cherche qu'A LA PREMIERE OUVERTURE. Le charger au chargement
    //    de page ferait payer 9 Ko a chaque visiteur pour une fonction que la
    //    plupart n'ouvriront jamais.
    function ouvrir(e) {
      if (e) e.preventDefault();
      d.showModal(); q.value = ''; r.innerHTML = ''; q.focus();
      if (!idx) {
        fetch('/search-index.json').then(function (x) { return x.json(); })
          .then(function (j) { idx = j; filtrer(); })
          .catch(function () { r.innerHTML = '<p>' + rien + '</p>'; });
      }
    }
    // ⚠️ TOUS LES DÉCLENCHEURS, PAS LE PREMIER — corrigé au lot 43.
    // `getElementById` ne rend qu'UN élément. Le jour où une page a deux
    // entrées vers la palette (l'accueil en a une dans l'en-tête ET une dans
    // le hero depuis le retrait de sa barre de recherche), la seconde était
    // muette — et un id dupliqué, en prime, est du HTML invalide.
    // ⭐ Un crochet de comportement se pose en ATTRIBUT, pas en id : un id est
    // unique par définition, donc il ne peut pas désigner « tous ceux qui font
    // cette chose ». C'est ce que l'id disait, et c'était faux.
    var liens = document.querySelectorAll('[data-ouvrir-palette]');
    for (var li = 0; li < liens.length; li++) liens[li].addEventListener('click', ouvrir);
    q.addEventListener('input', filtrer);

    // Clavier : fleches + Entree. Un champ de recherche qu'on ne peut pas
    // parcourir au clavier oblige a lacher la souris pour rien.
    q.addEventListener('keydown', function (e) {
      var opts = r.querySelectorAll('a');
      if (!opts.length) return;
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        if (sel >= 0) opts[sel].removeAttribute('aria-selected');
        sel = e.key === 'ArrowDown' ? (sel + 1) % opts.length : (sel <= 0 ? opts.length - 1 : sel - 1);
        opts[sel].setAttribute('aria-selected', 'true');
        opts[sel].scrollIntoView({ block: 'nearest' });
      } else if (e.key === 'Enter' && sel >= 0) {
        e.preventDefault(); opts[sel].click();
      }
    });

    // ⌘K / Ctrl+K partout. ⛔ L'accueil a son PROPRE champ `#q` et son propre
    //    raccourci : on lui laisse la main pour ne pas ouvrir deux choses a la
    //    fois sur la seule page ou la recherche est deja sous les yeux.
    document.addEventListener('keydown', function (e) {
      if ((e.metaKey || e.ctrlKey) && e.key && e.key.toLowerCase() === 'k') {
        if (document.getElementById('q')) return;
        e.preventDefault(); ouvrir();
      }
    });
    d.addEventListener('click', function (e) { if (e.target === d) d.close(); });
  })();
</script>
{/* ═══ LOT 68 — l'ouverture du dépliant de navigation ═══
    ⭐ `is:inline` et rien d'autre : cinq lignes de JavaScript n'ont pas besoin
    d'un module, et un menu qui attend un bundle est un menu mort pendant deux
    secondes sur un téléphone.
    ⚠️ SANS JAVASCRIPT LE BOUTON EST INERTE — mais il n'est pas la seule voie :
    la barre du bas (`.onglets`) et le pied de page restent en HTML pur. On ne
    supprime jamais le dernier chemin, on en ajoute un plus commode. */}
<script is:inline>
  (function () {
    var b = document.getElementById('menu-b');
    var m = document.getElementById('menu-m');
    if (!b || !m) return;
    function poser(ouvert) {
      m.hidden = !ouvert;
      b.setAttribute('aria-expanded', String(ouvert));
      // 🔴 LOT 118 — LE VOILE DU TIROIR. `body[data-tiroir]::after` l'allume.
      // ⭐ UN SEUL ATTRIBUT POUR DEUX EFFETS (l'assombrissement ET
      //   `pointer-events`), posé au même instant que `hidden`. Deux
