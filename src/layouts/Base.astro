    <div>
      <h2>{t(lang, 'footer.col.legal')}</h2>
      <ul class="legal-links">
        {DOCS.map((d) => (
          <li><a href={localize(lang, `/legal/${d}/`)}>{legalTitle(lang, d)}</a></li>
        ))}
      </ul>
    </div>

    {/* ── COLONNE 4 · à propos ────────────────────────────────────────── */}
    <div>
      <h2>{t(lang, 'footer.col.about')}</h2>
      {/* 🔴🔴 CETTE COLONNE A FAILLI ÊTRE VIDE, ET C'ÉTAIT LE DÉFAUT QU'ON
          RÉPARE, REFAIT UN ÉTAGE PLUS BAS. Premier jet : partenaires + note
          d'affiliation + langues. Mesuré AVANT de construire —
          `links.team: []` et `links.affiliate: []` sur **les deux** sites, et
          `langAuPied` faux sur les deux : la colonne serait sortie avec un
          titre « À propos » et **rien dessous**, sur 3 360 pages.
          ⭐⭐ *J'allais livrer un émetteur sans contenu en corrigeant une règle
          sans émetteur.* Le premier jet était plausible, il compilait, et
          seule la lecture du manifeste l'a dit — pas la relecture du gabarit.
          ⇒ « non affilié à VeVe » MONTE ICI. C'est littéralement un énoncé
          « à propos », c'est vrai sur les deux sites, et ça ne dépend d'aucun
          réglage optionnel. La colonne a donc toujours au moins une ligne. */}
      <ul>
        <li>{t(lang, 'legal.notAffiliated')}</li>
        {team.map((l) => (<li><a href={l.url} target="_blank" rel="noopener">{l.label}</a></li>))}
        {affiliate.map((l) => (
          <li><a href={l.url} target="_blank" rel="sponsored noopener">{l.label} ({t(lang, 'footer.partner')})</a></li>
        ))}
        {affiliate.length > 0 && <li>{t(lang, 'footer.affiliateNote')}</li>}
        {/* ⛔ `langAuPied` CONTINUE DE FONCTIONNER, ET C'ÉTAIT UNE CONTRAINTE
            EXPLICITE. Le pied peut porter les langues : sur un site qui règle
            `langues_dans: pied`, elles atterrissent ici, dans la colonne
            « à propos », au lieu de flotter entre deux paragraphes.
            ⚠️ C'est le sélecteur d'ADRESSES (`alternates`) — à ne pas
            confondre avec celui de l'en-tête, qui choisit les LIBELLÉS. */}
        {langAuPied && alternates.length > 1 && (
          <li class="f-langues">
            <span class="etiq">{t(lang, 'footer.language')}</span>
            {alternates.map((a) => (
              <a class="tag" href={a.href} hreflang={a.lang}
                 aria-current={a.lang === lang ? 'true' : undefined}>{localeNames[a.lang] || a.lang.toUpperCase()}</a>
            ))}
          </li>
        )}
      </ul>
    </div>
  </div>

  {/* ── LA BARRE DU BAS ─────────────────────────────────────────────────
      ⭐ `.f-legal` porte un `border-top` : il séparait autrefois DEUX ÉLÉMENTS
      DE GRILLE, c'est-à-dire qu'il traçait un trait au milieu d'une colonne.
      Sorti de `.site-f__cols`, il redevient ce qu'il a toujours voulu être :
      un filet sous les quatre colonnes.
      ⛔ Les deux avertissements NE MONTENT PAS en colonne. « Non affilié à
      VeVe » et « ceci n'est pas un conseil financier » ne sont pas des liens
      qu'on range par thème : ils s'adressent à quiconque lit n'importe quelle
      page, et leur place est sous tout le reste. */}
  <div class="f-legal">
    {/* ⛔ UN SEUL AVERTISSEMENT ICI, ET C'EST CELUI QUI DOIT ÊTRE SOUS TOUT LE
        RESTE. « Ceci n'est pas un conseil financier » ne se range pas dans une
        rubrique : il porte sur chaque chiffre de chaque page. « Non affilié à
        VeVe » est monté en colonne « à propos », où il répond à une question
        qu'on se pose — et non à une clause qu'on subit. ⛔ Il n'est écrit
        qu'une fois : deux endroits, c'est deux textes qui divergeront. */}
    <p style="margin:0;font-size:13px">{t(lang, 'legal.notFinancialAdvice')}</p>
  </div>
</div></footer>
{pNuit && (
  <script is:inline define:vars={{ BG_JOUR: p.bg, BG_NUIT: pNuit.bg }}>
    (function () {
      var b = document.getElementById('bascule-theme');
      if (!b) return;
      var racine = document.documentElement;
      var meta = document.querySelector('meta[name="theme-color"]');
      function poser(nuit) {
        if (nuit) racine.setAttribute('data-theme', 'nuit');
        else racine.removeAttribute('data-theme');
        b.setAttribute('aria-pressed', String(nuit));
        // La barre d'adresse d'Android suit, sinon elle reste claire au-dessus
        // d'une page sombre.
        if (meta) meta.setAttribute('content', nuit ? BG_NUIT : BG_JOUR);
      }
      poser(racine.getAttribute('data-theme') === 'nuit');
      b.addEventListener('click', function () {
        var nuit = racine.getAttribute('data-theme') !== 'nuit';
        poser(nuit);
        try { localStorage.setItem('veve-theme', nuit ? 'nuit' : 'jour'); } catch (e) {}
      });
    })();
  </script>
)}

<script is:inline define:vars={{ suggestData, suggestTxt: t(lang, 'lang.suggest'), switchTxt: t(lang, 'lang.switch'), dismissTxt: t(lang, 'lang.dismiss') }}>
  // Detection DOUCE : on propose, on ne redirige jamais (sinon Googlebot ne verrait qu'une langue).
  (function () {
    try {
      if (localStorage.getItem('langChoice') || localStorage.getItem('langDismiss')) return;
      var nav = (navigator.language || '').slice(0, 2).toLowerCase();
      var match = suggestData.filter(function (s) { return s.l === nav; })[0];
      if (!match) return;
      var box = document.getElementById('langsuggest');
      box.innerHTML = suggestTxt + ' <a href="' + match.h + '">' + match.n + '</a> — <button type="button">' + dismissTxt + '</button>';
      box.style.display = 'block';
      box.querySelector('a').addEventListener('click', function () { localStorage.setItem('langChoice', match.l); });
      box.querySelector('button').addEventListener('click', function () { localStorage.setItem('langDismiss', '1'); box.style.display = 'none'; });
    } catch (e) {}
  })();
</script>

{/* ═══════════════════════════════════════════════════════════════════════════
    LA PALETTE DE RECHERCHE — disponible sur TOUTES les pages.
    ═══════════════════════════════════════════════════════════════════════════
    ⭐ Elle lit `/search-index.json`, deja genere par le moteur : aucune donnee
    neuve, aucune collecte, aucun index a maintenir.
    ⚠️ SON STYLE EST AUTONOME. Ce fichier sert les 15 sites du reseau, et
    `boite`, `carte`, `panneau` n'existent QUE dans le theme `vitrine` — mesure
    le 03/08 : 31 classes sur 35. On n'utilise donc que les JETONS que chaque
    site emet depuis son manifeste (`--surface`, `--text`, `--muted`, `--rule`),
    verifies presents sur veveprice ET vevewiki.
    ⛔ Ne pas y mettre une classe de theme « parce que c'est plus joli » : elle
    serait inerte sur l'encyclopedie, et personne ne le verrait avant un
    utilisateur. */}
<dialog id="palette" aria-label={t(lang, 'search.placeholder')}>
  <input id="palette-q" type="search" autocomplete="off" placeholder={t(lang, 'search.placeholder')} />
  <div id="palette-r" role="listbox"></div>
</dialog>
<style>
  #palette{border:1px solid var(--rule,#3a3a3a);border-radius:12px;padding:0;width:min(620px,92vw);
    background:var(--surface,#222);color:var(--text,#fff);box-shadow:0 24px 60px #00000080}
  #palette::backdrop{background:#000000A6}
  #palette-q{width:100%;box-sizing:border-box;border:0;border-bottom:1px solid var(--rule,#3a3a3a);
    background:transparent;color:inherit;font:inherit;font-size:17px;padding:16px 18px;outline:0}
  #palette-r{max-height:min(58vh,420px);overflow:auto;padding:6px}
  #palette-r a{display:block;padding:10px 12px;border-radius:8px;color:inherit;text-decoration:none;
    font-size:14px;line-height:1.35}
  #palette-r a:hover,#palette-r a[aria-selected="true"]{background:var(--surface-2,#33333a);text-decoration:none}
  #palette-r p{padding:14px 12px;margin:0;color:var(--muted,#999);font-size:14px}
</style>
<script is:inline define:vars={{ prefixe: localize(lang, ''), rien: t(lang, 'search.none') }}>
  (function () {
    var d = document.getElementById('palette');
    if (!d || typeof d.showModal !== 'function') return;   // pas de dialog : le lien vers l'accueil reste
    var q = document.getElementById('palette-q'), r = document.getElementById('palette-r');
    var idx = null, sel = -1;

    function rendre(list) {
      sel = -1;
      if (!list.length) { r.innerHTML = '<p>' + rien + '</p>'; return; }
      r.innerHTML = list.slice(0, 30).map(function (i) {
        return '<a role="option" href="' + prefixe + i.s + '">' + i.n + '</a>';
      }).join('');
    }
    function filtrer() {
      var v = q.value.trim().toLowerCase();
      if (!v) { r.innerHTML = ''; return; }
      if (!idx) return;
      rendre(idx.filter(function (i) { return i.n.toLowerCase().indexOf(v) !== -1; }));
    }
    // ⭐ L'index n'est cherche qu'A LA PREMIERE OUVERTURE. Le charger au chargement
    //    de page ferait payer 9 Ko a chaque visiteur pour une fonction que la
    //    plupart n'ouvriront jamais.
    function ouvrir(e) {
      if (e) e.preventDefault();
      d.showModal(); q.value = ''; r.innerHTML = ''; q.focus();
      if (!idx) {
        fetch('/search-index.json').then(function (x) { return x.json(); })
          .then(function (j) { idx = j; filtrer(); })
          .catch(function () { r.innerHTML = '<p>' + rien + '</p>'; });
      }
    }
    // ⚠️ TOUS LES DÉCLENCHEURS, PAS LE PREMIER — corrigé au lot 43.
    // `getElementById` ne rend qu'UN élément. Le jour où une page a deux
    // entrées vers la palette (l'accueil en a une dans l'en-tête ET une dans
    // le hero depuis le retrait de sa barre de recherche), la seconde était
    // muette — et un id dupliqué, en prime, est du HTML invalide.
    // ⭐ Un crochet de comportement se pose en ATTRIBUT, pas en id : un id est
    // unique par définition, donc il ne peut pas désigner « tous ceux qui font
    // cette chose ». C'est ce que l'id disait, et c'était faux.
    var liens = document.querySelectorAll('[data-ouvrir-palette]');
    for (var li = 0; li < liens.length; li++) liens[li].addEventListener('click', ouvrir);
    q.addEventListener('input', filtrer);

    // Clavier : fleches + Entree. Un champ de recherche qu'on ne peut pas
    // parcourir au clavier oblige a lacher la souris pour rien.
    q.addEventListener('keydown', function (e) {
      var opts = r.querySelectorAll('a');
      if (!opts.length) return;
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        if (sel >= 0) opts[sel].removeAttribute('aria-selected');
        sel = e.key === 'ArrowDown' ? (sel + 1) % opts.length : (sel <= 0 ? opts.length - 1 : sel - 1);
        opts[sel].setAttribute('aria-selected', 'true');
        opts[sel].scrollIntoView({ block: 'nearest' });
      } else if (e.key === 'Enter' && sel >= 0) {
        e.preventDefault(); opts[sel].click();
      }
    });

    // ⌘K / Ctrl+K partout. ⛔ L'accueil a son PROPRE champ `#q` et son propre
    //    raccourci : on lui laisse la main pour ne pas ouvrir deux choses a la
    //    fois sur la seule page ou la recherche est deja sous les yeux.
    document.addEventListener('keydown', function (e) {
      if ((e.metaKey || e.ctrlKey) && e.key && e.key.toLowerCase() === 'k') {
        if (document.getElementById('q')) return;
        e.preventDefault(); ouvrir();
      }
    });
    d.addEventListener('click', function (e) { if (e.target === d) d.close(); });
  })();
</script>
{/* ═══ LOT 68 — l'ouverture du dépliant de navigation ═══
