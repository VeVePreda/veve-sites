---
import { createHash } from 'node:crypto';
import { manifest, siteUrl } from '../../engine/lib/manifest.mjs';
import { jsonld, websiteLd, pageTitle, homeTitle, breadcrumbLd } from '../../engine/lib/seo.mjs';
import { locales, t, pick, localize, localeNames, dateLocale } from '../../engine/lib/i18n.mjs';
import { DOCS, legalTitle } from '../../engine/lib/legal.mjs';
import { activeSections, sectionMeta, languesDuSite } from '../../engine/lib/editorial_pages.mjs';
import { priceEnabled, searchEnabled } from '../../engine/lib/features.mjs';
import Figures from '../components/Figures.astro';
import { blogEnabled, blogMeta, languesBlog } from '../../engine/lib/blog.mjs';

const m = manifest();
const p = m.identity.palette || {};
const f = m.identity.fonts || {};
const links = m.links || {};
// `langs` : les langues où CETTE page existe vraiment. Non fourni = les langues
// du site. C'est ce qui empêche un hreflang d'annoncer /es/brands/ quand cette
// page n'est pas construite (cf. engine/lib/langues.mjs).
const { lang, path = '/', altPaths = null, langs = null, title, description, crumbs = [], ld = [], updatedAt = null, noindex = false, image = null } = Astro.props;
const { active, def } = locales();
const prixActifs = priceEnabled();
// Nav PILOTEE PAR LE MANIFESTE : un site avec des pages editoriales (bloc
// `editorial.pages`) montre SES sections ; sinon on garde la nav « prix »
// historique. Zero regression : veveprice (sans bloc editorial) ne bouge pas.
// Le BLOG n'est pas une « section » editoriale (rendu propre, engine/lib/blog.mjs) :
// on l'ajoute en fin de nav quand le manifeste l'active (`editorial.pages: [... blog]`).
// ⚠️ La nav est calculee POUR CETTE LANGUE, pas pour le site : `activeSections(lang)`
// ne rend que les sections dont la traduction atteint le seuil. Sans le
// parametre, /es/ afficherait des onglets Brands / History / Directory menant a
// des pages qui ne sont pas construites — quatre 404 sur chaque page espagnole.
const blogDansCetteLangue = blogEnabled() && (await languesBlog()).includes(lang);
const wikiNav = (m.editorial && Array.isArray(m.editorial.pages) && m.editorial.pages.length)
  ? activeSections(lang).map((sx) => sectionMeta(sx, lang)).concat(
      blogDansCetteLangue
        ? [{ section: 'blog', path: '/blog/',
             title: blogMeta(lang, { title: t(lang, 'blog.title') }).title }]
        : [])
  : null;
const root = siteUrl();

// Budget de 60 caracteres tenu A LA RACINE (engine/lib/seo.mjs) : aucune page du
// reseau ne peut plus publier un titre que Google tronquera, et un raboutage se
// voit dans le journal de build.
const journalSeo = (msg) => console.warn(`[seo] ${path} — ${msg}`);
// Accueil : titre du MANIFESTE (`seo.home_title`), jamais le libelle reseau
// « prix » par accident. Interieur : gabarit + budget de 60 caracteres.
const accueil = homeTitle({
  brand: m.site.brand, homeTitles: m.seo?.home_title, lang, defLang: def,
  repliReseau: t(lang, 'title.home'), sitePrix: prixActifs, journal: journalSeo,
});
const fullTitle = pageTitle(title, m.seo.title_template, accueil, journalSeo);
const desc = description || pick(m.site.description, lang) || pick(m.site.tagline, lang);
const canon = `${root}${localize(lang, path)}`;
// Chaque langue a SA propre adresse ; hreflang les relie. Aucune redirection auto.
// Si altPaths est fourni (articles : slugs differents par langue), on ne
// declare QUE les langues qui existent reellement, avec leur propre chemin.
// ⭐⭐ ON NE DECLARE QUE CE QUI EST CONSTRUIT. Avant le 28/07 cette ligne
// parcourait `active` : toute langue listee au manifeste etait annoncee sur
// TOUTES les pages, qu'elles existent ou non dans cette langue. Un hreflang
// vers une URL absente est une promesse rompue faite a un moteur — et le
// selecteur de langue, qui lit la meme liste, y envoyait le visiteur.
// Trois etages, du plus precis au plus large :
//   altPaths -> la page connait ses propres adresses (articles : slugs differents)
//   langs    -> la page connait ses langues (sections : meme adresse partout)
//   defaut   -> les langues du site
const languesDeLaPage = langs || languesDuSite();
const alternates = (altPaths
  ? active.filter((l) => altPaths[l]).map((l) => ({ lang: l, href: `${root}${localize(l, altPaths[l])}` }))
  : languesDeLaPage.map((l) => ({ lang: l, href: `${root}${localize(l, path)}` })));

const themeFiles = import.meta.glob('../../themes/*/theme.css', { query: '?raw', import: 'default', eager: true });
const themeCss = themeFiles[`../../themes/${m.identity.theme}/theme.css`] ?? Object.values(themeFiles)[0] ?? '';
// ⭐ `color-scheme` DÉDUIT de la palette, jamais écrit en dur : ce dépôt sert
// plusieurs sites et en servira d'autres. Sans cette déclaration, le navigateur
// rend SES propres pièces — barres de défilement, champs, menus natifs — en
// thème clair au-dessus d'une page noire. Mesuré le 27/07 : aucune des
// 83 pages ne la portait.
const luminance = (hex) => {
  const h = String(hex || '').trim().replace('#', '');
  const s = h.length === 3 ? h.split('').map((c) => c + c).join('') : h;
  const v = [0, 2, 4].map((i) => parseInt(s.slice(i, i + 2), 16) / 255)
    .map((x) => (x <= 0.03928 ? x / 12.92 : ((x + 0.055) / 1.055) ** 2.4));
  return 0.2126 * v[0] + 0.7152 * v[1] + 0.0722 * v[2];
};
const colorScheme = luminance(p.bg) < 0.18 ? 'dark' : 'light';
const vars = `:root{color-scheme:${colorScheme};--primary:${p.primary};--accent:${p.accent};--danger:${p.danger};--bg:${p.bg};--surface:${p.surface};--text:${p.text};--muted:${p.muted};--font-heading:${f.heading};--font-body:${f.body}}`;

const canary = createHash('sha256')
  .update((process.env.CANARY_SALT || m.site.domain) + Astro.url.pathname)
  .digest('hex').slice(0, 16);

const team = links.team || [];
const affiliate = links.affiliate || [];
const fresh = updatedAt ? new Date(updatedAt).toLocaleDateString(dateLocale[lang] || 'en-GB') : null;
const analytics = m.analytics || {};
const statsOn = Boolean(analytics.website_id);
const suggestData = alternates.filter((a) => a.lang !== lang).map((a) => ({ l: a.lang, h: a.href, n: localeNames[a.lang] || a.lang }));
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
{/* La barre d'adresse d'Android prend cette couleur. Sans elle, elle reste
    claire au-dessus d'une page sombre — le premier écran d'un visiteur
    mobile. Elle suit la palette du site, elle n'est pas écrite en dur. */}
<meta name="theme-color" content={p.bg} />
<Figures />
<title>{fullTitle}</title>
<meta name="description" content={desc} />
<link rel="canonical" href={canon} />
{noindex && <meta name="robots" content="noindex,follow" />}
{alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
<link rel="alternate" hreflang="x-default" href={`${root}${localize(def, path)}`} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content={m.site.brand} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={desc} />
<meta property="og:url" content={canon} />
<meta name="twitter:card" content="summary_large_image" />
{/* Carte PROPRE à la page quand elle existe (articles), vignette du site
    sinon. Les deux font 1200x630 : les dimensions restent justes. */}
<meta property="og:image" content={`${root}${image || '/og.png'}`} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:image" content={`${root}${image || '/og.png'}`} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta name="generator-ref" content={canary} />
<meta name="build-time" content={updatedAt || new Date().toISOString()} />
{statsOn && <script defer src="/stats/script.js" data-website-id={analytics.website_id}></script>}
<style is:inline set:html={vars}></style>
<style is:inline set:html={themeCss}></style>
<style is:inline set:html={`.legal-links{margin:0 0 10px;font-size:12.5px;line-height:1.9;color:var(--muted)}.legal-links a{color:var(--muted);text-decoration:none;border-bottom:1px solid transparent}.legal-links a:hover,.legal-links a:focus-visible{color:var(--text);border-bottom-color:var(--muted)}.langbar{display:flex;gap:6px;margin-left:12px}.langbar a{font-size:13px;color:var(--muted);padding:2px 6px;border-radius:6px;min-height:24px;min-width:24px;display:inline-flex;align-items:center;justify-content:center}.langbar a[aria-current]{background:#ffffff14;color:var(--text)}.crumbs a{display:inline-block;padding:3px 0;min-height:24px}.legal-links a{display:inline-block;padding:3px 0;min-height:24px}.saut{position:absolute;left:-9999px;top:0;z-index:100;background:var(--surface);color:var(--text);border:1px solid var(--primary);border-radius:0 0 8px 0;padding:10px 16px;text-decoration:none}.saut:focus{left:0}#langsuggest{display:none;background:var(--surface);border:1px solid var(--primary);border-radius:10px;padding:10px 14px;margin:14px 0;font-size:14px}#langsuggest a{font-weight:500}#langsuggest button{background:none;border:0;color:var(--muted);cursor:pointer;font-size:13px;text-decoration:underline}`}></style>
<Fragment set:html={jsonld(websiteLd(m.site.brand, root, searchEnabled()))} />
{/* ⭐ Le fil d'Ariane était AFFICHÉ mais jamais DÉCLARÉ : 23 pages sur 83
    montraient « Accueil › Glossaire » à l'écran sans que Google puisse le
    reprendre dans ses résultats. Chaque page devait penser à l'émettre
    elle-même — la moitié l'oubliait. Il découle maintenant des crumbs, donc
    de la seule chose que la page a déjà dû fournir.
    ⚠️ On ne l'émet pas si la page en a déjà mis un : deux BreadcrumbList sur
    une même page est une erreur que Search Console signale. */}
{crumbs.length > 1 && !ld.some((o) => o && o['@type'] === 'BreadcrumbList') && (
  <Fragment set:html={jsonld(breadcrumbLd(crumbs.map((c) => ({
    name: c.name, url: c.url ? root + c.url : canon,
  }))))} />
)}
{ld.map((o) => <Fragment set:html={jsonld(o)} />)}
</head>
<body>
{/* ⭐ Lien d'évitement — WCAG 2.4.1, niveau A. Sans lui, un visiteur au clavier
    ou au lecteur d'écran traverse six liens de menu et le sélecteur de langue
    À CHAQUE PAGE avant d'atteindre le contenu. Il reste hors de l'écran tant
    qu'il n'a pas le focus : rien ne change pour qui utilise une souris. */}
<a class="saut" href="#contenu">{t(lang, 'a11y.skip')}</a>
<header class="site"><div class="wrap">
  <a class="brand" href={localize(lang, '/')}>{m.site.brand}</a>
  <nav class="main">
    {wikiNav
      ? wikiNav.map((sx) => (<a href={localize(lang, sx.path)}>{sx.title}</a>))
      : (<>
          {/* ⚠️ MEME CONDITION QUE LA NAV WIKI, et elle a ete payee : la nav
              « prix » pointait vers /blog/ dans TOUTES les langues du site. Le
              jour ou l'index d'articles a cesse d'etre emis dans les langues
              sans article (veveprice : es, de), ce lien est devenu un 404 sur
              chaque page espagnole et allemande — visible nulle part au build,
              puisque c'est un lien, pas une route. Une navigation ne se decide
              pas au niveau du SITE mais au niveau de la LANGUE. */}
          {blogDansCetteLangue && <a href={localize(lang, '/blog/')}>{t(lang, 'nav.blog')}</a>}
          <a href={localize(lang, '/movers/')}>{t(lang, 'nav.movers')}</a>
          <a href={localize(lang, '/collections/')}>{t(lang, 'nav.collections')}</a>
          <a href={localize(lang, '/rarity/')}>{t(lang, 'nav.rarities')}</a>
        </>)}
    <span class="langbar">
      {alternates.map((a) => (
        <a href={a.href} hreflang={a.lang} aria-current={a.lang === lang ? 'true' : undefined}>{a.lang.toUpperCase()}</a>
      ))}
    </span>
  </nav>
</div></header>
<main class="wrap" id="contenu" tabindex="-1">
  <div id="langsuggest"></div>
  {crumbs.length > 0 && (
    <div class="crumbs">
      {crumbs.map((c, i) => (<>{i > 0 && ' › '}{c.url ? <a href={c.url}>{c.name}</a> : <span>{c.name}</span>}</>))}
    </div>
  )}
  <slot />
</main>
<footer class="site"><div class="wrap">
  {fresh && <p style="margin:0 0 10px">{t(lang, 'footer.updated')} {fresh}.</p>}
  {(team.length > 0 || affiliate.length > 0) && (
    <p style="margin:0 0 10px">
      {team.map((l) => (<a class="tag" href={l.url} target="_blank" rel="noopener">{l.label}</a>))}
      {affiliate.map((l) => (<a class="tag" href={l.url} target="_blank" rel="sponsored noopener">{l.label} ({t(lang, 'footer.partner')})</a>))}
    </p>
  )}
  {affiliate.length > 0 && <p style="margin:0 0 10px;font-size:13px">{t(lang, 'footer.affiliateNote')}</p>}
  {/* Liens légaux DISCRETS : ils doivent rester atteignables depuis chaque page
      — c'est une obligation, pas un choix de mise en page — mais ils n'ont
      aucune raison d'attirer l'œil autant qu'un lien de contenu. On les recule
      visuellement (gris, plus petits), jamais on ne les cache. */}
  <p class="legal-links">
    {DOCS.map((d, i) => (<>{i > 0 && ' · '}<a href={localize(lang, `/legal/${d}/`)}>{legalTitle(lang, d)}</a></>))}
  </p>
  <p style="margin:0 0 6px">{t(lang, 'legal.notAffiliated')}</p>
  <p style="margin:0;font-size:13px">{t(lang, 'legal.notFinancialAdvice')}</p>
</div></footer>
<script is:inline>
  // Reassemble les adresses de contact cote navigateur (anti-aspirateur).
  (function () {
    var els = document.querySelectorAll('.mail');
    for (var i = 0; i < els.length; i++) {
      var u = els[i].getAttribute('data-u'), d = els[i].getAttribute('data-d');
      if (!u || !d) continue;
      var a = u + String.fromCharCode(64) + d;
      var link = document.createElement('a');
      link.href = 'mai' + 'lto' + ':' + a;
      link.textContent = a;
      els[i].textContent = '';
      els[i].appendChild(link);
    }
  })();
</script>
<script is:inline define:vars={{ suggestData, suggestTxt: t(lang, 'lang.suggest'), switchTxt: t(lang, 'lang.switch'), dismissTxt: t(lang, 'lang.dismiss') }}>
  // Detection DOUCE : on propose, on ne redirige jamais (sinon Googlebot ne verrait qu'une langue).
  (function () {
    try {
      if (localStorage.getItem('langChoice') || localStorage.getItem('langDismiss')) return;
      var nav = (navigator.language || '').slice(0, 2).toLowerCase();
      var match = suggestData.filter(function (s) { return s.l === nav; })[0];
      if (!match) return;
      var box = document.getElementById('langsuggest');
      box.innerHTML = suggestTxt + ' <a href="' + match.h + '">' + match.n + '</a> — <button type="button">' + dismissTxt + '</button>';
      box.style.display = 'block';
      box.querySelector('a').addEventListener('click', function () { localStorage.setItem('langChoice', match.l); });
      box.querySelector('button').addEventListener('click', function () { localStorage.setItem('langDismiss', '1'); box.style.display = 'none'; });
    } catch (e) {}
  })();
</script>
</body>
</html>
