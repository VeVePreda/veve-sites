---
import { createHash } from 'node:crypto';
import { manifest, siteUrl } from '../../engine/lib/manifest.mjs';
import { acces, connecte } from '../../engine/lib/access.mjs';
import { jsonld, websiteLd, pageTitle, homeTitle, breadcrumbLd, couperMots } from '../../engine/lib/seo.mjs';
import { locales, t, pick, localize, localeNames, dateLocale, numberLocale, nu, languesInterface, langueUiDansEntete } from '../../engine/lib/i18n.mjs';
import { degradesSpark } from '../../engine/lib/vitrine.mjs';
import { DOCS, legalTitle } from '../../engine/lib/legal.mjs';
import { activeSections, sectionMeta, languesDuSite, DESC_MAX } from '../../engine/lib/editorial_pages.mjs';
import { priceEnabled, searchEnabled } from '../../engine/lib/features.mjs';
import Figures from '../components/Figures.astro';
import CoteScript from '../components/CoteScript.astro';
import { blogEnabled, blogMeta, languesBlog } from '../../engine/lib/blog.mjs';
import { feuilleTheme } from '../../engine/lib/feuille_theme.mjs';
import { socleJs } from '../../engine/lib/socle_js.mjs';

const m = manifest();
const p = m.identity.palette || {};
const f = m.identity.fonts || {};
const links = m.links || {};
// `langs` : les langues où CETTE page existe vraiment. Non fourni = les langues
// du site. C'est ce qui empêche un hreflang d'annoncer /es/brands/ quand cette
// page n'est pas construite (cf. engine/lib/langues.mjs).
const { lang, path = '/', altPaths = null, langs = null, title, description, crumbs = [], ld = [], updatedAt = null, noindex = false, image = null, sect = 'general', fraicheurDonnee = null } = Astro.props;

// ═══════════════════════════════════════════════════════════════════════════
// 🔴🔴 LA COULEUR PAR SECTION — DIX RÈGLES DE THÈME QUE RIEN N'ACTIVAIT
// ═══════════════════════════════════════════════════════════════════════════
// Mesuré le 03/08/2026 : `[data-sect="cotes"]`, `"analyse"`, `"collectibles"`,
// `"comics"`, `"general"` portent chacune leur palette dans les trois thèmes —
// et **AUCUN gabarit n'émettait l'attribut**. Tout le système était mort. Le
// Marché s'affichait donc en cyan là où il devait être rouge, et personne ne
// pouvait le voir en lisant le thème : les règles étaient bien là.
//
// ⭐⭐ MÊME FAMILLE QUE `.boite__viz` DU MÊME LOT : une RÈGLE SANS CLASSE. On
// traque d'habitude l'inverse (la classe émise sans règle, qui a l'air d'être
// là) — celle-ci ne crie pas non plus, et elle est plus difficile à voir :
// le thème est complet, c'est le gabarit qui est muet.
//
// ⚠️ ET IL VA SUR L'ÉLÉMENT BODY, PAS SUR MAIN. L'en-tête est un FRÈRE de
// main, pas un descendant : posé sur le contenu, l'attribut laisserait la
// barre du haut dans la couleur d'origine. La maquette a payé exactement ce
// bug (son commentaire ligne 258) et conclut : « le plus petit ancêtre COMMUN
// à tout ce qu'elle colore ».
// ⭐ La liste est FERMÉE : une valeur inconnue retombe sur `general` au lieu
// de produire un `data-sect="markt"` silencieux qui ne matcherait rien.
// ⭐ LOT 68 (05/08/2026) — CINQ SECTIONS DE PLUS, demande de Preda : « chaque
// page doit avoir sa couleur, et la ligne du header doit la prendre ».
//   tableau   cyan    — le tableau de bord (l'accueil connecté)
//   blog      ambre
//   sets      bleu    — /collections/
//   offre     or
//   analytics violet  — remplace `analyse` sur /analytics/, qui valait le cyan
//                       du site et ne distinguait donc rien.
// ⛔ `analyse` RESTE dans la liste : d'autres pages du réseau la déclarent, et
//    la retirer les ferait retomber en `general` sans qu'aucun build le dise.
// ⚠️ AJOUTER UNE VALEUR ICI NE SUFFIT PAS. La palette doit exister dans le
//    thème (`themes/vitrine/theme.css`, bloc « LOT 68 ») — sinon la page tombe
//    sur les variables héritées et a l'air de « ne pas prendre la couleur »,
//    sans la moindre erreur au build. C'est le défaut du 03/08 retourné : là
//    le thème était complet et le gabarit muet, ici le gabarit parlerait dans
//    le vide.
const SECTIONS_COULEUR = ['general', 'collectibles', 'comics', 'cotes', 'analyse',
  'tableau', 'blog', 'sets', 'offre', 'analytics'];
const sectCouleur = SECTIONS_COULEUR.includes(sect) ? sect : 'general';
const { active, def } = locales();
const prixActifs = priceEnabled();
// Nav PILOTEE PAR LE MANIFESTE : un site avec des pages editoriales (bloc
// `editorial.pages`) montre SES sections ; sinon on garde la nav « prix »
// historique. Zero regression : veveprice (sans bloc editorial) ne bouge pas.
// Le BLOG n'est pas une « section » editoriale (rendu propre, engine/lib/blog.mjs) :
// on l'ajoute en fin de nav quand le manifeste l'active (`editorial.pages: [... blog]`).
// ⚠️ La nav est calculee POUR CETTE LANGUE, pas pour le site : `activeSections(lang)`
// ne rend que les sections dont la traduction atteint le seuil. Sans le
// parametre, /es/ afficherait des onglets Brands / History / Directory menant a
// des pages qui ne sont pas construites — quatre 404 sur chaque page espagnole.
const blogDansCetteLangue = blogEnabled() && (await languesBlog()).includes(lang);
// 🔴🔴 CORRIGE LE 03/08/2026 — LE MENU DE veveprice EST TOMBE A UN SEUL LIEN.
// ═══════════════════════════════════════════════════════════════════════════
// `wikiNav` s'activait sur la SEULE presence de `editorial.pages`. Au lot 37,
// veveprice a recu un bloc `editorial:` pour brancher son Sheet blog — et il
// est instantanement passe pour un wiki. Or `activeSections()` ne rend que les
// sections EDITORIALES, et le blog n'en est pas une : la liste valait `[]`, et
// la nav se reduisait au seul lien blog. **La nav du manifeste (lot 38)
// n'etait jamais atteinte** — elle vit dans la branche `else`.
//
// ⭐⭐ UN SITE N'EST PAS UN WIKI PARCE QU'IL A UN BLOC `editorial:`. Il l'est
// s'il a des SECTIONS EDITORIALES A MONTRER. Le test porte donc desormais sur
// `activeSections(lang).length`, c'est-a-dire sur ce qu'il y a vraiment a
// afficher — pas sur la presence d'une cle de configuration.
// ⛔ C'est la troisieme fois que ce bloc `editorial:` fait un degat lateral :
//    il avait deja supprime 15 pages (langues) au meme lot. Une cle de
//    manifeste qui commande TROIS comportements distincts est une cle qui
//    surprend.
// ⚠️ `nav:` du manifeste, lui, ne s'applique qu'aux sites qui le declarent :
//    vevewiki n'en a pas, sa branche wiki est donc intacte.
const sectionsWiki = (m.editorial && Array.isArray(m.editorial.pages) && m.editorial.pages.length)
  ? activeSections(lang) : [];
const wikiNav = sectionsWiki.length
  ? sectionsWiki.map((sx) => sectionMeta(sx, lang)).concat(
      blogDansCetteLangue
        ? [{ section: 'blog', path: '/blog/',
             title: blogMeta(lang, { title: t(lang, 'blog.title') }).title }]
        : [])
  : null;
const root = siteUrl();

// Budget de 60 caracteres tenu A LA RACINE (engine/lib/seo.mjs) : aucune page du
// reseau ne peut plus publier un titre que Google tronquera, et un raboutage se
// voit dans le journal de build.
const journalSeo = (msg) => console.warn(`[seo] ${path} — ${msg}`);
// Accueil : titre du MANIFESTE (`seo.home_title`), jamais le libelle reseau
// « prix » par accident. Interieur : gabarit + budget de 60 caracteres.
const accueil = homeTitle({
  brand: m.site.brand, homeTitles: m.seo?.home_title, lang, defLang: def,
  repliReseau: t(lang, 'title.home'), sitePrix: prixActifs, journal: journalSeo,
});
const fullTitle = pageTitle(title, m.seo.title_template, accueil, journalSeo);
// ═══════════════════════════════════════════════════════════════════════════
// 🔴🔴 LOT 134b — LA DESCRIPTION EST BORNEE **ICI**, PARCE QU'IL N'Y A QU'UN
//                 SEUL EMETTEUR DE `<meta name="description">`
// ═══════════════════════════════════════════════════════════════════════════
// TROUVE PAR `test:titres` DANS LE BUILD DOCKER, sur le catalogue REEL : 17
// pages a 161-168 caracteres, toutes sur le meme set au nom demesure
// (« Disney100 Platinum Moments Walt Disney Animation Studios Series », 62
// caracteres a lui seul). Au-dela de ~160, Google COUPE — et la fin, c'est ce
// qu'on avait a dire.
//
// ⭐⭐⭐ POURQUOI ICI ET PAS DANS LES GABARITS QUI COMPOSENT. Chaque page
// fabrique sa description a sa facon (`desc.item`, `desc.itemShort`,
// `desc.collection`, `rayon.*.d`, les pages editoriales…). Borner chez
// l'appelant, c'est ecrire la meme regle six fois — et *deux copies d'une meme
// regle divergent*, ce depot l'a paye trois fois sur des gabarits. Il n'y a
// qu'UN `<meta name="description">` dans tout le reseau : la garantie se pose
// la ou elle ne peut pas etre oubliee, y compris par une page pas encore ecrite.
// ⭐ Les gabarits gardent le droit de faire MIEUX (Item.astro bascule sur une
// formule courte plutot que de se faire couper) ; ce plancher-ci n'est qu'un
// filet, et un filet ne doit jamais etre la premiere solution.
//
// ⚠️ `nu()` AVANT DE MESURER ET DE COUPER, et ce n'est pas une precaution de
// style : sous `I18N_MARQUAGE=1`, `t()` entoure chaque libelle de marqueurs
// invisibles. Compter sans `nu()` couperait une description conforme ; couper
// sans `nu()` trancherait au milieu d'un marqueur — et c'est exactement ce qui
// a avale 64 `<head>` au lot 129.
// ⭐ La borne vient d'`editorial_pages.mjs`, la meme que celle du banc et celle
// de l'avertissement editorial. Un seuil recopie est un seuil qui divergera.
const descBrute = description || pick(m.site.description, lang) || pick(m.site.tagline, lang);
const descNue = nu(descBrute);
const desc = [...String(descNue)].length > DESC_MAX ? couperMots(descNue, DESC_MAX) : descBrute;
const canon = `${root}${localize(lang, path)}`;
// Chaque langue a SA propre adresse ; hreflang les relie. Aucune redirection auto.
// Si altPaths est fourni (articles : slugs differents par langue), on ne
// declare QUE les langues qui existent reellement, avec leur propre chemin.
// ⭐⭐ ON NE DECLARE QUE CE QUI EST CONSTRUIT. Avant le 28/07 cette ligne
// parcourait `active` : toute langue listee au manifeste etait annoncee sur
// TOUTES les pages, qu'elles existent ou non dans cette langue. Un hreflang
// vers une URL absente est une promesse rompue faite a un moteur — et le
// selecteur de langue, qui lit la meme liste, y envoyait le visiteur.
// Trois etages, du plus precis au plus large :
//   altPaths -> la page connait ses propres adresses (articles : slugs differents)
//   langs    -> la page connait ses langues (sections : meme adresse partout)
//   defaut   -> les langues du site
const languesDeLaPage = langs || languesDuSite();
// 🔴 LOT 120 — `Object.keys(altPaths)` ET NON `active.filter(...)`.
// `altPaths` ne contient QUE les langues où la page existe vraiment — c'est
// déjà la mesure. Le filtre sur `active` ajoutait une seconde condition qui
// disait la même chose... jusqu'à ce lot : `active` ne vaut plus que `[en]`,
// et les articles français auraient perdu leur `hreflang` alors que les pages
// existent et sont dans le plan du site.
// ⭐⭐ Une condition redondante n'est pas gratuite : elle est correcte tant que
// les deux sources coïncident, et elle devient fausse en silence le jour où
// l'une des deux change de sens. Ici la source la plus proche du fait —
// « cette page existe-t-elle dans cette langue ? » — suffit seule.
const alternates = (altPaths
  ? Object.keys(altPaths).map((l) => ({ lang: l, href: `${root}${localize(l, altPaths[l])}` }))
  : languesDeLaPage.map((l) => ({ lang: l, href: `${root}${localize(l, path)}` })));

// ⭐ LE THÈME N'EST PLUS RECOPIÉ ICI — LOT 105. Le glob, le garde-fou du
// thème introuvable, les variables de palette, les `@font-face` et le socle
// vivent désormais dans `engine/lib/feuille_theme.mjs`, qui les concatène
// dans le MÊME ordre et les sert comme une feuille unique portant son
// empreinte. ⛔ Ne pas les ramener ici : ce serait réinliner 168 850 octets
// dans chacune des 8 484 pages, et c'est exactement ce que `test:feuille`
// refuse désormais.
const feuilleCss = feuilleTheme();
// ⭐ MÊME FONCTION que la route qui sert le fichier : l'empreinte du `src` ne
// peut donc pas désigner autre chose que ce qui sera servi.
const socle = socleJs();

// ─────────────────────────────────────────────────────────────────────────────
//  DEUX PALETTES — ajouté le 30/07/2026, RÉTROCOMPATIBLE PAR CONSTRUCTION
// ─────────────────────────────────────────────────────────────────────────────
//  Un site déclare `identity.palette` comme avant : rien ne change pour lui, pas
//  de second bloc, pas de bouton. C'est le cas des 14 sites autres que vevewiki,
//  et la chaîne produite est identique au caractère près.
//  Un site qui déclare EN PLUS `identity.palette_nuit` obtient les deux jeux de
//  variables et le bouton de bascule.
//
//  ⚠️ CE QUI FAIT MARCHER LA BASCULE N'EST PAS ICI, C'EST LE FICHIER DE THÈME.
//  `aurora` code en dur des filets en blanc semi-transparent (#ffffff14) : ils
//  existent sur fond sombre et DISPARAISSENT sur fond clair. Un thème qui
//  suppose son fond ne peut pas basculer. Un thème qui n'utilise que ses
//  variables le peut. C'est la règle à tenir pour les 13 sites à venir.
// ⛔⛔ LA FONTE EST UNE DONNEE, COMME LE THEME ET LES PALIERS — 31/07/2026.
// Le manifeste declarait `'Archivo'` depuis le debut et RIEN ne l'apportait :
// zero @font-face, zero .woff2, zero preload. Le site s'affichait donc dans la
// fonte par defaut du navigateur — un serif — sur une direction artistique
// dont l'identite EST le caractere.
// ⭐ Une fonte declaree mais non servie ne provoque aucune erreur : le
// navigateur descend la pile de replis et fait comme si de rien n'etait.
// Un site obtient desormais ses fontes en declarant `identity.fonts.files`,
// sans une ligne de code — c'est ce qui evitera de refaire ce travail 13 fois.
const fontFiles = Array.isArray(f.files) ? f.files : [];

const pNuit = m.identity.palette_nuit || null;

const canary = createHash('sha256')
  .update((process.env.CANARY_SALT || m.site.domain) + Astro.url.pathname)
  .digest('hex').slice(0, 16);

const team = links.team || [];
const affiliate = links.affiliate || [];
// ═══════════════════════════════════════════════════════════════════════════
// LA FRAICHEUR — LOT 144 : LE PIED CESSE D'AFFIRMER CE QU'IL NE SAIT PAS
// ═══════════════════════════════════════════════════════════════════════════
// 🔴🔴 CE QUE CETTE LIGNE FAISAIT, ET QUI ETAIT FAUX SUR 1 200 PAGES.
// `updatedAt` est l'heure du DEPLOIEMENT. Sur une page qui decrit une donnee,
// « Donnees mises a jour le 12/08/2026 » ne parle pas de la donnee : il parle
// du jour ou l'on a reconstruit le site. Les 1 200 fiches affichaient donc
// toutes la MEME date, et 257 d'entre elles affirmaient une fraicheur que
// personne n'avait mesuree.
//
// ⭐⭐ LA DISTINCTION SE FAIT ICI, ET PAS CHEZ LES APPELANTS. Trente fichiers
// passent `updatedAt` a ce gabarit — le blog, les pages legales, le plan du
// site — et pour eux « mis a jour le <build> » est EXACT : ces pages ne
// decrivent aucune donnee, elles SONT la donnee. ⛔ Le lot ne les touche pas.
// Une page qui decrit une donnee le dit en passant `fraicheurDonnee`, et c'est
// la SEULE chose qui bascule le pied.
//
// ⛔⛔ ET SURTOUT PAS UNE LISTE DE CHEMINS. `ROUTES_COMPTE` est tenue a la main :
// une route oubliee y est pre-generee EN SILENCE. Une liste de chemins ici
// aurait le meme defaut, en pire — elle laisserait la page suivante mentir sans
// qu'un run rougisse. → [[regle-invariant-plutot-quune-seconde-liste]]
//
// TROIS ETATS, ET AUCUN N'EST APLATI :
//   `fraicheurDonnee` absent      -> page qui ne decrit pas une donnee : build.
//   `{ le: '2026-08-13' }`        -> la date de SA donnee.
//   `{ le: null }`                -> ⭐⭐ elle DIT qu'elle ne sait pas. Le
//     silence est indiscernable d'une donnee fraiche : ne rien afficher aurait
//     ete la meme faute, en plus discrete.
//
// ⚠️ `T12:00:00Z` ET NON LA DATE NUE. `new Date('2026-08-13')` est minuit UTC :
// dans un fuseau en retard, `toLocaleDateString` rend la VEILLE. Un decalage
// d'un jour sur une date de fraicheur est exactement le genre de faux que
// personne ne remarque et que tout le monde croit.
const dateJour = (iso) => new Date(`${iso}T12:00:00Z`).toLocaleDateString(dateLocale[lang] || 'en-GB');
const decritDonnee = fraicheurDonnee !== null && fraicheurDonnee !== undefined;
const releveLe = decritDonnee && fraicheurDonnee.le ? dateJour(fraicheurDonnee.le) : null;
// ⛔ `fresh` NE PEUT PLUS ATTEINDRE UNE PAGE QUI DECRIT UNE DONNEE. C'est le
// mutant M2 : le remettre inconditionnel doit faire rougir le banc.
const fresh = (!decritDonnee && updatedAt)
  ? new Date(updatedAt).toLocaleDateString(dateLocale[lang] || 'en-GB') : null;
// ⭐ LA PROVENANCE N'EST PAS CALCULEE ICI, ELLE EST PORTEE PAR LA LIGNE ELLE-MEME
// (`data-fraicheur`, plus bas). Une variable de plus aurait ete un second
// endroit ou dire la meme chose, et deux verites divergent toujours.
// ⛔ Et pas de marqueur au niveau de <html> : ce serait 18 octets SERVIS sur
// 3 097 pages pour repeter ce que le pied dit deja.
const analytics = m.analytics || {};
// ═══ LE FOURNISSEUR DE MESURE — audit d'hygiene du 03/08/2026 ═══
// ⚠️ `analytics.provider` etait DECLARE dans le manifeste et LU NULLE PART : le
// chemin du script etait ecrit en dur. Ecrire `provider: plausible` n'aurait
// rien change, et rien ne l'aurait dit.
// ⭐⭐ C'est le defaut de famille de ce projet en miniature — un reglage pose a
// un endroit, qu'on croit applique. Deux issues : le lire, ou le supprimer. On
// le LIT : le reseau vise 15 sites, et le jour ou l'un d'eux mesure ailleurs,
// la parade doit deja etre en place.
// ⛔ Une liste FERMEE, et un refus bruyant sur un nom inconnu. Un repli
//    silencieux vers umami servirait le script d'un tiers depuis notre domaine
//    — c'est une faute de confidentialite, pas une faute de configuration.
const MESUREURS = {
  umami: '/stats/script.js',           // auto-heberge sur Coolify, meme domaine
  plausible: '/stats/script.js',       // meme chemin : le proxy est cote nginx
};
const fournisseur = String(analytics.provider || 'umami').trim().toLowerCase();
if (analytics.website_id && !MESUREURS[fournisseur]) {
  throw new Error(`[analytics] provider inconnu : « ${fournisseur} » `
    + `(connus : ${Object.keys(MESUREURS).join(', ')}). Un provider mal orthographie `
    + `ne doit pas retomber en silence sur un autre mesureur.`);
}
const statsSrc = MESUREURS[fournisseur];
const statsOn = Boolean(analytics.website_id) && Boolean(statsSrc);
// ⛔⛔ OÙ VIT LE SÉLECTEUR DE LANGUE — UNE DONNÉE, PAS DU CODE (31/07/2026).
// La maquette porte ce commentaire depuis des semaines : « LE SÉLECTEUR DE
// LANGUE A QUITTÉ L'EN-TÊTE (demande de Preda) […] ils vivent maintenant dans
// le pied de page […] et le réglage persistant est dans les paramètres du
// compte. » Le moteur ne l'avait jamais appliqué — l'en-tête de veveprice
// affichait encore EN/FR/ES/DE à côté de la recherche.
// ⛔ ON NE LE DÉPLACE PAS EN DUR : `encyclopedie` STYLE `.langbar` dans son
// en-tête (8 règles). Un déplacement écrit dans le gabarit casserait vevewiki
// sans un mot. Le site choisit, par `identity.langues_dans` :
//     absent | "entete"  -> comportement actuel (vevewiki : rien ne bouge)
//     "pied"             -> les liens descendent dans le pied de page
// ⭐⭐ LES LIENS RESTENT DANS LE DOM DANS LES DEUX CAS. C'est par eux que
// Google découvre les versions traduites : les retirer ferait disparaître le
// multilingue des résultats — un dégât invisible pendant des mois. Ils
// changent de PLACE, jamais d'EXISTENCE. (Les `<link rel="alternate">` du
// <head>, eux, ne bougent pas du tout.)
const langueOu = m.identity.langues_dans || 'entete';
const langAuPied = langueOu === 'pied';
const langAuCompte = langueOu === 'compte';
// 🎨 Même dispositif pour la bascule jour/nuit (demande de Preda, 06/08/2026).
// ⚠️ Ne décide QUE de la place de la COMMANDE. Le script du <head> qui restaure
// le choix reste posé quoi qu'il arrive : déplacer un bouton ne doit pas
// rhabiller en clair quelqu'un qui lisait en nuit depuis trois semaines.
const themeAuCompte = (m.identity.theme_dans || 'entete') === 'compte';

// ═══════════════════════════════════════════════════════════════════════════
// 🌍🔴🔴 LOT 139 — LE SÉLECTEUR DE **LANGUE D'INTERFACE**, SUR LES PAGES
// PUBLIQUES. ⛔ CE N'EST PAS `langueOu` CI-DESSUS, ET IL NE FAUT PAS LES
// CONFONDRE — ILS RÉPONDENT À DEUX QUESTIONS DIFFÉRENTES.
// ═══════════════════════════════════════════════════════════════════════════
//   · `langueOu`  → où vont les liens vers les autres ADRESSES (`alternates`).
//                   veveprice : `active: [en]` ⇒ **une seule adresse**.
//   · ici         → où le visiteur choisit la langue des LIBELLÉS.
//                   veveprice : `interface: [en, fr, es, de]` ⇒ **quatre**.
//
// 🔴 CE QUI A ÉTÉ MESURÉ LE 11/08 AVANT D'ÉCRIRE UNE LIGNE, sur les 147 pages
// construites : **0 `.langbar`**, **0 `.f-langues`**, **0 `hreflang` dans le
// corps**. Le seul code du dépôt qui pose le cookie `vp_langue` vit sur
// `/compte/`, `/connexion/` et `/inscription/` — et `/compte/` redirige un
// anonyme vers `/connexion/`. ⇒ **quatre langues traduites, aucune porte
// publique pour en choisir une.** Un circuit ouvert, ouvert depuis le lot 120.
// ⛔ La notice du lot proposait de basculer `langues_dans` sur un axe
// public/privé : ça n'aurait affiché **rien du tout** — un « sélecteur » à un
// seul choix, « EN ». *Une demande peut être claire et porter sur un mécanisme
// incapable de la satisfaire ; c'est la mesure qui le dit, pas la relecture.*
//
// ⭐⭐⭐ « PUBLIQUE » N'EST PAS UNE LISTE DE CHEMINS, C'EST LE MODE DE RENDU.
// Preda a tranché : rien sur `/compte/`, `/market/`, `/favoris/`,
// `/dashboard/`. Ces quatre routes-là sont EXACTEMENT celles que
// `astro_routes_compte.mjs` bascule en rendu à la demande — recopier leurs
// chemins ici serait une QUATRIÈME liste à tenir à jour (le moteur, nginx, le
// banc, et moi), et la cinquième page réservée passerait par le trou comme les
// trois lots qui ont ajouté un préfixe à la main pour P42.
// ⇒ **un invariant, pas une seconde liste** : une page rendue à la demande est
// une page qui a un visiteur ; une page pré-générée est un fichier public.
// ⚠️ `/connexion/` et `/inscription/` sont à la demande ET publiques — et
// c'est le bon résultat : elles portent DÉJÀ leur propre sélecteur `?lang=`.
// L'invariant leur évite d'en avoir deux.
//
// ⛔⛔ COMPARAISON POSITIVE, ET L'ABSENCE EST NOMMÉE. `locals.rendu` vaut
// `undefined` sur les ~8 500 pages pré-générées (le middleware sort avant de
// le poser, cf. `isPrerendered`). Écrire `!== 'demande'` ferait retomber dans
// « publique » tout mode de rendu futur que personne n'aurait examiné. On
// nomme l'absence, et on compare à la valeur voulue : un troisième mode
// tomberait du côté « pas de sélecteur », qui est le côté sûr.
const rendu = Astro.locals?.rendu || 'pre-genere';
const pagePreGeneree = rendu === 'pre-genere';
const languesUi = languesInterface();
// ⭐ `languesUi.length > 1` : un sélecteur à un seul choix est un bouton qui
// ment. C'est la garde qui laisse vevewiki tranquille même si quelqu'un y
// posait la clé un jour.
const selecteurLangueUi = langueUiDansEntete() && pagePreGeneree && languesUi.length > 1;
// ⭐ QUI REGARDE, ET NON QUE PEUT-IL VOIR. Les 8 500 pages pré-générées n'ont
// pas de visiteur : `connecte()` y rend faux, donc elles portent l'appel à
// l'inscription. C'est exactement ce qu'on veut d'une page servie à un anonyme.
const aUneSession = connecte(Astro.locals);
const comptesOuverts = acces().tiers.length > 1;
const suggestData = alternates.filter((a) => a.lang !== lang).map((a) => ({ l: a.lang, h: a.href, n: localeNames[a.lang] || a.lang }));

// ⭐ Le menu, lu UNE fois. Une entree non prete est ECARTEE et DITE : un menu
// qui rétrécit sans le dire se lit comme une régression.
const navManifeste = (manifest().nav || []).filter((e) => e && e.pret);
const navAttente = (manifest().nav || []).filter((e) => e && !e.pret);
if (navAttente.length && !globalThis.__navDit) {
  globalThis.__navDit = true;
  console.log(`[nav] ${navManifeste.length} entree(s) emise(s) · ${navAttente.length} en attente de page : `
    + navAttente.map((e) => e.href).join(', '));
}

// ═══════════════════════════════════════════════════════════════════════════
// 🔴🔴 LOT 68 — LE MENU DISPARAISSAIT ENTRE 641 px ET 1040 px
// ═══════════════════════════════════════════════════════════════════════════
// Mesuré dans `themes/vitrine/theme.css` :
//   @media (max-width:1040px){ .nav__liens{display:none} }   ← le menu s'en va
//   @media (max-width:640px) { .onglets{display:grid}    }   ← la barre arrive
// ⚠️ LOT 139 — LA SECONDE RÈGLE N'EXISTE PLUS : la barre du bas a été retirée
// et le bouton du tiroir bascule au MÊME pixel que la nav (1040 px). Le trou
// décrit ici est fermé par un SEUIL COMMUN, plus par un second dispositif.
// Entre les deux, sur 400 px de largeur d'écran — c'est-à-dire une tablette,
// une fenêtre à moitié réduite, un portable en 1366 avec le zoom à 125 % — le
// site n'avait AUCUNE navigation. Ni erreur, ni page cassée : deux règles
// justes, écrites à des moments différents, qui ne se recouvrent pas.
// ⭐⭐ UN INTERVALLE N'EST À PERSONNE. Chacune des deux règles est correcte
// prise seule ; le défaut n'existe que dans l'espace entre elles, et aucun banc
// ne teste un espace. C'est la même famille que « est-ce là ? » contre « est-ce
// ce qui gagne ? », en version géométrie.
//
// ⭐ LA PARADE EST UN MENU QUI NE DÉPEND D'AUCUN INTERVALLE : un dépliant
// affiché DÈS que `.nav__liens` se cache (même seuil, 1040 px, écrit une seule
// fois dans le thème). Il porte la liste ENTIÈRE, pas les 3 premières entrées
// comme la barre du bas — donc plus aucune largeur d'écran ne perd un lien.
// ⛔ Il réemploie `.deplie` / `.deplie__b` / `.deplie__m`, le vocabulaire que le
//    thème habille DÉJÀ (l. 439-451). Aucune classe neuve, donc aucune classe
//    qui pourrait se retrouver sans règle chez aurora ou encyclopedie.
const menuComplet = wikiNav
  ? wikiNav.map((sx) => ({ href: localize(lang, sx.path), label: sx.title }))
  : navManifeste
      .filter((e) => e.cle !== 'nav.blog' || blogDansCetteLangue)
      // 🔴 LOT 123 — `membre` ÉTAIT PERDU ICI. Ce `.map()` ne recopiait que
      //    `href` et `label` : le tiroir affichait donc `/market/` et
      //    `/favoris/` À TOUT LE MONDE, alors que la nav principale (l. ~644)
      //    les masque. ⭐⭐ Deux rendus de la MÊME liste, deux comportements —
      //    et le tiroir est justement le seul chemin vers le menu sous
      //    1040 px, c'est-à-dire sur téléphone.
      //    ⛔ Ce n'est pas une fuite (ces pages redirigent qui n'a pas de
      //    session), c'est une PROMESSE : on proposait une porte fermée.
      .map((e) => ({ href: e.href === '/' ? localize(lang, '/') : localize(lang, e.href),
                     label: t(lang, e.cle), membre: e.membre }))
      // 🔴 `aUneSession` ET NON `tiers.length > 1` (06/08/2026, demande de Preda).
      // La condition disait « ce site A des comptes », pas « cette personne EN a
      // un ». Elle affichait donc « Mon compte » à des visiteurs qui n'en ont
      // aucun. ⭐⭐ CE QUE LE SITE PROPOSE ET CE QUE LA PERSONNE POSSÈDE SONT
      // DEUX QUESTIONS — la même confusion que palier/session, un cran plus haut.
      // 🔴🔴🔴 LOT 123 — `aUneSession` A ÉTÉ RETIRÉ D'ICI, ET LE DÉFAUT ÉTAIT
      // PLUS SUBTIL QU'UN LIEN EN TROP.
      // Preda, 10/08 : « je vois "my account" dans le menu sur certaines pages
      // alors qu'il ne devrait pas y être ». Mesuré : `aUneSession` n'est
      // connu QUE sur les routes rendues à la demande — /market/, /favoris/,
      // /compte/, /connexion/, /inscription/. Sur les ~3 000 pages
      // PRÉ-GÉNÉRÉES il vaut toujours faux, parce qu'une page pré-générée n'a
      // pas de visiteur.
      // ⇒ LE MENU N'ÉTAIT PAS LE MÊME D'UNE PAGE À L'AUTRE, pour la même
      //   personne, dans la même session. C'est ça qu'il a vu, et c'est plus
      //   dérangeant qu'un lien de trop : un menu qui change tout seul donne
      //   l'impression d'avoir été déconnecté.
      // ⭐⭐⭐ LA CORRECTION N'EST PAS DE LE RETIRER, C'EST DE LE RENDRE
      //   TOUJOURS, `hidden`, ET DE LAISSER LE COOKIE D'AFFICHAGE DÉCIDER —
      //   exactement comme les liens `membre: true` du manifeste, dont la
      //   règle CSS `html[data-membre] a[data-membre][hidden]` existe déjà.
      //   Le HTML redevient identique partout, donc cachable, donc cohérent.
      // ⛔ CE N'EST PAS UNE DÉCISION DE DROIT : ce lien mène à une page qui
      //   redirige elle-même qui n'a pas de session. Le cookie ne choisit
      //   qu'un LIBELLÉ, ce qu'il est fait pour faire.
      ;
// 🔴🔴 LOT 132 — « MON COMPTE » QUITTE LE MENU. Preda, 10/08 : « il y a
// toujours un lien MonCompte dans le menu alors qu'il existe pourtant l'avatar
// pour y accéder ».
// ⭐⭐⭐ AVANT DE RETIRER, ON COMPTE LES CHEMINS — c'est la règle qui manquait au
// lot 119 (`/favoris/` retirée de nginx : 404 sur build vert). Mesuré le 10/08,
// `/compte/` est atteignable par TROIS routes indépendantes :
//   ① la nav de l'en-tête + le tiroir (cette ligne) ;
//   ② l'avatar `<details class="globe">` — présent à TOUTES les largeurs (seul
//      son libellé disparaît sous 640 px, thème l. 1215), et il porte déjà le
//      lien plus la déconnexion ;
//   ③ ~~la barre `.onglets`, sous 640 px~~ — 🔴 RETIRÉE AU LOT 139.
// ⚠️ CE COMPTAGE A DONC CHANGÉ, ET C'EST LE PIÈGE DE CE GENRE DE NOTE : le
// lot 132 a retiré `/compte/` du tiroir EN S'APPUYANT sur ③, et le lot 139 a
// retiré ③ en s'appuyant sur ②. Il ne reste qu'UNE porte visible — l'avatar —
// plus la section « Réglages » du tableau de bord.
// ⇒ `test:affichage` §3 quater MESURE désormais ce comptage à chaque passage :
// il compte les liens vers `/compte/` dans la page SERVIE et vérifie que leur
// contenant n'est masqué à AUCUNE des 30 largeurs balayées. ⛔ Si l'avatar avait
// été la SEULE autre porte et qu'il eût disparu sous un seuil, ce retrait aurait
// fabriqué un espace membre sans sortie — « une protection qui bloque tout le
// monde est cassée », dans sa version navigation.
// ⭐ Et le lot 123 reste honoré : le HTML de cette nav est désormais IDENTIQUE
// partout, puisqu'il n'y a plus une seule entrée qui dépende de qui regarde.
// C'était déjà le cas depuis le 123 (`membre: true` + cookie d'affichage) ; ici
// on supprime carrément la question au lieu de la répondre.
// ⚠️ La clé `account.title` RESTE dans les cinq dictionnaires : l'avatar, la
// barre mobile et le tableau de bord la lisent tous les trois. `test:cles` ne le
// dirait qu'après un build — c'est la panne du lot 34.
---
<!doctype html>
{/* ⭐ `data-nf` — LOT 101. Le script des cotes met en forme des nombres et
     doit donc connaitre la locale. ⛔ Il ne peut PAS la deduire de
     `<html lang>` : le site sert `en`, `fr`, `es`, `de` alors que les
     formats attendus sont `en-GB`, `fr-FR`… — c'est `numberLocale` qui
     fait la correspondance, cote serveur, et lui seul. Un `toLocaleString`
     nourri d'un code de langue nu ne plante pas : il rend un format
     plausible et faux, ce qui est exactement le genre de defaut qu'on ne
     voit jamais depuis la langue par defaut.
     ═══════════════════════════════════════════════════════════════════════
     🔴🔴 LOT 141 — CE COMMENTAIRE ETAIT UN `<!-- -->`, DONC IL ETAIT *SERVI*.
     ═══════════════════════════════════════════════════════════════════════
