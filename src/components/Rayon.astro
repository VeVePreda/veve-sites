---
// ⚠️ VeVePreda/veve-sites — src/components/Rayon.astro   (FICHIER NEUF — lot 113)
//
// ═══════════════════════════════════════════════════════════════════════════
//  UN RAYON : TOUT LE CATALOGUE, 20 PAR PAGE, CLIQUABLE QUAND IL Y A UNE FICHE
// ═══════════════════════════════════════════════════════════════════════════
//  Arbitrage Preda du 10/08 : « lister tout le catalogue et mettre dans les
//  fiches ce que tu as ». Mesuré : le site publie 1 200 fiches sur 19 412 (6 %)
//  — un item sous 8 relevés de PRIX n'a pas de page, et le deep scan de la
//  chaîne n'y changera rien (il collecte des transferts, pas des prix).
//  ⭐⭐⭐ UNE LIGNE DE LISTE N'A PAS BESOIN D'UNE PAGE. C'est ce qui permet de
//  tout montrer sans fabriquer 137 000 pages vides que Google pénaliserait.
//
//  🔴🔴 CE COMPOSANT NE REÇOIT QUE `ds.rayon`, JAMAIS UNE LIGNE DE CATALOGUE.
//  `catalogue.csv` porte `floor`, `listings`, `ath`, `atl` : lui passer une
//  ligne brute publierait 19 412 prix, par un chemin que `projeter()` ne voit
//  pas (il mute `items`, pas `cat`). `dataset.mjs` en fait une liste BLANCHE.
//  ⛔ Ne jamais « enrichir » une ligne ici avec un champ pris ailleurs.
import Base from '../layouts/Base.astro';
import AVenir from './AVenir.astro';
import BandeauOutil from './BandeauOutil.astro';
import { dataset } from '../../engine/lib/dataset.mjs';
import { t, localize, numberLocale } from '../../engine/lib/i18n.mjs';
import { rar, mentionEdition } from '../../engine/lib/vitrine.mjs';
// 🔴 LOT 139 — LA VIGNETTE UNIQUE. Les extrêmes et les budgets de coupe sont
//   déclarés une fois, ailleurs, et lus ici comme par les deux autres
//   gabarits. ⛔ On ne recopie PAS le bandeau de `Carte.astro` : ce serait la
//   quatrième occurrence de « deux gabarits qui rendent la même liste ».
import Extremes from './Extremes.astro';
import { nomItem, nomSerie, nomSet } from '../../engine/lib/vignette.mjs';
// 🖼️ LOT E — LA VUE TUILES. ⭐ `imageCarte()` EST LE POINT UNIQUE, et c'est LA
//   MÊME fonction que `rayon_index.mjs` appelle pour déposer l'adresse que le
//   pilote peindra. ⛔ Poser `l.image` brute ici servirait 2 000 px dans une
//   case de 178, et surtout : `test:series` §2 compare les deux fabriques
//   adresse par adresse — il rougirait au premier build, et il aurait raison.
import { imageCarte, ONERROR_REPLI } from '../../engine/lib/image_cdn.mjs';
// 🔴🔴🔴 IMPORTÉ SOUS UN AUTRE NOM, ET CE N'EST PAS UN CAPRICE DE STYLE.
//   Ce fichier déclare DÉJÀ `const forme = moduleJs('rail')` quarante lignes
//   plus haut. Un `import { forme }` par-dessus, et c'est le module du rail qui
//   part dans `set:html` : « forme is not a function », au RENDU.
//   ⭐⭐ C'EST LA DEUXIÈME FOIS EN DEUX PASSES — `Market.astro` a payé la même
//   collision ce matin, sur le même nom, et là le build est resté VERT parce
//   que `/market/` n'est pas pré-rendue. Ici il a rougi tout de suite.
//   *Un nom court pris deux fois dans un même fichier ne se voit qu'au rendu ;
//   le vérifier est plus court que le reproduire.*
import { forme as formeRarete } from '../../engine/lib/vitrine.mjs';
// 🔎 LOT 155 — LA BARRE DE FILTRES UNIQUE ET SON PILOTE.
// ⭐ Le composant et le module sont écrits UNE FOIS et servent les trois rayons :
//   voir l'en-tête de `BarreRayon.astro` et de `engine/lib/rayon_index.mjs`.
// ⛔ Le pilote est un module de COMPOSANT, pas un morceau du socle : 12 946 pages
//   sur 12 946 n'ont pas de barre de rayon sauf ces 839-là. Le verser au socle
//   commun déplacerait le gaspillage au lieu de le supprimer — c'est l'arbitrage
//   du cadran, lot 137.
import BarreRayon from './BarreRayon.astro';
import Cote from './Cote.astro';
import { moduleJs } from '../../engine/lib/socle_js.mjs';
import { coteFermee } from '../../engine/lib/cote.mjs';
const pilote = moduleJs('rayon');
// 🔴 LOT 155-B — LE CHARGEUR D'INDEX EST UN SECOND MODULE, ET IL PART D'ABORD.
// `series.js` lit le même `/rayon-index/*.json` depuis ce lot : le `fetch`, la
// lecture de `cols` et la convention des dictionnaires vivent désormais dans un
// seul fichier (`index_rayon.js`), que les deux pilotes appellent.
// ⭐ L'ORDRE EST GARANTI PAR `defer`, PAS PAR LA CHANCE : deux scripts `defer`
// s'exécutent dans l'ordre du document. C'est exactement la garantie qui manquait
// au lot 139, quand un `is:inline` lisait un bouton pas encore analysé.
const chargeur = moduleJs('index_rayon');
// 🆕 LOT D — LA FORME DE LA BARRE (rail en PC, feuille en mobile). ⭐ C'est un
// module de COMPOSANT comme les deux autres, et pour la même raison : 12 946
// pages n'ont pas de barre de filtres, et le verser au socle commun
// déplacerait le gaspillage au lieu de le supprimer (arbitrage du lot 137).
// ⛔ Il est chargé MÊME quand la barre est absente ? Non — voir le point
// d'appel : il suit `filtrable`, exactement comme le pilote.
const forme = moduleJs('rail');
// ⭐⭐ LA BARRE NE SORT QUE LÀ OÙ UNE COTE EXISTE, ET LA CONDITION EST IMPORTÉE,
//   PAS RÉÉCRITE. `coteFermee()` est ce que `Extremes.astro` interroge pour
//   décider d'émettre un badge ; l'écrire ici en `manifest().features…` donnerait
//   deux définitions d'un seul état, et le jour où elles divergent vevewiki sert
//   une barre de filtres pour un catalogue qu'il n'a pas. *Un prédicat recopié
//   est un prédicat qui divergera.*
const filtrable = coteFermee();

const { lang, rayon, page = 1 } = Astro.props;
export const PAR_PAGE = 20;

const ds = await dataset();
const nf = numberLocale[lang] || 'en-GB';

// ⭐ `sets` n'est pas un rayon du catalogue : c'est le regroupement par série.
//    Il partage la MISE EN PAGE, pas la source — d'où la branche ici plutôt
//    qu'un troisième composant qui divergerait au premier changement.
const lignes = rayon === 'sets'
  ? [...ds.collections.values()]
      .sort((a, b) => b.items.length - a.items.length)
      // ⚠️ `uuid: null` EXPLICITE, ET CE N'EST PAS UN OUBLI : un regroupement
      //    par série n'a pas d'uuid de pièce, donc pas d'extrêmes — même
      //    décision que sur `CarteSet` (Preda, 11/08). Le nommer à `null`
      //    plutôt que l'omettre fait que `<Extremes>` reçoit une absence
      //    DÉCLARÉE au lieu d'un `undefined` qu'on lirait comme un bug.
      .map((c) => ({ uuid: null, nom: c.name, budget: 'set',
                     sous: `${c.items.length} ${t(lang, 'collections.items')}`,
                     path: `/collection/${c.slug}/`, rarity: '', tirage: null, serie: '' }))
  : ds.rayon
      .filter((r) => r.type === (rayon === 'comics' ? 'comic' : 'collectible'))
      // 🔴🔴 CE QUI A UNE FICHE PASSE DEVANT — trouvé en MESURANT la page produite.
      //    Trié alphabétiquement, `/comics/` page 1 sortait 20 lignes muettes
      //    sur 20 : seuls 2,4 % des comics ont une fiche (400 sur 16 682), donc
      //    vingt lignes tirées au hasard n'en contiennent presque jamais une.
      //    ⭐⭐⭐ LE BUILD ÉTAIT VERT, LE BANC ANTI-FUITE AUSSI, ET LA PAGE
      //    D'ACCUEIL DU RAYON NE MENAIT NULLE PART. Aucun contrôle ne regarde
      //    « est-ce que la première page SERT à quelque chose » — il a fallu
      //    ouvrir le fichier produit.
      //    ⇒ Les pièces cliquables d'abord, la longue traîne ensuite. Le
      //    catalogue reste entier, l'ordre cesse d'être hostile.
      .sort((a, b) => (a.path ? 0 : 1) - (b.path ? 0 : 1)
        || (a.series || '').localeCompare(b.series || '') || a.name.localeCompare(b.name))
      // 🔴 LOT 118 — `sous` porte la MENTION d'édition, pas le numéro : voir
      //    `mentionEdition()` dans engine/lib/vitrine.mjs.
      // 🔴🔴 `uuid` ENTRE ICI, ET RIEN D'AUTRE. Il est déjà dans la liste
      //    blanche de `rayonDe()` — ⛔ on n'ajoute AUCUN champ de prix pour
      //    faire marcher les extrêmes : c'est `<Cote>` qui les cherchera, à
      //    la demande, derrière la porte. `test:rayon` §① tient la liste des
      //    champs interdits et il rougirait avant le déploiement.
      // 🖼️ LOT E — `image` ENTRE ICI, ET ELLE ÉTAIT DÉJÀ DANS LA LISTE
      //    BLANCHE de `rayonDe()` depuis le lot 118. ⛔ Vérifié avant de
      //    l'ajouter, comme `licensor` au 155 : `image` ne fait pas partie des
      //    `INTERDITS` de `test:rayon` §① — ce n'est pas un prix, et ça ne le
      //    devient pas. Le geste est de VÉRIFIER, pas de se le rappeler.
      .map((r) => ({ uuid: r.uuid, nom: r.name, budget: 'item',
                     sous: mentionEdition(r.edition_type), path: r.path,
                     rarity: r.rarity, tirage: r.tirage, serie: r.series,
                     image: r.image }));

const total = lignes.length;
const pages = Math.max(1, Math.ceil(total / PAR_PAGE));
const n = Math.min(Math.max(1, Number(page) || 1), pages);
const tranche = lignes.slice((n - 1) * PAR_PAGE, n * PAR_PAGE);
const cliquables = lignes.filter((l) => l.path).length;

// 🎨🔴🔴 LOT E — LA VUE TUILES, TRANCHÉE PAR PREDA LE 05/09 PUIS RECONFIRMÉE LE
//   06/09 (« tuiles partout ») : *on parcourt un rayon, on compare un marché.*
//   ⭐⭐ C'EST UNE CLASSE, PAS UN SECOND GABARIT. Le DOM émis est le MÊME dans
//   les deux vues — même `<li>`, même `.rayon__c`, même `.rayon__b` — et c'est
//   `.rayon--tui` qui le relit en grille. Deux arbres de DOM selon un booléen,
//   c'est deux mises en page à tenir, et celle qu'on ne voit jamais est celle
//   qui casse : la leçon de `.hero-ap`/`.hero-pc`, *deux VUES, pas deux
//   composants*, et celle de l'enveloppe du rail vingt lignes plus bas.
//   ⛔ `sets` GARDE SA LISTE : le brief ne lui demande pas de tuiles (il a ses
//   cartes sur `/collections/`), et surtout sa source n'a pas d'image — un
//   regroupement par série n'a pas de couverture, c'est `pileSet()` qui en
//   choisit trois. Ce n'est pas une vue qu'on lui refuse, c'est une donnée
//   qu'il n'a pas.
const tuiles = rayon !== 'sets';

// 📐🔴🔴 CE QUE LA TUILE DE RAYON NE COPIE **PAS** DE LA MAQUETTE — ARBITRAGE
//    DE PREDA DU 06/09, PRIS APRÈS COMPARAISON FICHIER CONTRE FICHIER.
//    ⛔⛔ NE PAS « CORRIGER » CES QUATRE ÉCARTS : ils sont VOULUS. La prochaine
//    lecture de `maquette-design-v4-05-09.html` les reverra, et sans ce bloc
//    elle les prendra pour des défauts — c'est déjà arrivé trois fois dans ce
//    dépôt. *Un écart à la maquette qui n'est pas écrit redevient un bug.*
//
//    ① LA RARETÉ reste dans la cartouche, en flux. La maquette la pose en
//      pastille `tuile__hd > tuile__rar` sur l'image (haut-gauche).
//    ② LES EXTRÊMES ATL/ATH restent dans la cartouche. La maquette en fait le
//      bandeau `socle__ext`, en bas de l'image.
//    ③ LA SÉRIE et ④ LA MENTION D'ÉDITION (FA/FE/CE) et le TIRAGE sont
//      SERVIS ; la tuile de la maquette n'affiche que nom, rareté et prix.
//
//    🗣️ Preda, 06/09 : « garder ce que je sers » et « garder les trois ». La
//    raison est celle du rayon lui-même : ce sont les axes par lesquels un
//    collectionneur reconnaît une pièce, ils sont déjà servis en vue liste, et
//    les retirer de la page principale du rayon serait une perte d'information.
//    ⭐ CE QUI EST REPRIS DE LA MAQUETTE, EN REVANCHE, EST MESURÉ ET TENU :
//    la grille (2 colonnes / gap 9px sous 520 px, 6 en PC — `test:rayon` § ⑨),
//    le socle 4/5 avec fond flouté, voile et image nette, le titre sur deux
//    lignes à hauteur fixe (2,56em), et le losange pour une pièce sans visuel.

const racine = `/${rayon}/`;
const url = (p) => (p <= 1 ? racine : `${racine}page/${p}/`);

// ⭐⭐ LE FIL DE PAGINATION RESTE COURT : 1 · … · n-1 · n · n+1 · … · N.
//    835 pages de comics ne se listent pas ; personne ne clique « page 400 »,
//    mais tout le monde veut la première et la dernière.
const fenetre = [...new Set([1, n - 1, n, n + 1, pages].filter((p) => p >= 1 && p <= pages))]
  .sort((a, b) => a - b);

// 🔒 LE CADENAS DU LOT 155 — ⭐ IL VOYAGE PAR UN ATTRIBUT, IL N'EST PAS RECOPIÉ
//   DANS LE PILOTE. `rayon.js` doit rendre le MÊME `<span class="cote">` que
//   `Cote.astro`, cadenas compris. Écrire le SVG en dur dans le module en ferait
//   une seconde source : le jour où le glyphe change, une liste filtrée
//   dessinerait l'ancien, et personne ne verrait les deux côte à côte.
//   ⚠️ Le `title` PART AUSSI PAR ATTRIBUT, donc traduit par `t()` : un libellé
//   écrit dans un `.js` du socle serait servi en anglais aux cinq langues, et
//   `test:cles` ne le verrait pas — il lit les appels à `t()`.
const cadenasSvg = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"'
  + ' stroke-linecap="round"><rect x="5" y="11" width="14" height="9" rx="1.8"/>'
  + '<path d="M8.2 11V8.6a3.8 3.8 0 0 1 7.6 0V11"/></svg>';
---
{/* 🔴 `noindex` DÈS LA PAGE 2, et ce n'est pas de la prudence : 835 pages de
    liste quasi identiques diluent le site entier. La page 1 porte le rayon,
    les suivantes sont un moyen de navigation. `rel=prev/next` dit à Google
    qu'elles forment une suite plutôt qu'un stock de doublons.
    ⚠️ L'audit SEO nocturne les verrait sinon, et il aurait raison.
    ⛔ `rel=prev/next` N'EST PAS POSÉ : `Base.astro` n'expose aucun slot `head`,
    et un `<link>` écrit dans le corps atterrit dans le `<body>` — inerte, ou
    hissé en silence selon le moteur. On ne parie pas sur un comportement qu'on
    n'a pas mesuré. `noindex` suffit à protéger le site ; le jour où `Base`
    gagne un slot d'en-tête, ces deux lignes s'y branchent. */}
<Base sect={rayon === 'comics' ? 'comics' : rayon === 'sets' ? 'sets' : 'collectibles'}
      lang={lang} path={url(n)} updatedAt={ds.updatedAt} noindex={n > 1}
      title={`${t(lang, `rayon.${rayon}`)}${n > 1 ? ` — ${t(lang, 'rayon.page')} ${n}` : ''}`}
      description={t(lang, `rayon.${rayon}.d`, { n: total.toLocaleString(nf) })}
      crumbs={[{ name: t(lang, 'home.crumb'), url: localize(lang, '/') },
               { name: t(lang, 'collections.title'), url: localize(lang, '/collections/') },
               { name: t(lang, `rayon.${rayon}`) }]}>
  <BandeauOutil titre={t(lang, `rayon.${rayon}`)}
                compte={t(lang, 'rayon.compte', {
                  n: total.toLocaleString(nf), c: cliquables.toLocaleString(nf) })} />

  {/* ⭐⭐ ON DIT LE CHIFFRE, ET LES DEUX. « 16 682 pièces, 400 avec une fiche »
      est la seule phrase honnête : elle explique pourquoi la plupart des lignes
      ne se cliquent pas, AVANT que le visiteur ne le découvre en cliquant.
      ⛔ Ne pas écrire « 400 pièces » : ce serait faux, on en montre 16 682. */}
  <AVenir lang={lang} rayon={rayon} />

  {/* 🔎 LOT 155 — LA BARRE. ⛔ Elle est émise sur TOUTES les pages du rayon, pas
      seulement la première : un membre qui filtre depuis la page 412 doit
      obtenir le rayon entier, pas la page 412 filtrée. C'est le pilote qui
      prend la main sur la liste, et il la prend d'où qu'on vienne.
      ⭐ `data-*` porte ce que le pilote ne peut pas deviner : le pas de la
      tranche (celui du serveur), et quatre libellés traduits. */}
  {/* 🆕 LOT D — L'ENVELOPPE DU RAIL. ⭐ Elle ne fait RIEN sous 1 041 px : la
      barre y est une feuille, hors flux, et la liste occupe toute la largeur.
      Au-dessus, elle devient une grille de deux colonnes — 248 px pour le rail,
      le reste pour la liste.
      🔴 POURQUOI LA LISTE EST ENVELOPPÉE À SON TOUR (`.avec-rail__c`) : une
      grille place ses ENFANTS. Sans cette enveloppe, la liste, la pagination et
      le « voir plus » seraient trois enfants, donc trois cellules, donc trois
      lignes de grille — la pagination se retrouverait sous le rail. ⛔ Et
      `grid-column` posé sur chacun aurait marché aujourd'hui, puis cassé au
      premier élément ajouté ici sans qu'on y pense.
      ⚠️ ELLE EST ÉMISE MÊME QUAND `filtrable` EST FAUX. Un rayon sans barre
      garde la même structure, avec une colonne vide de 0 px : deux arbres de
      DOM selon un booléen, c'est deux mises en page à tenir, et celle qu'on ne
      voit jamais est celle qui casse. */}
  <div class="avec-rail">
  {filtrable && (
    <BarreRayon lang={lang} corpus={rayon} pas={PAR_PAGE} cadenas={cadenasSvg} />
  )}

  <div class="avec-rail__c">
  <ul class:list={["rayon", tuiles && "rayon--tui"]} id="r-liste">
    {tranche.map((l) => {
      // ⭐⭐⭐ LE TAG EST UNE VARIABLE ; LE CORPS S'ÉCRIT UNE FOIS.
      //    Ce fichier écrivait ses cinq `<span>` DEUX FOIS — branche `<a>`,
      //    branche `<div>` — pour une seule différence : la mention « sans
      //    fiche ». C'est la faute « deux gabarits qui rendent la même liste
      //    divergent en silence », QUATRIÈME occurrence (lots 127, 131, 132),
      //    et `AVenir.astro` la referme déjà de cette exacte façon depuis le
      //    lot 132. ⛔ Deux corps ne divergent pas le jour où on les écrit :
      //    ils divergent au lot suivant, quand on n'en modifie qu'un.
      // ⚠️ `<a>` OU `<div>`, JAMAIS un `<a>` sans `href` : un lien sans
      //    destination reste focusable et s'annonce comme un lien.
      const Boite = l.path ? 'a' : 'div';
      const nom = l.budget === 'set' ? nomSet(l.nom) : nomItem(l.nom);
      const serie = nomSerie(l.serie);
      // 🖼️ `null` QUAND IL N'Y A PAS D'IMAGE, ET LE SOCLE MONTRE ALORS SON
      //    LOSANGE. ⛔ Pas de tuile « dégradée » à cadre vide : le Marché a
      //    tranché ce point au lot 127 — une grille de rectangles gris
      //    ressemble à un site cassé, un losange ressemble à une pièce sans
      //    visuel. C'est la même forme, dessinée par la même fonction.
      const vig = tuiles && l.image ? imageCarte(l.image) : null;
      return (
      <li class="rayon__l">
        <Boite class={`rayon__c${l.path ? '' : ' rayon__c--muet'}`}
               href={l.path ? localize(lang, l.path) : undefined}>
          {/* ⛔ LE NOM ENTIER EN `title` — voir `Carte.astro` : un nom tronqué
              sans moyen de lire l'entier est une perte, pas une mise en forme.
              ⚠️ Le thème garde son `text-overflow:ellipsis` : la coupe au
              caractère ne connaît pas la largeur de la boîte. Les deux. */}
          {/* 🔴 LOT 182 — LE `title` DEVIENT INCONDITIONNEL, sur les DEUX.
              Il ne l'était que si le SERVEUR avait coupé (`nom.tronque`). Or
              `.rayon__n` et `.rayon__s` portent `text-overflow:ellipsis` : le
              CSS coupe AUSSI, à une largeur que le serveur ne connaît pas.
              ⭐⭐ *Un `title` conditionné à une troncature que le serveur ne
              peut pas mesurer est absent exactement quand il sert.* Le
              raisonnement est déjà écrit dans `CarteSet.astro`, arbitrage du
              18/08 — ce lot ne fait que l'appliquer là où il manquait.
              ⭐ Et il aligne le serveur sur le pilote : `rayon.js` pose
              désormais le même attribut sur les lignes qu'il peint. Une
              colonne, deux fabriques, UN comportement. */}
          {/* 🖼️🔴🔴 LE SOCLE — LE CONTRAT DU MARCHÉ, REPRIS TEL QUEL et intouchable
              d'après le brief : rapport 4/5, fond flouté, voile, image nette
              par-dessus. ⛔ Il n'est émis QUE si la vue est en tuiles : sur
              `sets`, la ligne n'a pas d'image et un socle vide serait un cadre
              gris de plus par ligne.
              ⭐ `data-repli` PART AVEC CHAQUE ADRESSE RÉÉCRITE : la vignette du
              CDN manque une fois sur soixante (129 sur 131, mesuré le 06/09).
              Le repli n'est pas une ceinture de confort, c'est la moitié de la
              règle — et `ONERROR_REPLI` est le gestionnaire partagé, en
              attribut parce qu'il se déclenche avant qu'aucun script ait
              tourné.
              ⛔ LE LOSANGE EST DESSINÉ EN LIGNE, PAS RÉFÉRENCÉ. Le Marché le
              tire de son sprite local ; un rayon n'en a pas, et une référence
              morte ne lève rien, ne casse rien, et ne dessine rien. */}
          {tuiles && (
          <span class:list={["socle", rayon === 'comics' && "socle--comic"]}>
            {vig ? (
              <Fragment>
                <img class="socle__fond ok" src={vig.src} alt="" aria-hidden="true"
                     width="400" height="600" loading="lazy" decoding="async"
                     data-repli={vig.repli || undefined} onerror={ONERROR_REPLI} />
                <span class="socle__voile"></span>
                <img class="socle__net ok" src={vig.src} alt={nom.complet || nom.vu}
                     width="400" height="600" loading="lazy" decoding="async"
                     data-repli={vig.repli || undefined} onerror={ONERROR_REPLI} />
              </Fragment>
            ) : (
              <Fragment>
                <span class="socle__voile"></span>
                <span class="socle__cage" aria-hidden="true">
                  <Fragment set:html={formeRarete('ULTRA_RARE', 'xl')} />
                </span>
              </Fragment>
            )}
          </span>
          )}

          {/* ⭐⭐ LE CORPS DE LA LIGNE — ÉMIS DANS LES DEUX VUES, ET C'EST LE
              POINT. En liste il est en `display:contents` : ses enfants
              redeviennent les cellules de la grille de `.rayon__c`, et le
              tableau est exactement celui d'avant ce lot. En tuiles il devient
              la cartouche sous le socle. *Un seul arbre de DOM, deux vues* —
              donc une seule forme à tenir, et le pilote n'a qu'un gabarit à
              reproduire. */}
          <span class="rayon__b">
          <span class="rayon__n" title={nom.complet || undefined}>{nom.vu}</span>
          {l.serie && <span class="rayon__s" title={serie.complet || undefined}>{serie.vu}</span>}
          {l.sous && <span class="rayon__e">{l.sous}</span>}
          {l.rarity && <Fragment set:html={rar(l.rarity, { blanc: true })} />}
          {/* 🔴🔴 LES EXTRÊMES, ET SEULEMENT SI LA PIÈCE A UNE FICHE.
              Décision de Preda du 11/08, prise sur une mesure : `.reserve/cote/`
              ne contient que 1 201 cotes — celles de `ds.items`. Les 18 212
              lignes sans fiche n'en auront JAMAIS, même pour un Whale : émettre
              un cadenas dessus dirait « je ne montre pas » là où la vérité est
              « je n'ai pas ». ⭐ Et le prédicat n'est pas neuf — c'est le MÊME
              `l.path` qui décide déjà `<a>` contre `<div>` deux lignes plus
              haut. Une porte de plus aurait été une porte de plus à tenir. */}
          {/* 🔴🔴🔴 LOT 201 — LE PLANCHER SUR LA LIGNE DE RAYON (§M-209).
              Le défaut disait « les tuiles /collectibles/ et /comics/ n'ont pas
              de prix ». MESURÉ AVANT DE CORRIGER, et ce n'était pas une
              régression : ce gabarit n'a JAMAIS émis de plancher, ni ici ni
              dans son pilote. Il n'y avait rien à réparer, il y avait quelque
              chose à poser.
              ⛔ ET ON NE PEUT PAS LE POSER EN CLAIR. `rayon_index.mjs` porte
              une liste `INTERDITS` qui refuse `floor`, `listings`, `ath`,
              `atl` — ces pages sont PUBLIQUES et pré-générées, un montant
              écrit dedans partirait dans `dist/` pour tout le monde, et
              `test:fuite` ratisse précisément ça. Écrire le prix ici aurait
              rouvert le lot 101 par la porte d'à côté.
              ⭐⭐⭐ ⇒ ON POSE UN EMPLACEMENT, PAS UN MONTANT. `<Cote>` ne reçoit
              qu'un uuid : à l'instant du rendu, `l.floor` n'existe pas — il ne
              PEUT pas fuiter, ce n'est pas qu'on a pensé à le masquer.
              `CoteScript` remplit l'emplacement au chargement pour qui a le
              droit ; le visiteur voit le cadenas, le membre voit son plancher.
              Arbitrage de Preda du 25/08, sur maquette.
              ⭐ MÊME PRÉDICAT QUE LES EXTRÊMES — `l.path`, et pour la même
              raison exactement : une pièce sans fiche n'a pas de cote en
              réserve et n'en aura jamais. Un cadenas dessus dirait « je ne
              montre pas » là où la vérité est « je n'ai pas ». Une porte de
              plus aurait été une porte de plus à tenir.
              ⭐⭐⭐ ET `filtrable` (= `coteFermee()`) GARDE LA LIGNE, POUR UNE
              RAISON MESURÉE DANS CE FICHIER : c'est la MÊME condition qui
              décide d'émettre `<BarreRayon>` — donc le pilote `rayon.js`
              n'existe QUE lorsqu'elle est vraie. Sans elle, le serveur poserait
              un cadenas sur un site à cote OUVERTE, où le pilote, lui, n'aurait
              même pas été chargé : un verrou dessiné sur une porte sans mur, et
              les deux fabriques diverger dès le premier filtre.
              ⛔ On ne peut pas non plus afficher le montant en clair dans ce
              cas : `l.floor` n'existe pas — `INTERDITS` l'a refusé à l'index.
              Cote ouverte, ce rayon n'a donc RIEN à dire sur le prix, et il se
              tait. */}
          {filtrable && l.path && <Cote lang={lang} uuid={l.uuid} champ="floor" classe="rayon__p" />}
          {l.path && <Extremes lang={lang} uuid={l.uuid} nf={nf} classe="rayon__ext" />}
          {l.tirage && <span class="rayon__t">{l.tirage.toLocaleString(nf)}</span>}
          {!l.path && <span class="rayon__x">{t(lang, 'rayon.sansfiche')}</span>}
          </span>
        </Boite>
      </li>
      );
    })}
  </ul>

  {pages > 1 && (
  <nav class="pagin" id="r-pagin" aria-label={t(lang, 'rayon.page')}>
    {n > 1 && <a class="pagin__b" rel="prev" href={localize(lang, url(n - 1))}>‹</a>}
    {fenetre.map((p, k) => (<>
      {k > 0 && fenetre[k - 1] < p - 1 && <span class="pagin__e">…</span>}
      {p === n
        ? <span class="pagin__b pagin__b--ici" aria-current="page">{p}</span>
        : <a class="pagin__b" href={localize(lang, url(p))}>{p}</a>}
    </>))}
    {n < pages && <a class="pagin__b" rel="next" href={localize(lang, url(n + 1))}>›</a>}
  </nav>
  )}

  {/* ⭐ LE DÉVOILEMENT PAR TRANCHES DE LA LISTE FILTRÉE — même pas que la page
      du serveur, et `hidden` au départ : il n'a de sens qu'une fois que le
      pilote a pris la main. ⛔ Ce n'est PAS une pagination : aucune adresse
      neuve n'est créée, la page reste celle du rayon. Même politique que le
      Marché et que `/sets/`, pour la même raison — les adresses sont gelées. */}
  {filtrable && (
    <p id="r-plus-h" style="margin:var(--s5) 0 0;text-align:center">
      <button type="button" id="r-plus" class="btn btn--sm" hidden>{t(lang, 'movers.more')}</button>
      <span class="etiq" id="r-plus-cpt" style="display:block;margin-top:8px;color:var(--muted)"></span>
    </p>
  )}
  </div>
  </div>
  {/* ⚡ LE PILOTE DESCEND DANS LE SOCLE (mécanisme du lot 137), et `defer`
      attend la fin de l'analyse par construction : la position du script dans le
      document cesse d'être un pari. C'est la panne du lot 139 sur `series.js`,
      qui lisait `#s-plus` avant que l'analyseur ne l'ait atteint. */}
  {filtrable && <script defer src={chargeur.href}></script>}
  {filtrable && <script defer src={pilote.href}></script>}
  {/* ⚡ ET LA FORME APRÈS LE PILOTE : `rail.js` lit `data-retenues`, que
      `rayon.js` écrit. Les deux sont `defer`, donc exécutés dans l'ordre du
      document — mais le module n'en dépend pas : son observateur rattrape un
      attribut posé avant lui comme après lui. ⭐ *Un module qui exige un ordre
      de chargement est un module qui cassera le jour où on en insère un
      troisième.* */}
  {filtrable && <script defer src={forme.href}></script>}
</Base>
