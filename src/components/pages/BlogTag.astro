---
import Base from '../../layouts/Base.astro';
import { postsByTag } from '../../../engine/lib/blog.mjs';
import { t, localize, dateLocale } from '../../../engine/lib/i18n.mjs';
const { lang, tag, updatedAt } = Astro.props;
const posts = await postsByTag(lang, tag);
const df = dateLocale[lang] || 'en-GB';
// ⭐ Une page d'etiquette qui ne liste que 2 articles pese 64 mots : c'est de la
// NAVIGATION, pas du contenu. Indexee, elle dilue le site et fait concurrence
// aux articles eux-memes. On la garde pour le lecteur, on la retire de l'index
// tant qu'elle n'a pas de quoi exister seule — et le sitemap la suit.
const SEUIL_INDEX = 4;
const maigre = posts.length < SEUIL_INDEX;
---
<Base lang={lang} path={`/blog/tag/${tag}/`} title={`${t(lang, 'blog.tag')} : ${tag}`} description={t(lang, 'desc.blogTag', { name: tag })} updatedAt={updatedAt} noindex={maigre}
      crumbs={[{ name: t(lang, 'home.crumb'), url: localize(lang, '/') }, { name: t(lang, 'blog.title'), url: localize(lang, '/blog/') }, { name: tag }]}>
  <h1>{t(lang, 'blog.tag')} : {tag}</h1>
  <div class="grid">
    {posts.map((p) => (
      <a class="item" href={localize(lang, `/blog/${p.slug}/`)}>
        <div class="n">{p.data.title}</div>
        <div class="s">{new Date(p.data.date).toLocaleDateString(df)}</div>
      </a>
    ))}
  </div>
</Base>
