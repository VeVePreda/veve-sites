---
import Base from '../../layouts/Base.astro';
import { dataset } from '../../../engine/lib/dataset.mjs';
import { t, localize, numberLocale } from '../../../engine/lib/i18n.mjs';

const { lang } = Astro.props;
const ds = await dataset();
const nf = numberLocale[lang] || 'en-GB';
const money = (v) => (v === null || v === undefined ? '—' : v.toLocaleString(nf, { maximumFractionDigits: 2 }));
const pct = (v) => (v === null || v === undefined ? '—' : `${v > 0 ? '+' : ''}${v.toFixed(1)} %`);
---
<Base lang={lang} path="/movers/" title={t(lang, 'movers.title')} description={t(lang, 'desc.movers', { n: ds.items.length.toLocaleString(nf) })} updatedAt={ds.updatedAt}
      crumbs={[{ name: t(lang, 'home.crumb'), url: localize(lang, '/') }, { name: t(lang, 'nav.movers') }]}>
  <h1>{t(lang, 'movers.title')}</h1>
  <h2>{t(lang, 'movers.up')}</h2>
  <table>
    <thead><tr><th>{t(lang, 'movers.item')}</th><th class="hide">{t(lang, 'item.collection')}</th><th class="num">{t(lang, 'movers.floor')}</th><th class="num">{t(lang, 'movers.7d')}</th></tr></thead>
    <tbody>{ds.movers.up.map((i) => (
      <tr><td><a href={localize(lang, `/item/${i.slug}/`)}>{i.name}</a></td><td class="hide">{i.series}</td><td class="num">{money(i.floor)}</td><td class="num up">{pct(i.change7d)}</td></tr>
    ))}</tbody>
  </table>
  <h2>{t(lang, 'movers.down')}</h2>
  <table>
    <thead><tr><th>{t(lang, 'movers.item')}</th><th class="hide">{t(lang, 'item.collection')}</th><th class="num">{t(lang, 'movers.floor')}</th><th class="num">{t(lang, 'movers.7d')}</th></tr></thead>
    <tbody>{ds.movers.down.map((i) => (
      <tr><td><a href={localize(lang, `/item/${i.slug}/`)}>{i.name}</a></td><td class="hide">{i.series}</td><td class="num">{money(i.floor)}</td><td class="num down">{pct(i.change7d)}</td></tr>
    ))}</tbody>
  </table>
</Base>
