---
// ═══════════════════════════════════════════════════════════════════════════
// AIGUILLAGE DE PEAU — ajoute le 03/08/2026 (lot 37).
// ═══════════════════════════════════════════════════════════════════════════
// ⭐ UN SEUL ENDROIT DECIDE. Le moteur a deja ce motif : `src/pages/index.astro`
// choisit `Home` ou `EditorialHome` selon le manifeste. On le suit plutot que
// d'inventer un second mecanisme — deux facons de choisir un gabarit finiraient
// par diverger, comme les quatre reglages ecrases de ce projet.
//
// 🔴 QUAND `blogSkin()` VAUT `sobre` (le DEFAUT, et le cas de vevewiki), CE QUI
// SUIT EST EXACTEMENT LE FICHIER D'AVANT, a l'enveloppe `<Fragment>` pres.
// Le blog de vevewiki — 40 pages reelles — ne passe jamais par la branche
// vitrine, donc il ne peut pas bouger.
//
// ⚠️ L'ENVELOPPE N'EST PAS COSMETIQUE. Le corps commence par un COMMENTAIRE
// JSX puis par `<Base>` : deux expressions soeurs. Sans `<Fragment>`, le
// compilateur Astro rend « Expected `,` or `)` but found `Identifier` » — un
// message qui ne nomme ni le commentaire ni la cause. Mesure, pas suppose.
import BlogIndexVitrine from './BlogIndexVitrine.astro';
import { blogSkin } from '../../../engine/lib/blog.mjs';
const _peau = blogSkin();

import Base from '../../layouts/Base.astro';
import { postsFor, tagsFor, blogMeta, languesBlog } from '../../../engine/lib/blog.mjs';
import { t, localize, dateLocale } from '../../../engine/lib/i18n.mjs';
const { lang, updatedAt } = Astro.props;
const posts = await postsFor(lang);
const tags = await tagsFor(lang);
const df = dateLocale[lang] || 'en-GB';
// Le libelle reseau par defaut parle de releves de prix : un wiki n'en publie pas.
// -> surchargeable par site via manifest.editorial.labels.blog.{title,description}
const meta = blogMeta(lang, { title: t(lang, 'blog.title'), description: t(lang, 'desc.blogIndex') });
const languesArticles = await languesBlog();
---
{_peau === "vitrine" ? <BlogIndexVitrine {...Astro.props} /> : (
<Fragment>
<Base lang={lang} path="/blog/" title={meta.title} description={meta.description} updatedAt={updatedAt} noindex={posts.length === 0}
      langs={languesArticles}
      crumbs={[{ name: t(lang, 'home.crumb'), url: localize(lang, '/') }, { name: meta.title }]}>
  <h1>{meta.title}</h1>
  {tags.length > 0 && (
    <p>{tags.map((x) => (<a class="tag" href={localize(lang, `/blog/tag/${x.tag}/`)}>{x.tag} ({x.n})</a>))}</p>
  )}
  {posts.length === 0 && <p class="lead">{t(lang, 'blog.empty')}</p>}
  {/* ⭐ `cartes` : la MÊME classe que le bloc « articles » de l'accueil. Cette
      page gardait la grille dense des index (filets de 1 px, aucune gouttière)
      parce que le style visait un ENDROIT (`.latest-wrap .grid`) et non une
      nature de contenu. C'est pourtant ici qu'on parcourt les articles. */}
  {/* ⛔ « grid cartes » posait DEUX grilles concurrentes sur le même élément :
      `.grid` (minmax 196px) et `.cartes` (minmax clamp(240px,26vw,…)). La
      dernière déclarée gagnait, l'autre ne servait qu'à tromper le lecteur.
      ⭐ On garde `.cartes` — c'est la grille de la maquette. */}
  <div class="cartes">
    {posts.map((p) => (
      <a class="item" href={localize(lang, `/blog/${p.slug}/`)}>
        {p.data.cover && (
          <img class="cover" src={p.data.cover} alt="" loading="lazy"
               decoding="async" width="480" height="270" />
        )}
        <div class="n">{p.data.title}</div>
        <div class="s">{new Date(p.data.date).toLocaleDateString(df)}</div>
        <p class="muted" style="font-size:14px;margin:8px 0 0">{p.data.description}</p>
      </a>
    ))}
  </div>
</Base>
</Fragment>
)}
