---
import Base from '../../layouts/Base.astro';
import Gate from '../Gate.astro';
// ⭐ AJOUT SEUL (01/08/2026). Le <Gate> annonce ce qui MANQUE ; le <Cadran>
// apporte ce qui est DÛ, chargé à la demande après lecture de la session. Le
// reste du frontmatter n'est toujours pas retouché.
import Cadran from '../Cadran.astro';
import { dataset } from '../../../engine/lib/dataset.mjs';
import { priceChartSVG, courbeSVG } from '../../../engine/lib/chart.mjs';
import Cote from '../Cote.astro';
import { productLd, breadcrumbLd } from '../../../engine/lib/seo.mjs';
import { manifest, siteUrl } from '../../../engine/lib/manifest.mjs';
import { t, localize, numberLocale, dateLocale } from '../../../engine/lib/i18n.mjs';
import { postsForItem } from '../../../engine/lib/blog.mjs';
import { rar, forme, delta, gemsM, RAR, omiM, mcpPoints } from '../../../engine/lib/vitrine.mjs';
import { franchit, porte, plages } from '../../../engine/lib/access.mjs';
import { coteFermee as coteEstFermee } from '../../../engine/lib/cote.mjs';
import BarreAcces from '../BarreAcces.astro';

// ═══ LOT 104 — LES PLAGES DU GRAPHIQUE, LUES UNE FOIS ══════════════════════
// ⭐ Le manifeste décide, ce fichier rend. Une liste vide (site qui ne déclare
// aucune plage) émet zéro bouton, sans branche à écrire : la boucle ne tourne
// simplement pas.
const LES_PLAGES = plages();
// ⭐ Le NOM du palier, traduit, jamais sa clé. `porte(mo).tier` affiché brut
// donnait « crevette » en minuscules et dans aucune langue — le même défaut
// qu'un texte en dur, sauf qu'il est laid dans les cinq langues à la fois.
// ⚠️ Repli sur la clé si le manifeste ne déclare pas ce plan : c'est alors un
// vrai défaut de manifeste, pas un cas normal qu'on masquerait.
const nomDuPalier = (cle) => {
  const p = (manifest().offer?.plans || []).find((x) => x.cle === cle);
  const n = p?.nom;
  return (n && (typeof n === 'string' ? n : n[lang] || n.en)) || cle;
};
// Les cinq modules d'analyse, dans l'ordre de la maquette.
// ⛔ `MODULES` A ETE RETIRE LE 03/08/2026 (lot 43) : le bloc qui le lisait a
// disparu au lot precedent, et la constante lui a survecu. ⭐ Un fichier
// supprime se supprime DEUX FOIS — lui, et ce qui le nomme. Une variable
// morte n'est pas inoffensive : elle fait croire qu'un catalogue de modules
// vit encore ici, et le prochain lecteur ira chercher pourquoi il ne s'affiche pas.
// ⚠️ La liste EXISTE toujours, au seul endroit qui l'affiche : src/pages/compte/index.astro.
// ⭐ AJOUT SEUL. ⛔ Le reste du frontmatter n'est PAS retouché : il porte des
// correctifs coûteux (serieSlug lu et non recalculé — 35 séries divergentes,
// 52 liens cassés le 29/07 ; le titre qui garde la série au lieu de
// l'amputer ; la délégation de l'appel à l'action à <Gate>). Réécrire ce
// bloc de mémoire, c'est signer pour redécouvrir ces trois bugs.

const { lang, item, updatedAt } = Astro.props;
const m = manifest();
const root = siteUrl();
const path = item.path;
const url = `${root}${localize(lang, path)}`;
const nf = numberLocale[lang] || 'en-GB';
const df = dateLocale[lang] || 'en-GB';
// 🔴 LOT 101 — DEUX COURBES, ET LE MANIFESTE CHOISIT.
// Cote fermee : `item.courbe` est deja normalisee 0..1000 par `cote.mjs`, il
// n'existe plus un seul montant a tracer, et `courbeSVG` n'ecrit aucune
// graduation chiffree. Cote ouverte : rien ne change, ancien chemin.
// ⛔ NE PAS faire une fonction unique qui devine : un rendu qui decide seul
// s'il a le droit d'ecrire un prix est un verrou pose sur une heuristique.
const coteFermee = coteEstFermee();
const svg = coteFermee
  ? courbeSVG(item.courbe, { label: t(lang, 'chart.label') })
  : priceChartSVG(item.history, { label: t(lang, 'chart.label') });
const money = (v) => (v === null || v === undefined ? '—' : v.toLocaleString(nf, { maximumFractionDigits: 2 }));
const pct = (v) => (v === null || v === undefined ? '—' : `${v > 0 ? '+' : ''}${v.toFixed(1)} %`);
const cls = (v) => (v === null || v === undefined ? '' : v > 0 ? 'up' : v < 0 ? 'down' : '');
// ⚠️ `?? []` OBLIGATOIRE DEPUIS LE LOT 101 : `projeter()` supprime
// `item.history`, et `[...undefined]` LEVE. Ce tableau n'est plus rendu
// (retire le 03/08 a la demande de Preda) mais il reste calcule — un
// frontmatter qui plante fait echouer les 1 200 pages, pas une.
const recent = [...(item.history || [])].slice(-10).reverse();
const relatedPosts = await postsForItem(lang, item.uuid);
// L'appel a l'action (total, reste cache, lien d'offre) vit desormais dans
// <Gate> : la page ne calcule plus rien qui touche au palier.
// ⭐⭐ ADRESSE DE LA COLLECTION : ON LIT `serieSlug`, ON NE LE RECALCULE PAS.
// Corrige le 29/07/2026 — cette ligne re-slugifiait `item.series` a la main, et
// il lui manquait DEUX choses que `slugify` (engine/lib/dataset.mjs:23) fait :
//   · le `.normalize('NFD')`  -> « ROSE » devenait `ros-`, pas `rose` ;
//   · le `.slice(0, 60)`      -> l'adresse n'etait pas tronquee du meme cote.
// Mesure sur catalogue.csv.gz (5 067 series) : 35 series divergeaient —
// 20 par la TRONCATURE, 15 par les accents. D'ou 52 liens internes casses.
//
// ⛔ NE PAS ECRIRE `item.serieSlug || null`. `slugify` se termine par
// `|| 'item'` : il ne rend JAMAIS de chaine vide, donc ce repli serait mort et
// une serie vide produirait un lien vers /collection/item/ — page que
// dataset.mjs:522 (`if (!i.series) continue;`) ne construit pas. Ce serait un
// NOUVEAU lien casse. La garde porte donc sur `item.series`, comme avant.
//
// ⭐ Meme motif que le `dist` en dur du Dockerfile, corrige le meme jour : une
// valeur juste, calculee en amont, recopiee en aval sans reverification.
// 🔴 LOT 102 — ON LIT `colSlug`, POSÉ PAR LA BOUCLE QUI CRÉE LA PAGE DE SET.
// ⚠️ CE N'ÉTAIT PLUS `serieSlug`. La règle du 29/07 (« on lit, on ne
// recalcule pas ») était respectée à la lettre — et le champ lu avait changé
// de sens sous elle : depuis le lot 68, le set d'un comic est
// « <série> #<numéro> », pas la série. 81 liens en cul-de-sac, mesurés par
// l'audit SEO le 07/08, tous vers des pages jamais construites.
// ⭐ `item.series` reste la garde : un item sans série n'a pas de set.
const colSlug = item.series ? (item.colSlug || null) : null;
// Chez beaucoup de comics le nom RECOPIE la serie (« Alias #1 (2001) ») :
// repeter la serie dans le titre et le fil d'Ariane n'apprend rien.
const norm = (v) => String(v || '').toLowerCase().replace(/[^a-z0-9]+/g, '');
const jolieRareteFr = (r) => String(r).toLowerCase().split(/[_\s]+/).filter(Boolean)
  .map((w) => w[0].toUpperCase() + w.slice(1)).join(' ');
// 📕 LE TITRE AFFICHE. `item.name` porte « Retellings #1 (1982) » — le nom de
// la SERIE plus le numero. Le titre de l'oeuvre est `veve_comic_name`, collecte
// depuis toujours par veve_detail._map_comic puis jete par DROP_COLUMNS
// jusqu'au 01/08/2026.
// ⭐ REPLI SUR `name`, TOUJOURS. La colonne est vide pour les collectibles (leur
// `name` EST deja le nom de l'objet) et absente d'un catalogue anterieur au lot
// de collecte. Un titre vide serait pire que le mauvais titre.
// ⛔ ON NE TOUCHE PAS A `item.name` : il nourrit le slug, et les adresses sont
// gelees. Ceci est un champ d'AFFICHAGE.
const titreOeuvre = item.nomComic || item.name;
const serieRedondante = norm(item.series) === norm(item.name);
const crumbs = [{ name: t(lang, 'home.crumb'), url: localize(lang, '/') }];
if (colSlug) crumbs.push({ name: item.series, url: localize(lang, `/collection/${colSlug}/`) });
// Le fil d'Ariane doit refleter l'adresse : la serie est deja le maillon
// precedent, on ne la repete pas dans le dernier.
crumbs.push({ name: serieRedondante && item.rarity ? jolieRareteFr(item.rarity) : (item.nomAffiche || item.name) });
const ld = [productLd(item, url, m.site.brand), breadcrumbLd(crumbs.map((c) => ({ name: c.name, url: c.url ? root + c.url : url })))];

// Titre UNIQUE : plusieurs collectibles VeVe portent le meme nom (Batgirl, Loki,
// C-3PO...). Sans la collection, Google voit des titres identiques et n'en
// retient qu'un. On borne la longueur pour ne pas etre tronque dans les resultats.
// Budget reel : Google tronque vers 60 caracteres, gabarit de marque compris.
const budget = Math.max(24, 60 - (m.seo?.title_template || '%s').replace('%s', '').length);
const titreItem = (() => {
  if (!item.series || serieRedondante) return item.qualifie || item.name;
  const base = item.qualifie || item.name;
  const complet = `${base} — ${item.series}`;
  if (complet.length <= budget) return complet;
  // ⚠️ ANCIENNE VERSION : quand la place manquait, on SUPPRIMAIT la serie.
  // Sur les comics c'etait le pire choix possible : le titre devenait
  // « Adi Granov Main Cover · Uncommon » — le nom de la collection, c'est-a-dire
  // le terme que les gens tapent reellement, disparaissait de la balise.
  // Un titre trop long est seulement TRONQUE A L'AFFICHAGE par Google ; ses
  // mots comptent toujours pour la pertinence. Un titre ampute du nom de la
  // serie, lui, ne peut plus etre trouve. On garde donc toujours la serie, en
  // la raccourcissant au mot, avec un minimum lisible.
  // 24 : de quoi laisser passer un vrai nom de serie (« Return of the Jedi #1 »)
  // plutot qu'un moignon (« Return of the… ») qui ne se cherche pas.
  const MINI = 24;
  const place = Math.max(MINI, budget - base.length - 4);   // 3 pour " — ", 1 pour l'ellipse
  if (item.series.length <= place) return complet;
  let bout = item.series.slice(0, place);
  // Couper au dernier espace DISPONIBLE, pas seulement s'il tombe apres MINI :
  // sinon on produit « Return of the Jedi #1: P… », un mot coupe en plein
  // milieu, qui ne ressemble a rien dans une page de resultats.
  const esp = bout.lastIndexOf(' ');
  if (esp > 0) bout = bout.slice(0, esp);
  return `${base} — ${bout.replace(/[\s:,\-–—·|]+$/, '').trim()}…`;
})();
const anneeDebut = item.since ? new Date(item.since).getFullYear() : null;
const serieTxt = item.series ? ` (${item.series})` : '';
// 🔴 LOT 101 — LA DESCRIPTION NE PROMET PLUS UN PRIX QU'ELLE N'AFFICHE PLUS.
// `desc.item` porte `{price}` : la laisser aurait ecrit le plancher dans la
// balise <meta description> — c'est-a-dire dans le resultat Google, donc dans
// la seule vitrine qu'on ne peut pas rappeler. ⭐ `desc.itemShort` existe
// deja et ne cite aucun montant : on bascule dessus, on n'invente rien.
// ⚠️ La reecriture des ~25 cles par langue qui PROMETTENT un prix est le
// LOT 102 — celle-ci est traitee ici parce qu'elle FUIT une valeur, les
// autres ne font que mentir sur ce que la page montre.
const descItem = (!coteFermee && item.floor && item.totalPoints && anneeDebut)
  ? t(lang, 'desc.item', { name: item.qualifie || item.name, series: serieTxt, price: money(item.floor), n: item.totalPoints.toLocaleString(nf), year: anneeDebut, brand: m.site.brand })
  : t(lang, 'desc.itemShort', { name: item.qualifie || item.name, series: serieTxt, brand: m.site.brand });

// ⭐⭐ DEUX LIBELLÉS D'ATTENTE, ET ILS NE DISENT PAS LA MÊME CHOSE.
//   `enAttente`   : la donnée EST collectée, elle se perd entre le Sheet et le
//                   catalogue — un correctif dans `scrapeur-veve` la fera
//                   apparaître ici sans toucher à ce fichier ;
//   `pasCollecte` : personne ne la demande à aucune API — il faut d'abord
//                   décider de la cueillir.
// ⛔ Les confondre reviendrait à ranger un travail d'une heure et un chantier
//    entier sous le même tiret. C'est exactement la faute que ce site
//    s'interdit ailleurs (« aucune offre » contre « pas encore collecté »).
// 🏷️ LA MÉTHODE DE DROP, DITE DANS LA LANGUE DE LA PAGE.
// ⛔ ON NE PASSE PAS LA VALEUR DIRECTEMENT À `t()`, et c'est tout l'intérêt de
// ce garde : `t()` rend LA CLÉ BRUTE quand elle est absente du dictionnaire
// (`?? key`, engine/lib/i18n.mjs). Le jour où VeVe ajoute une cinquième
// méthode, un `t(lang, \`item.drop.\${v}\`)` nu afficherait « item.drop.LOTTERY »
// aux visiteurs — une chaîne de code sur une fiche publique.
// ⭐ Ici l'inconnu retombe sur SA PROPRE VALEUR : « LOTTERY » s'affiche, c'est
// lisible, et le mot en majuscules non traduit est lui-même le signal qu'une
// valeur neuve est apparue. Un repli qui informe vaut mieux qu'un repli muet.
const DROPS_CONNUS = new Set(['RESERVATION', 'WAITLIST', 'CRAFT', 'AUCTION']);
const dropLisible = (v) => (DROPS_CONNUS.has(v) ? t(lang, `item.drop.${v}`) : v);
const enAttente = t(lang, 'data.notCollected');
const pasCollecte = t(lang, 'data.notCollected');
const mcpJour = mcpPoints(item.rarity, item.type);
---
<Base lang={lang} path={path} sect={item.type === 'comic' ? 'comics' : 'collectibles'}
      title={titreItem} description={descItem} crumbs={crumbs} ld={ld} updatedAt={updatedAt}>
  <BarreAcces lang={lang} />

  {/* ═══ LA FICHE — structure de la maquette, à la classe près ═══
      ⭐⭐ CE BLOC N'EST PAS INSPIRÉ DE LA MAQUETTE, IL EN REPREND LES CLASSES.
      Mes versions précédentes retrouvaient l'intention et perdaient les
      valeurs : c'est ce qui produisait « ça y ressemble mais ce n'est pas ça ».
      Ici `.fiche`, `.murs`, `.jauge`, `.onglets-m` sont les noms de la maquette,
      et le CSS porté les habille sans traduction intermédiaire. */}
  <div class="fiche">
    <div class="fiche__viz">
      <div class="fiche__socle">
        <span class="socle socle--fiche">
          {item.image ? (
            <>
              {/* ⛔⛔ LA CLASSE `ok` MANQUAIT ICI — 31/07/2026. Le theme ecrit
              `.socle__net{opacity:0}` et `.socle__net.ok{opacity:1}` : sans
              `ok`, l'image EST chargee, EST dans le DOM, et reste a
              opacite 0. Preda : « l'image est presente mais je ne la vois
              pas » — c'est litteralement ce qui se passait.
              ⭐ `Carte.astro` posait bien `ok` sur ses deux <img>. Meme
              composant, deux gabarits, un seul correct : QUATRIEME fois
              aujourd'hui que « corrige a un endroit » n'est pas « corrige ».
              ⚠️ `ok` est en dur et c'est voulu : le fondu au chargement
              demanderait du JS, et une image qui depend de JS pour devenir
              visible ne s'affiche pas du tout s'il echoue. */}
            <img class="socle__fond ok" src={item.image} alt="" aria-hidden="true"
                   width="400" height="500" loading="eager" decoding="async" />
              <span class="socle__voile" aria-hidden="true"></span>
              <img class="socle__net ok" src={item.image} alt={item.name}
                   width="400" height="500" loading="eager" fetchpriority="high" decoding="async"
                   onerror="this.closest('.socle').classList.add('socle--casse')" />
            </>
          ) : (
            <>
              <span class="socle__voile" aria-hidden="true"></span>
              <span class="socle__gemme" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1">
                  <path d="M12 2.9 19.9 7.5v9L12 21.1 4.1 16.5v-9Z" />
                </svg>
              </span>
            </>
          )}
        </span>
      </div>
      {/* ═══════════════════════════════════════════════════════════════════
          LA COLONNE DE GAUCHE — LOT 73, l'ordre exact demandé par Preda
          ═══════════════════════════════════════════════════════════════════
          Trois blocs, séparés comme il les a écrits :
            ① l'identité de la pièce      : rareté, tirage
            ② les conditions du drop      : type d'édition → disponibilité
            ③ la provenance               : série / marque / licence
               (et pour un comic : le générique + le numéro)

          🔴🔴 CE QUI EST EN ATTENTE, ET POURQUOI ON LE MONTRE QUAND MÊME.
          Sur les onze lignes du bloc ②, SIX ne sont pas encore dans
          `catalogue.csv.gz`. ⭐⭐⭐ ET CINQ D'ENTRE ELLES SONT DÉJÀ COLLECTÉES :
          `veve_detail.py` demande à l'API VeVe `marketFee`, `dailyMcpPoints`,
          `dropMethod`, `firstAvailableEdition` et `series{ season }` depuis
          toujours. Elles atteignent le Sheet — sauf `season`, que
          `DROP_COLUMNS` de `sheets.py` supprime explicitement — et c'est
          `catalog_export.py` qui ne les recopie pas dans les 22 colonnes du
          catalogue. La chaîne les récolte et les jette, deux fois.
          ⛔ Ce lot ne peut donc PAS les remplir : le correctif vit dans
          `scrapeur-veve`, pas ici. → A-LIRE-lot73-veveprice.md

          🔴🔴 CE COMMENTAIRE S'EST TROMPÉ, ET IL A COÛTÉ UN LOT (05/08/2026).
          Il disait : « La fiche se remplira toute seule le jour où l'export
          s'élargit — aucun gabarit à retoucher. » L'export s'est élargi le
          05/08 (28 colonnes, `season` à 2 720/2 720), et la fiche n'a rien
          affiché : `engine/lib/dataset.mjs` PROJETTE champ par champ, il ne
          fait pas passe-plat, et les lignes ci-dessous écrivaient un `—`
          LITTÉRAL — pas un repli `{item.x || —}`, une absence totale de
          lecture. Il fallait donc DEUX gabarits, pas zéro.
          ⭐⭐⭐ UN COMMENTAIRE QUI PROMET QU'IL N'Y A RIEN À FAIRE EST LA SEULE
          FORME DE DETTE QUI SE RELIT COMME UNE BONNE NOUVELLE. Le message de
          passation a repris sa promesse mot pour mot, sans que personne
          rouvre le fichier — la vérification s'est arrêtée là où la phrase
          rassurait. → [[regle-donnee-collectee-puis-jetee]] (11ᵉ occurrence)
          ⭐⭐ ON AFFICHE LE TIRET PLUTÔT QUE DE MASQUER LA LIGNE, et c'est la
          règle de la maison : une ligne absente laisse croire que la donnée
          n'existe pas ; un tiret `data-attente` dit qu'elle existe et qu'on
          l'attend. La fiche se remplira toute seule le jour où l'export
          s'élargit — aucun gabarit à retoucher.
          ⚠️ « Available: Globally », « Writers », « Artists », « Cover
          Artists », « Characters » et « Pages » ne sont demandés à AUCUNE API
          aujourd'hui : ceux-là ne sont pas jetés, ils ne sont pas cueillis.
          C'est une autre décision, et elle t'appartient. */}
      {/* ═══════════════════════════════════════════════════════════════════════
          🔴🔴 LOT 103 — CE BLOC ÉMETTAIT UN <table>, LE THÈME STYLE UN <dl>.
          ═══════════════════════════════════════════════════════════════════════
          Preda, 07/08 : « la colonne à gauche a ses valeurs désordonnées, parfois
          alignées au milieu parfois à droite ».
          ⭐⭐⭐ LA CAUSE N'ÉTAIT PAS UN DÉSORDRE, C'ÉTAIT UN SÉLECTEUR QUI NE
          MATCHAIT JAMAIS. Le thème porte QUATRE règles écrites `dl.fiche-tbl`,
          `dl.fiche-tbl dt`, `dl.fiche-tbl dd` — dont le `text-align:right` et les
          chiffres tabulaires qui donnent son ordre à cette colonne. Le gabarit, lui,
          écrivait `<table class="fiche-tbl">`. **Aucune des quatre ne s'appliquait.**
          Les valeurs retombaient sur le `th,td{text-align:left}` générique, et
          celles qui contiennent un élément déjà centré par ailleurs (la pastille de
          rareté, le tiret d'attente) gardaient LEUR alignement : d'où le « parfois
          au milieu, parfois à droite ».
          ⭐⭐ C'EST LA FAMILLE `Piece.astro` → `carte`, MOT POUR MOT : « des règles
          appliquées à rien, sans la moindre erreur pour le dire ». Un contrat
          gabarit ↔ thème rompu ne casse pas — il dégrade, et il se lit comme un
          choix de design malheureux.
          ⭐ ON CORRIGE LE GABARIT, PAS LE THÈME : `<dl>` est aussi le balisage JUSTE
          pour des paires nom/valeur, et c'est ce que la maquette avait dessiné.
          ⛔ `<>…</>` autour de chaque paire : une condition doit rendre UN nœud, et
          `<dt>` + `<dd>` en sont deux. Sans le fragment, Astro n'accepte pas
          l'expression. */}
      <dl class="fiche-tbl">
        {item.rarity && <><dt>{t(lang, 'item.rarity')}</dt><dd><Fragment set:html={rar(item.rarity)} /></dd></>}
        {item.tirage && <><dt>{t(lang, 'item.supply')}</dt><dd>{item.tirage.toLocaleString(nf)}</dd></>}
      </dl>

      <dl class="fiche-tbl">
        <><dt>{t(lang, 'item.edition')}</dt><dd>{item.edition_type || <span data-attente title={enAttente}>—</span>}</dd></>
        {/* ⭐ Le MCP vient du BARÈME publié (`vitrine.mjs`), pas d'une collecte :
            c'est une constante, elle est donc juste sans dépendre d'un run.
            ⚠️ La colonne `daily_mcp_points` du Sheet, elle, est connue pour être
            fausse — on ne s'en sert pas, même le jour où elle arrivera ici. */}
        <><dt>{t(lang, 'item.mcpDaily')}</dt><dd>{mcpJour !== undefined ? mcpJour.toFixed(2) : <span class="muted">—</span>}</dd></>
        <><dt>{t(lang, 'item.firstEdition')}</dt><dd>{item.premiereEdition != null
                ? item.premiereEdition.toLocaleString(nf)
                : <span data-attente title={enAttente}>—</span>}</dd></>
        {/* ⛔ LA SAISON N'EST AFFICHÉE QUE SUR LES COLLECTIBLES, ET C'EST LA
            SEULE LIGNE DE CE BLOC QUI DISPARAÎT AU LIEU DE MONTRER UN TIRET.
            La règle de la maison — « on affiche le tiret plutôt que de masquer
            la ligne » — vaut pour une donnée qui EXISTE et qu'on attend. Ici
            `COMIC_QUERY` ne demande pas `series{ season }` : sur un comic la
            colonne ne se remplira JAMAIS, et un tiret titré « pas encore
            collecté » promettrait une donnée qui n'est pas en chemin.
            ⭐ Masquer dit « ça ne s'applique pas » ; un tiret dit « ça vient ».
            Ce sont deux affirmations différentes, et une seule est vraie. */}
        {item.type !== 'comic' && (
          <><dt>{t(lang, 'item.season')}</dt><dd>{item.saison != null
                  ? item.saison.toLocaleString(nf)
                  : <span data-attente title={enAttente}>—</span>}</dd></>
        )}
        <><dt>{t(lang, 'item.storePrice')}</dt><dd>{item.storePrice ? money(item.storePrice) : <span data-attente title={enAttente}>—</span>}</dd></>
        <><dt>{t(lang, 'item.release')}</dt><dd>{item.releaseDate || <span data-attente title={enAttente}>—</span>}</dd></>
        <><dt>{t(lang, 'item.dropType')}</dt><dd>{item.methodeDrop
                ? dropLisible(item.methodeDrop)
                : <span data-attente title={enAttente}>—</span>}</dd></>
        {/* ⚠️ `fraisMarche` est un NOMBRE (8.5), le `%` est posé ici : c'est le
            gabarit qui sait qu'on est en fr-FR et doit écrire « 8,5 % » avec sa
            virgule et son espace insécable, pas le moteur. */}
        <><dt>{t(lang, 'item.marketFee')}</dt><dd>{item.fraisMarche != null
                ? `${item.fraisMarche.toLocaleString(nf)}\u00a0%`
                : <span data-attente title={enAttente}>—</span>}</dd></>
        <><dt>{t(lang, 'item.available')}</dt><dd><span data-attente title={enAttente}>—</span></dd></>
      </dl>

      {/* ③ LA PROVENANCE — deux formes, parce qu'un comic et un collectible ne
          se décrivent pas pareil. ⭐ La série reste un LIEN vers son set : c'est
          la seule ligne de ce bloc qui mène quelque part. */}
      {item.type === 'comic' ? (
        <dl class="fiche-tbl">
          <><dt>{t(lang, 'item.writers')}</dt><dd><span data-attente title={pasCollecte}>—</span></dd></>
          <><dt>{t(lang, 'item.artists')}</dt><dd><span data-attente title={pasCollecte}>—</span></dd></>
          <><dt>{t(lang, 'item.coverArtists')}</dt><dd><span data-attente title={pasCollecte}>—</span></dd></>
          <><dt>{t(lang, 'item.characters')}</dt><dd><span data-attente title={pasCollecte}>—</span></dd></>
          {/* ⛔ PAS DE `toLocaleString` SUR UNE ANNÉE : en fr-FR il rendrait
              « 2 024 ». Un formateur de nombres appliqué à un millésime est
              une faute qui a l'air d'un soin. */}
          <><dt>{t(lang, 'item.startYear')}</dt><dd>{item.anneeDebut != null
                  ? String(item.anneeDebut)
                  : <span data-attente title={enAttente}>—</span>}</dd></>
          <><dt>{t(lang, 'item.pages')}</dt><dd><span data-attente title={pasCollecte}>—</span></dd></>
          <><dt>{t(lang, 'item.issue')}</dt><dd>{titreOeuvre}</dd></>
          {colSlug && <><dt>{t(lang, 'item.series')}</dt><dd><a href={localize(lang, `/collection/${colSlug}/`)}>{item.series}</a></dd></>}
          {item.licensor && <><dt>{t(lang, 'item.license')}</dt><dd>{item.licensor}</dd></>}
        </dl>
      ) : (
        <dl class="fiche-tbl">
          {colSlug && <><dt>{t(lang, 'item.series')}</dt><dd><a href={localize(lang, `/collection/${colSlug}/`)}>{item.series}</a></dd></>}
          {item.brand && <><dt>{t(lang, 'item.brand')}</dt><dd>{item.brand}</dd></>}
          {item.licensor && <><dt>{t(lang, 'item.license')}</dt><dd>{item.licensor}</dd></>}
        </dl>
      )}
    </div>

    <div class="fiche__txt">
      {/* 📕 Le TITRE DE L'OEUVRE, pas celui de la collection. Voir `titreOeuvre`
          dans le frontmatter : repli sur `item.name`, toujours. */}
      <h1 class="mono-t">{titreOeuvre}</h1>
      {/* ⛔ RARETÉ ET TIRAGE RETIRÉS D'ICI LE 06/08/2026 (demande de Preda).
          Ils restent dans le tableau d'identité 90 lignes plus bas — ils y sont
          nommés, alignés et traduits. Sous le titre ils n'étaient qu'un doublon
          qui poussait la description vers le bas.
          ⭐ Le lien de série RESTE : lui n'existe qu'ici, et c'est la seule
          passerelle de la fiche vers sa collection. Retirer une ligne entière
          parce que deux de ses trois morceaux sont en trop, c'est la panne
          d'à côté. */}
      <p class="respire">
        {colSlug && <a class="tag" href={localize(lang, `/collection/${colSlug}/`)}>{item.series}</a>}
      </p>

      {/* 📝 LA DESCRIPTION. Elle est dans les onglets froids du Sheet depuis
          toujours et ne traversait pas `catalog_export.py` — troisieme fois
          que ce motif se produit sur ce fichier, apres `image` et `ath_date`.
          ⭐ RENDU CONDITIONNEL, jamais un bloc vide : un catalogue anterieur au
          lot de collecte du 01/08 n'a pas la colonne, `dataset.mjs` rend
          `null`, et la fiche est exactement celle d'avant. C'est ce qui permet
          de deposer ce lot SANS attendre que la chaine ait tourne.
          ⛔ Texte BRUT, jamais `set:html` : cette chaine vient d'un Sheet, donc
          d'une saisie, donc c'est une donnee d'entree comme une autre. La
          rendre en HTML serait une injection servie par notre domaine — la
          meme faute que le `src` non assaini des visuels. */}
      {item.description && <p class="prose">{item.description}</p>}

      {/* ═══ LES DEUX MURS ═══
          ⚠️ La maquette oppose « Plancher VeVe » (gems) et « Plancher StackR »
          (OMI). Le second n'existe PAS dans le jeu de données — aucun collecteur
          ne le remonte aujourd'hui. ⛔ Je ne fabrique pas un chiffre pour
          remplir un cadre : sur un site de cotes, une valeur inventée est la
          seule faute qu'on ne rattrape jamais.
          ⚠️ CE COMMENTAIRE MENTAIT, corrigé le 03/08/2026 (lot 43). Il annonçait
          que le second mur portait le PRIX MÉDIAN ; le code rend le cadre StackR
          à tirets depuis l'arbitrage de Preda le même jour. La médiane n'est
          affichée NULLE PART dans le moteur — vérifié sur les 56 gabarits.
          ⭐⭐ Un commentaire qui décrit une version précédente du code d'en
          dessous est pire qu'un commentaire absent : il se lit comme une
          spécification, et c'est lui qu'on croit quand les deux divergent.
          ⛔ La médiane reste CALCULÉE et elle pilote toujours le classement
          (dataset.mjs) : ne pas confondre « plus affichée » et « retirée ». */}
      <div class="murs">
        <div>
          {/* ⭐ LOT 73 — LE BOUTON « VOIR SUR VEVE », en face du plancher.
              🔴 IL A FALLU DIX LOTS POUR LE POSER, ET LA DONNÉE ÉTAIT LÀ DEPUIS
              LE DÉBUT. Ce fichier et le Marché portaient tous deux « ⛔ aucune
              URL dans la donnée, et je n'en fabrique pas ». Or `catalogue.csv.gz`
              a une colonne `veve_url`, remplie sur 1 200 fiches sur 1 200 —
              c'est le MOTEUR qui la jetait, pas la collecte qui l'ignorait.
              ⭐⭐⭐ Le refus était juste ET il tenait lieu de vérification :
              « on ne fabrique pas d'URL » a fini par vouloir dire « on n'en a
              pas », ce que personne n'avait mesuré. Un principe correct devient
              un angle mort dès qu'il dispense de regarder.
              ⚠️ `rel="noopener"` : la page ouverte ne doit pas pouvoir
              manipuler la nôtre par `window.opener`. */}
          <div class="mur__k">
            <Fragment set:html={gemsM()} /> {t(lang, 'item.floor')}
            {/* ⭐ LOT 77 — LE BOUTON VISE LE MARCHÉ, PAS LA BOUTIQUE.
                Preda : « le lien que tu as mis pour VeVe n'est pas celui du
                market ». Il avait raison : `veve_url` mène à la fiche
                produit. Le motif du marché vient de trois exemples qu'il a
                relevés lui-même — voir `dataset.mjs`. */}
            {item.veveMarketUrl && (
              <a class="lien-b" href={item.veveMarketUrl} target="_blank" rel="noopener"
                 style="margin-left:auto">{t(lang, 'item.viewVeve')} ↗</a>
            )}
          </div>
          <div class="mur__v">{coteFermee
            ? <Cote lang={lang} uuid={item.uuid} champ="floor" />
            : money(item.floor)}<span class="mur__u">gems</span></div>
          <div class="mur__eq">{item.listings ?? '—'} {t(lang, 'item.listings')}</div>
          <div class="mur__d">
            {[['item.7d', item.change7d], ['item.30d', item.change30d]].map(([k, v]) => (
              <Fragment set:html={delta(v, { plein: true, k: t(lang, k) })} />
            ))}
          </div>
        </div>
        <span class="murs__sep" aria-hidden="true"></span>
        <div>
          {/* ═══ LE PLANCHER STACKR — arbitrage Preda du 03/08/2026 ═══
              🔴 CETTE DONNEE N'EXISTE PAS ENCORE. Aucun collecteur ne remonte
              le plancher StackR : `_DynState` de catalog_export.py ne fournit
              que `floor` et `listings`, et `porter.mjs` le recense noir sur
              blanc — ABSENTS = {omi, od1, od7, usd, d1, dem, fav}.
              Preda a tranche : AFFICHER LE CADRE AVEC DES TIRETS, pour voir la
              structure finale et garder le manque sous les yeux.
              ⭐⭐ MAIS UN « — » QUI VEUT DIRE « AUCUNE OFFRE » ET UN « — » QUI
              VEUT DIRE « PAS ENCORE COLLECTE » SE RESSEMBLENT ET SONT
              L'INVERSE. C'est le defaut de famille de ce projet — une absence
              qui prend l'apparence d'une valeur. D'ou `data-attente` et le
              `title` : le cadre dit qu'il attend une source, il ne pretend pas
              constater un marche vide.
              ⛔ NE JAMAIS remplir ces champs par un calcul, un taux devine ou
              une conversion approchee. Le jour ou le collecteur existe, ce
              bloc change de SOURCE sans changer de FORME. */}
          {/* ⛔ ET CELUI DE STACKR RESTE DÉSACTIVÉ, PARCE QUE L'URL, ELLE,
              N'EXISTE VRAIMENT NULLE PART — ni dans le catalogue, ni dans le
              Sheet, ni dans aucun collecteur (vérifié cette fois, pas supposé).
              ⭐ Un `<span>` et non un `<a>` : un bouton mort qui a l'air
              cliquable coûte plus cher en confiance qu'un bouton grisé qui dit
              pourquoi. Le jour où l'URL arrive, `<span>` devient `<a href>` et
              rien d'autre ne bouge. */}
          <div class="mur__k">
            <Fragment set:html={omiM()} /> {t(lang, 'item.floorStackr')}
            <span class="lien-b" data-attente title={t(lang, 'data.notCollected')}
                  style="margin-left:auto">{t(lang, 'item.viewStackr')} ↗</span>
          </div>
          <div class="mur__v" data-attente title={t(lang, 'data.notCollected')}>—<span class="mur__u">OMI</span></div>
          <div class="mur__eq" data-attente title={t(lang, 'data.notCollected')}>—</div>
          <div class="mur__d">
            <span class="muted">{t(lang, 'data.notCollected')}</span>
          </div>
        </div>
      </div>

      {/* ═══ LA JAUGE ═══
          ⭐⭐ LES EXTRÊMES SONT DANS LA JAUGE, et c'est le point de la maquette
          que j'avais manqué deux fois. L'ATH et l'ATL n'ont de sens QUE par
          rapport au prix du jour : les isoler dans deux cartouches les coupe de
          leur seule référence. Le curseur EST l'information. */}
      {/* 🔴 LOT 101 — LA JAUGE NE SE REND PAS QUAND LA COTE EST FERMEE.
          ⛔ Elle ne pouvait pas devenir une suite de <Cote> : sa VALEUR est la
          POSITION du curseur, calculee `(floor - atl) / (ath - atl)` — trois
          prix dans une seule coordonnee CSS. Un curseur place a 63 % le long
          d'une amplitude connue REND le plancher a qui sait diviser. La cacher
          par du CSS l'aurait laissee dans l'attribut `style`, servie a tous.
          ⭐ On ne la remplace par rien ici : le <Gate> et le <Cadran> plus bas
          portent deja l'appel a l'action, et un deuxieme verrou sur la meme
          page se lit comme un site qui ne montre rien, pas comme une offre. */}
      {!coteFermee && item.atl != null && item.ath != null && (
        <div class="jauge">
          <div class="jauge__b">
            <div class="jauge__r"></div>
            {item.ath > item.atl && item.floor != null && (
              <div class="jauge__c" style={`left:${Math.min(100, Math.max(0, ((item.floor - item.atl) / (item.ath - item.atl)) * 100)).toFixed(1)}%`}></div>
            )}
          </div>
          <div class="jauge__l">
            <div class="jauge__e">
              <span class="jauge__k">{t(lang, 'item.low')}</span>
              <span class="jauge__v jauge__v--b"><Fragment set:html={gemsM()} />{money(item.atl)}</span>
              <span class="jauge__d">{item.atlDate ? `${t(lang, 'item.on')} ${item.atlDate} · ` : ''}
                {item.atl > 0 ? `${t(lang, 'item.above')} ${((item.floor / item.atl - 1) * 100).toFixed(0)} %` : ''}</span>
            </div>
            <div class="jauge__e jauge__e--c">
              <span class="jauge__k">{t(lang, 'item.position')}</span>
              <span class="jauge__v">{item.ath > item.atl
                ? Math.min(100, Math.max(0, ((item.floor - item.atl) / (item.ath - item.atl)) * 100)).toFixed(0)
                : '—'} %</span>
              <span class="jauge__d">{t(lang, 'item.amplitude')}</span>
            </div>
            <div class="jauge__e jauge__e--d">
              <span class="jauge__k">{t(lang, 'item.high')}</span>
              <span class="jauge__v jauge__v--h"><Fragment set:html={gemsM()} />{money(item.ath)}</span>
              <span class="jauge__d">{item.athDate ? `${t(lang, 'item.on')} ${item.athDate} · ` : ''}
                {item.ath > 0 ? `${t(lang, 'item.below')} ${((1 - item.floor / item.ath) * 100).toFixed(0)} %` : ''}</span>
            </div>
          </div>
        </div>
      )}

      {/* ═══════════════════════════════════════════════════════════════════
          LE GRAPHIQUE RENTRE DANS `.fiche__txt` — 03/08/2026, lot 45, Preda
          ═══════════════════════════════════════════════════════════════════
          🔴 « Le tableau Floor price est a cheval entre le bloc du titre et le
          bloc Details. » Il l'etait : le bloc vivait dans un `.avec-aside`
          FRERE de `.fiche`, donc sous les DEUX colonnes de la fiche — la
          colonne image (qui porte « Details ») et la colonne texte. Il ne
          debordait plus de la page depuis le lot 43, mais il ne se rattachait
          toujours a rien.
          ⭐⭐ TROISIEME FOIS QUE CE BLOC BOUGE, ET LES TROIS FOIS POUR LA MEME
          RAISON : la classe etait juste, le NIVEAU ne l'etait pas. « Est-ce la
          bonne classe ? » et « est-ce le bon parent ? » sont deux questions, et
          seule la seconde decide de ce qu'on voit.
          ⭐ C'est la structure de la maquette, verifiee et non deduite : son
          `graphBloc` est ecrit DANS `.fiche__txt`, juste apres `.jauge`, avec
          `margin-top:var(--s6)` (maquette-veveprice.html l. 2406). Titre,
          description, murs, jauge et courbe sont donc un seul conteneur.
          ⛔ `.avec-aside` ET SON `<aside>` VIDE DISPARAISSENT AVEC LUI. La
          colonne laterale n'existait que pour empecher le graphique de
          s'etaler ; `.fiche` borne desormais la largeur. Garder un aside vide
          « pour plus tard » reserverait 300 px a du neant sur 7 857 pages.
          ⚠️ `.avec-aside` reste habillee par le theme et EMISE ailleurs
          (BlogPostVitrine.astro) : elle ne devient pas une regle orpheline.
          ⚠️ L'ORDRE INTERNE NE BOUGE PAS : courbe publique, puis sceau, puis
          cadran. Sans JavaScript on lit d'abord ce qui manque et comment
          l'obtenir, ensuite le verrou. */}
      {/* ⭐ Balisage de la maquette : `graph-hote`, `graph-tete`, `series`,
          `serie-b`, `graph-pied`.
          ⚠️ Les boutons de série sont RENDUS mais inertes — le graphique n'est pas
          encore interactif. Ils portent donc `disabled` : ⛔ un contrôle qui ne
          répond pas doit le DIRE plutôt qu'ignorer le clic en silence. */}
      <div class="graph-hote" style="margin-top:var(--s6)">
        <div class="graph-tete">
          <div>
            <h2 style="font-size:var(--t-lg)">{t(lang, 'item.chart')}</h2>
            <p class="etiq" style="margin-top:5px">{item.points} {t(lang, 'item.shown')}</p>
          </div>
          {/* ═══════════════════════════════════════════════════════════════
              🔴 LOT 104 — LES PLAGES VIENNENT DU MANIFESTE, PLUS DU GABARIT
              ═══════════════════════════════════════════════════════════════
              CE QUI ÉTAIT ÉCRIT ICI : `['3 J','30 J','90 J','MAX']`, avec
              `data-verrou` sur tout sauf la première. Trois défauts, tous
              silencieux :
                · « 7 J » N'EXISTAIT PAS — et c'est précisément la plage que
                  Crevette achète. La grille de Preda était invendable depuis
                  cette ligne, sans qu'aucun banc n'ait de raison de le dire ;
                · le verrou ne lisait AUCUN palier : il était identique pour
                  l'abonné et le visiteur. Un verrou qui ne se lève jamais
                  n'est pas un verrou, c'est un dessin de verrou ;
                · et le jour où Preda change la grille, un gabarit ne le sait
                  pas. Elle a changé le 07/08 — trois fois en trois semaines.
              ⭐ `plages()` lit `access.gates.price_history.plages`. L'ordre du
              tableau est l'ordre affiché, et le palier de chaque plage est une
              DONNÉE, comme les prix et les plafonds.

              ⭐⭐⭐ ET L'ÉTAT VERROUILLÉ EST CE QUE LE HTML CONTIENT — pour
              tout le monde, abonné compris. UNE PAGE PRÉ-GÉNÉRÉE N'A PAS DE
              VISITEUR : ces 8 500 fiches sont des fichiers, construits une
              fois, servis à tous. Rendre le verrou selon un palier au build
              reviendrait à figer le palier du BUILD dans le fichier — c'est
              exactement la panne du lot 24, et le résultat serait « le site
              ouvre tout à tout le monde » ou « il n'ouvre jamais rien ».
              ⛔ ET ON NE LE DÉCIDE PAS NON PLUS SUR LE COOKIE D'AFFICHAGE :
              il ne porte que « 1 », il ne dit pas QUEL palier, et il se pose à
              la main. Il ne peut pas distinguer une Crevette d'une Whale.
              ⚠️ Son nom n'apparaît volontairement pas dans ce fichier :
              `test:session` refuse de le lire là où un droit se décide.
              ➡️ Le déverrouillage se fait dans `Cadran.astro`, au retour de
              `/api/historique/[uuid]` — la seule voie qui ait lu `vp_session`
              côté serveur, et qui renvoie le palier RÉEL. Une seule voie, donc
              pas de seconde vérité. */}
          <div class="plages" role="group" aria-label={t(lang, 'item.chart')} data-plages>
            {LES_PLAGES.map((pl, k) => (
              <button type="button" aria-pressed={k === 0 ? 'true' : 'false'}
                      data-plage={pl.cle}
                      data-tier={pl.verrouillee ? pl.tier : undefined}
                      aria-disabled={pl.verrouillee ? 'true' : undefined}
                      title={pl.verrouillee
                        ? t(lang, 'item.range.locked').replace('%s', nomDuPalier(pl.tier))
                        : undefined}
                      data-verrou={pl.verrouillee ? '' : undefined}>{t(lang, `item.range.${pl.cle}`)}</button>
            ))}
          </div>
          <div class="series" role="group" aria-label={t(lang, 'item.chart')}>
            <button class="serie-b" type="button" aria-pressed="true" disabled style="--c:var(--sect-pur)"><i></i>{t(lang, 'movers.floor')}</button>
            <button class="serie-b serie-b--pointille" type="button" aria-pressed="true" disabled style="--c:var(--muted)"><i></i>{t(lang, 'item.listings')}</button>
          </div>
        </div>
        <Fragment set:html={svg} />
        <div class="graph-pied"><span class="etiq">{item.totalPoints?.toLocaleString(nf)} {t(lang, 'home.points')}</span></div>
      </div>

      {/* ⛔ LE BLOC « MODULES » A ETE RETIRE LE 03/08/2026 (demande Preda).
          Il portait le catalogue des 5 modules + les onglets `role="tablist"`.
          ⚠️ CE QUI DISPARAIT AVEC LUI, ET QU'IL FAUT SAVOIR : c'etait le seul
          endroit de la fiche qui MONTRAIT au visiteur ce qu'il n'a pas encore —
          « il y a quelque chose ici, et c'est a vous » plutot que « il n'y a rien
          ici ». Le composant Gate ci-dessous garde ce role pour l'historique seul.
          ⭐ `franchit()` et la matrice d'acces ne bougent PAS : c'est un retrait
          d'AFFICHAGE, pas de droit. Les paliers restent exactement ce qu'ils
          etaient, et test:acces continue de les prouver. */}
      <Gate lang={lang} gate="price_history" total={item.totalPoints} shown={item.points} since={item.since} />
      {/* ⭐⭐ IL VIENT APRÈS LE <Gate>, ET L'ORDRE COMPTE. Sans JavaScript, on lit
          d'abord ce qui manque et comment l'obtenir (le sceau), puis on voit le
          verrou. Avec JavaScript et un droit reconnu, les deux disparaissent et le
          cadran prend leur place. ⛔ `svgPublic` est la courbe PUBLIQUE — celle
          déjà affichée en clair plus haut sur cette page. Ne jamais lui passer
          autre chose : le flou du verrou est de la PRÉSENTATION, il ne cache rien
          à qui lit la source. */}
      <Cadran lang={lang} uuid={item.uuid} svgPublic={svg}
              total={item.totalPoints} shown={item.points} />
    </div>
  </div>

  {item.prixAberrant && <p class="avertis">{t(lang, 'item.outlier')}</p>}

  {/* ⛔ « DERNIERS RELEVES » RETIRE LE 03/08/2026 (demande Preda).
      Le tableau redisait, en chiffres, ce que la courbe juste au-dessus dit en
      forme. ⭐ `recent` reste CALCULE dans le frontmatter : il ne coute rien et
      il est le seul endroit ou la profondeur reelle de l'historique public se
      lit. Le retirer aussi rendrait le jour du retour plus cher que le gain. */}
  {relatedPosts.length > 0 && (
    <>
      <h2>{t(lang, 'blog.relatedPosts')}</h2>
      <div class="boites">
        {relatedPosts.map((p, k) => (
          <a class="boite" href={localize(lang, `/blog/${p.slug}/`)}>
            <span class="boite__n">{String(k + 1).padStart(3, '0')}</span>
            <span class="boite__t">{p.data.title}</span>
            <span class="boite__d">{p.data.description}</span>
          </a>
        ))}
      </div>
    </>
  )}

</Base>

