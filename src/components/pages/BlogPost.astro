---
// ═══════════════════════════════════════════════════════════════════════════
// AIGUILLAGE DE PEAU — ajoute le 03/08/2026 (lot 37).
// ═══════════════════════════════════════════════════════════════════════════
// ⭐ UN SEUL ENDROIT DECIDE. Le moteur a deja ce motif : `src/pages/index.astro`
// choisit `Home` ou `EditorialHome` selon le manifeste. On le suit plutot que
// d'inventer un second mecanisme — deux facons de choisir un gabarit finiraient
// par diverger, comme les quatre reglages ecrases de ce projet.
//
// 🔴 QUAND `blogSkin()` VAUT `sobre` (le DEFAUT, et le cas de vevewiki), CE QUI
// SUIT EST EXACTEMENT LE FICHIER D'AVANT, a l'enveloppe `<Fragment>` pres.
// Le blog de vevewiki — 40 pages reelles — ne passe jamais par la branche
// vitrine, donc il ne peut pas bouger.
//
// ⚠️ L'ENVELOPPE N'EST PAS COSMETIQUE. Le corps commence par un COMMENTAIRE
// JSX puis par `<Base>` : deux expressions soeurs. Sans `<Fragment>`, le
// compilateur Astro rend « Expected `,` or `)` but found `Identifier` » — un
// message qui ne nomme ni le commentaire ni la cause. Mesure, pas suppose.
import BlogPostVitrine from './BlogPostVitrine.astro';
import { blogSkin } from '../../../engine/lib/blog.mjs';
const _peau = blogSkin();

import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { translationPaths, tagsFor } from '../../../engine/lib/blog.mjs';
import { dataset } from '../../../engine/lib/dataset.mjs';
import { manifest, siteUrl } from '../../../engine/lib/manifest.mjs';
import { jsonld, breadcrumbLd } from '../../../engine/lib/seo.mjs';
import { t, localize, dateLocale } from '../../../engine/lib/i18n.mjs';
import { carteArticle } from '../../../engine/lib/og.mjs';

const { lang, post, updatedAt } = Astro.props;
const m = manifest();
const root = siteUrl();
const df = dateLocale[lang] || 'en-GB';
// Deux sources : un .md du depot a une `entry` (pipeline Astro), une ligne de
// Sheet arrive deja rendue en `html` (engine/lib/markdown.mjs).
const Content = post.entry ? (await render(post.entry)).Content : null;
const path = `/blog/${post.slug}/`;
const alt = await translationPaths(post.data.translationKey);

// Maillage interne : les fiches citees par l'article
const ds = await dataset();
const byUuid = new Map(ds.items.map((i) => [i.uuid, i]));
const cited = (post.data.items || []).map((u) => byUuid.get(u)).filter(Boolean);

const crumbs = [
  { name: t(lang, 'home.crumb'), url: localize(lang, '/') },
  { name: t(lang, 'blog.title'), url: localize(lang, '/blog/') },
  { name: post.data.title },
];
const articleLd = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: new Date(post.data.date).toISOString(),
  dateModified: new Date(post.data.updated || post.data.date).toISOString(),
  inLanguage: lang,
  author: { '@type': 'Organization', name: m.site.brand },
  publisher: { '@type': 'Organization', name: m.site.brand },
  mainEntityOfPage: `${root}${localize(lang, path)}`,
};
const ld = [articleLd, breadcrumbLd(crumbs.map((c) => ({ name: c.name, url: c.url ? root + c.url : `${root}${localize(lang, path)}` })))];
const tagsAvecPage = new Set((await tagsFor(lang)).map((x) => x.tag));
---
{_peau === "vitrine" ? <BlogPostVitrine {...Astro.props} /> : (
<Fragment>
{/* La carte sert d'og:image, PAS d'illustration en tete d'article : a
    l'interieur elle ne ferait que repeter le <h1> juste au-dessus, et une
    image qui redit le texte qu'elle surmonte est du remplissage. */}
<Base lang={lang} path={path} altPaths={alt} title={post.data.title} description={post.data.description} crumbs={crumbs} ld={ld} updatedAt={updatedAt} image={carteArticle(lang, post.slug)}>
  <article class="post">
    <h1>{post.data.title}</h1>
    <p class="muted" style="margin:0 0 6px">
      {t(lang, 'blog.published')} {new Date(post.data.date).toLocaleDateString(df)}
      {post.data.updated && ` · ${t(lang, 'blog.updated')} ${new Date(post.data.updated).toLocaleDateString(df)}`}
    </p>
    {post.data.tags.length > 0 && (
      <p>{post.data.tags.map((tg) => (tagsAvecPage.has(tg) ? <a class="tag" href={localize(lang, `/blog/tag/${tg}/`)}>{tg}</a> : <span class="tag">{tg}</span>))}</p>
    )}
    <div class="prose">{Content ? <Content /> : <Fragment set:html={post.html} />}</div>
  </article>

  {cited.length > 0 && (
    <>
      <h2>{t(lang, 'blog.relatedItems')}</h2>
      <div class="grid">
        {cited.map((i) => (
          <a class="item" href={localize(lang, i.path)}>
            {/* 📏 LOT 203, POINT `ag` — LA SEULE FAMILLE QUI N'AVAIT AUCUNE
                BORNE. Mesuré le 26/08 : `.tbl-obj__s` coupe à 34 caractères,
                `.tuile__s` coupe à la largeur de sa case — `.item .s` ne
                coupait rien du tout, et une série mesure jusqu'à 89 caractères
                dans le corpus. Elle partait donc sur trois lignes et poussait
                la carte, ce qui est exactement ce que Preda décrit par « ça
                déforme ».
                ⭐⭐⭐ `data-serie`, ET C'EST TOUT LE SOIN DE CE POINT. `.item .s`
                porte AUSSI des dates de blog, des rôles et des notes
                éditoriales (`BlogIndex`, `BlogTag`, `Editorial` ×2) : leur
                imposer une ligne unique tronquerait des textes qui ont le droit
                de respirer. Un correctif global sur une classe partagée avait
                déjà coûté 764 titres à ce projet.
                ⇒ la règle du thème vise `.item .s[data-serie]`, jamais `.s`. */}
            <div class="n" title={i.name}>{i.name}</div><div
              class="s" data-serie title={i.series}>{i.series}</div>
          </a>
        ))}
      </div>
    </>
  )}

  <p style="margin-top:28px"><a href={localize(lang, '/blog/')}>← {t(lang, 'blog.backToBlog')}</a></p>
</Base>
</Fragment>
)}
