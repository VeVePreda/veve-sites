---
// ⚠️ VeVePreda/veve-sites — src/components/pages/Collections.astro
// ⛔ Propre à veveprice (aucune page de prix chez vevewiki).
import Base from '../../layouts/Base.astro';
import CarteSet from '../CarteSet.astro';
// ⚡ LOT 139 — le pilote de cette page quitte le HTML : voir le point d'appel
//   en bas de fichier, et l'en-tête de `src/socle/modules/series.js`.
import { moduleJs } from '../../../engine/lib/socle_js.mjs';
const pilote = moduleJs('series');
// 🔴 LOT 155-B — LE CHARGEUR D'INDEX, PARTAGÉ AVEC `/comics/` ET `/collectibles/`.
// Voir l'en-tête de `src/socle/modules/index_rayon.js`. ⭐ L'ordre des deux
// `<script defer>` est garanti par `defer` lui-même, pas par la position.
const chargeur = moduleJs('index_rayon');
import { dataset } from '../../../engine/lib/dataset.mjs';
import { t, localize, numberLocale } from '../../../engine/lib/i18n.mjs';
import { jourISO } from '../../../engine/lib/vitrine.mjs';

const { lang } = Astro.props;
const ds = await dataset();
const nf = numberLocale[lang] || 'en-GB';
const cols = [...ds.collections.values()].sort((a, b) => b.items.length - a.items.length);

// 🔴 LOT 131 — `pile()` A DÉMÉNAGÉ DANS `CarteSet.astro`, ET ELLE Y A GAGNÉ
// UNE CORRECTION. Elle prenait `items.slice(0, 3)` : les trois pièces les plus
// CHÈRES, donc les plus susceptibles d'être des variantes rares sans couverture
// publiée (6 609 comics n'ont pas d'`image_url`). Elle prend désormais les
// trois premières QUI ONT une image. ⭐ Le déplacement n'était pas cosmétique :
// c'est en écrivant le composant partagé qu'on a vu que `/collections/` et
// `/sets/` ne rendaient pas la même chose — le doublon cachait l'écart.
// ⛔ On ne laisse pas une copie ici « pour ne pas toucher à cette page » :
// c'est exactement comme ça que `data-ch` a divergé pendant deux lots.

// ═══════════════════════════════════════════════════════════════════════════
// LOT 68 — LE MODULE DE FILTRES DES SETS (demande de Preda, 05/08/2026)
// ═══════════════════════════════════════════════════════════════════════════
// 🔴 « PAR SAISON » N'EXISTE PAS, ET C'EST À DIRE, PAS À CONTOURNER.
// Aucun champ « saison » ne traverse la chaîne : ni `catalogue.csv.gz`, ni
// `dataset.mjs` (name, kind, rarity, edition_type, series, brand, licensor,
// release_date, tirage, store_price). VeVe n'en publie pas non plus.
// ⭐⭐ LA TENTATION ÉTAIT DE LA FABRIQUER — « saison 1 = 2021, saison 2 =
// 2022 ». Ce serait une donnée inventée sur un site de cotes, c'est-à-dire la
// seule faute qu'on ne rattrape jamais. On offre donc l'ANNÉE DE PREMIÈRE
// SORTIE, qui est réelle, et le panneau dit en une phrase pourquoi ce n'est
// pas « saison » (`sets.noSeason`).
// ⛔ Si VeVe publie un jour une saison, elle entre par le catalogue, pas par
//    une table de correspondance écrite ici.
//
// ⚠️ CHAQUE AXE EST DÉRIVÉ DES PIÈCES DU SET, JAMAIS DÉCLARÉ SUR LE SET :
//   · année  = la PLUS ANCIENNE date de sortie de ses pièces (un set naît avec
//              sa première pièce, il ne renaît pas à chaque ajout) ;
//   · type   = le type majoritaire (un set est un set de comics OU de
//              collectibles ; les mélanges existent, on suit la majorité et on
//              ne prétend pas trancher) ;
//   · marque = celle du set, déjà portée par `dataset.mjs`.
// ⚠️ `jourISO` et PAS `slice(0, 4)` : `releaseDate` vaut « 06/10/2021 »,
// donc un découpage naïf rendait « 06/1 » — aucune année reconnue, et le
// panneau « Année de sortie » ne s'affichait même pas (il ne s'émet qu'à
// partir de deux années distinctes). Le filtre s'était donc AUTO-SUPPRIMÉ en
// silence : le symptôme le plus discret possible.
const anneeDe = (c) => {
  const ans = c.items.map((i) => jourISO(i.releaseDate).slice(0, 4)).filter(Boolean).sort();
  return ans[0] || '';
};
const typeDe = (c) => {
  const n = c.items.filter((i) => i.type === 'comic').length;
  return n * 2 > c.items.length ? 'comic' : 'collectible';
};
const axes = cols.map((c) => ({ c, an: anneeDe(c), ty: typeDe(c) }));
const annees = [...new Set(axes.map((x) => x.an).filter(Boolean))].sort();
const marques = [...new Set(cols.map((c) => (c.brand || '').trim()).filter(Boolean))]
  .sort((a, b) => a.localeCompare(b));

// ═══════════════════════════════════════════════════════════════════════════
// 🔴 LOT 133 — LA LICENCE, LE QUATRIÈME AXE (demande Preda, 10/08)
// ═══════════════════════════════════════════════════════════════════════════
// ⭐⭐ POURQUOI LA LICENCE ET PAS AUTRE CHOSE — c'est une MESURE, pas un goût.
// Sur le catalogue réel du 10/08 (19 412 lignes, 5 154 sets) :
//     licences distinctes au niveau set :    96
//     marques  distinctes au niveau set : 1 492
// Le filtre « marque » a donc besoin d'un champ de recherche pour être
// utilisable (lot 115b) ; la licence tient à l'écran. C'est l'axe par lequel
// un collectionneur pense — « je cherche du Marvel » — et il n'existait pas.
// ⚠️ `licensor` est rempli à **100 %** au catalogue : il n'y a pas de cas
// « sans licence » à traiter à l'affichage. On garde quand même `filter(Boolean)`
// — la vitrine ne publie pas tout le catalogue, et une liste blanche future
// pourrait le vider. *Un champ plein aujourd'hui n'est pas un champ garanti.*
//
// ⭐⭐⭐ TRIÉES PAR NOMBRE DE SETS, PAS ALPHABÉTIQUEMENT, et c'est délibéré :
// Marvel porte 58 % des sets, Dynamite 16 %. Un ordre alphabétique mettrait
// « ABLAZE Publishing » en tête et enterrerait Marvel au milieu d'une liste de
// cinquante. ⛔ Le filtre « marque », lui, RESTE alphabétique : avec 1 492
// entrées et un champ de recherche, on cherche un nom qu'on connaît déjà.
// Deux listes, deux usages, deux ordres — et c'est écrit ici parce que la
// différence a l'air d'une incohérence quand on lit les deux à la suite.
const parLicence = new Map();
for (const c of cols) {
  const l = (c.licensor || '').trim();
  if (!l) continue;
  parLicence.set(l, (parLicence.get(l) || 0) + 1);
}
const licences = [...parLicence.entries()]
  .sort((a, b) => (b[1] - a[1]) || a[0].localeCompare(b[0]))
  .map(([nom, n]) => ({ nom, n }));
const tailles = cols.map((c) => c.items.length);
const tailleMax = tailles.length ? Math.max(...tailles) : 0;
const nbComicSets = axes.filter((x) => x.ty === 'comic').length;
const chevron = '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>';
// ⭐ 60 et pas 910 : voir le commentaire du bouton « voir plus », plus bas.
// ⛔ Ce n'est PAS une pagination — aucune adresse neuve n'est créée, la page
// reste `/collections/`. Même politique que le Marché, pour la même raison :
// les 1 200 adresses du site sont gelées.
const PAR_TRANCHE = 60;
---
<Base sect="sets" lang={lang} path="/collections/" title={t(lang, 'collections.title')}
      description={t(lang, 'desc.collections', { n: cols.length.toLocaleString(nf) })} updatedAt={ds.updatedAt}
      crumbs={[{ name: t(lang, 'home.crumb'), url: localize(lang, '/') }, { name: t(lang, 'collections.title') }]}>
  {/* ⭐ LA TÊTE DE PAGE de la maquette : titre à gauche, pile de vignettes à
      droite. Elle dit de quoi parle l'écran AVANT qu'on lise le titre. */}
  <div class="tete-p">
    <div>
      {/* 🔴 LOT 129 — `.toUpperCase()` RETIRÉ, ET IL NE MANQUERA À PERSONNE.
            `.etiq` porte DÉJÀ `text-transform:uppercase` (theme.css l. 599) : les
            capitales étaient faites DEUX FOIS, une fois dans le texte et une fois
            dans le style. Le rendu est identique à l'octet près.
            ⛔ MAIS LA VERSION MARKUP DÉTRUISAIT LA TRADUCTION : `t()` marque son
            libellé d'une clé (lot 129), et `.toUpperCase()` mettait LA CLÉ en
            capitales avec le reste — `analytics.title` devenait `ANALYTICS.TITLE`,
            introuvable dans le dictionnaire, donc jamais échangé.
            ⭐⭐ Et c'était déjà une faute avant ce lot : des capitales écrites dans le
            texte se copient en capitales, et un lecteur d'écran peut les épeler
            lettre par lettre. La casse est une affaire de STYLE. */}
      <p class="etiq etiq--bleu tete-p__st">// {t(lang, 'collections.title')}</p>
      <h1 class="mono-t">{t(lang, 'collections.title')}</h1>
      <p class="respire">{cols.length.toLocaleString(nf)} {t(lang, 'collections.count')}.</p>
    </div>
    {/* ⭐ MEME DEFAUT ICI, ET IL VENAIT DU MEME COPIER-COLLER : trois
        hexagones en dur au lieu des trois collections de tete. La pile de la
        tete de page dit « voici de quoi on parle » — avec trois formes vides
        elle ne disait rien du tout. */}
    <span class="tete-p__viz" aria-hidden="true">
      {cols.slice(0, 3).map((c) => {
        // 🔴 LOT 131 — `pile(c).find(…)` CHERCHAIT UNE IMAGE DANS LES TROIS
        // PREMIÈRES SEULEMENT. `items` est trié par plancher décroissant : les
        // trois premières sont les plus chères, donc les plus souvent des
        // variantes rares SANS couverture publiée (6 609 comics n'ont pas
        // d'`image_url`). Un set illustré à partir de sa 4ᵉ pièce rendait un
        // hexagone vide — la même faute que le visuel de set du lot 118, à
        // trois lignes de distance et jamais vue.
        // ⭐ On cherche dans TOUT le set : la tête de page dit « voici de quoi
        // on parle », et elle a le droit d'aller chercher son image plus loin
        // que les trois du haut.
        // ⛔ ET C'EST UN COMMENTAIRE `//`, PAS UN `{/* */}` : on est dans le
        // CORPS d'une flèche, pas dans du JSX. Un commentaire JSX en position
        // de retour a coûté un déploiement le 30/07 — c'est la panne qui a fait
        // naître `test:gabarits`, et je viens de la réécrire en la corrigeant.
        const v = c.items.find((i) => i.image);
        return (
          <span class="socle">
            <span class="socle__voile"></span>
            {v ? (
              <img class="socle__net ok" src={v.image} alt="" width="400" height="600"
                   loading="lazy" decoding="async" />
            ) : (
              <span class="forme forme--xl" style="--c-a:var(--rule-2)">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
                  <path d="M12 2.9 19.9 7.5v9L12 21.1 4.1 16.5v-9Z" /></svg>
              </span>
            )}
          </span>
        );
      })}
    </span>
  </div>

  {/* ═══ LE MODULE DE FILTRES — même vocabulaire que le Marché ═══
      ⭐ `barre-f`, `f-onglets`, `f-b`, `f-panneau`, `seg-p`, `cols-l`,
      `actifs`, `jeton` : rien de neuf. Deux écrans qui filtrent doivent
      filtrer PAREIL, sinon on réapprend l'interface à chaque page — et deux
      barres de filtres écrites séparément divergent en trois lots. */}
  {/* ═══════════════════════════════════════════════════════════════════
      🔴🔴 LOT 115 — LES FILTRES DEVIENNENT RÉSERVÉS (demande Preda, 10/08)
      ═══════════════════════════════════════════════════════════════════
      ⭐⭐⭐ ET C'EST CE QUI TRANCHE LE CONFLIT AVEC LA PAGINATION.
      Preda demandait « 20 par page pour tous » ET « pas de filtres hors
      connexion ». Les deux ensemble sont impossibles côté client : ces pages
      sont PRÉ-GÉNÉRÉES, membre et visiteur reçoivent le MÊME HTML. Un DOM
      réduit à 20 sets rendrait le filtre faux pour TOUT LE MONDE, connecté
      compris — et il RÉPONDRAIT quand même. *Un filtre qui cherche dans 20
      lignes sur 910 est pire qu'un filtre absent.*
      ⇒ On garde les 910 sets dans le DOM (donc pas de pagination ICI) et on
      réserve la COMMANDE. Les comics et les collectibles, eux, sont paginés :
      16 682 lignes ne tiennent pas en une page, et ils n'ont pas de filtre.
      ⭐ `data-membre` + `hidden`, ET SURTOUT PAS `{aUneSession && …}` : la
      règle du lot 100. Un bloc enveloppé dans un test de session disparaît du
      DOM sur les routes dynamiques et RESTE sur les pages statiques — deux
      pages, donc un défaut « parfois », donc irreproductible. `test:entete`
      refuse cette forme.
      ⛔ CE N'EST PAS UNE PORTE, C'EST UN AFFICHAGE. Les 910 sets restent dans
      le HTML public : ce sont des noms et des tailles, pas des prix. On retire
      un OUTIL, on ne cache pas une donnée — et il ne faut pas confondre les
      deux, sinon on croira le mur plus haut qu'il n'est. */}
  <p class="etiq filtres-mur" data-anonyme>{t(lang, 'sets.filtersLocked')}</p>
  <form class="barre-f" id="f-sets" role="search" data-membre hidden aria-label={t(lang, 'sets.filters')}>
    <div class="barre-f__l">
      <span class="barre-f__t">{t(lang, 'sets.filters')}</span>
      <div class="seg-p" role="group" aria-label={t(lang, 'movers.type')}>
        <button type="button" data-corpus="" aria-pressed="true">{t(lang, 'movers.all')} <span class="etiq" style="opacity:.7">{cols.length}</span></button>
        <button type="button" data-corpus="collectible" aria-pressed="false">Collectibles <span class="etiq" style="opacity:.7">{cols.length - nbComicSets}</span></button>
        <button type="button" data-corpus="comic" aria-pressed="false">Comics <span class="etiq" style="opacity:.7">{nbComicSets}</span></button>
      </div>
      <span class="sep-v"></span>
      <div class="champ champ--sm" style="flex:1;min-width:180px;max-width:280px">
        <label class="sr-only" for="s-q">{t(lang, 'sets.search')}</label>
        <input type="search" id="s-q" placeholder={t(lang, 'sets.search')} autocomplete="off" />
      </div>
      <div class="barre-f__tri">
        <label for="s-tri">{t(lang, 'movers.sortBy')}</label>
        <div class="champ champ--sm" style="width:200px">
          <select id="s-tri">
            <option value="taille">{t(lang, 'sets.sortSize')}</option>
            <option value="annee">{t(lang, 'sets.sortYear')}</option>
            <option value="nom">{t(lang, 'sets.sortName')}</option>
            {/* 🆕 LOT 133 — le tri par licence. ⚠️ Il n'est proposé QUE s'il y a
                de quoi trier : avec une seule licence au catalogue publié, cette
                option rendrait une liste identique à l'ordre d'avant, et un
                contrôle qui ne change rien apprend à ne plus cliquer dessus. */}
            {licences.length > 1 && <option value="licence">{t(lang, 'sets.sortLicence')}</option>}
          </select>
        </div>
      </div>
    </div>

    <div class="f-onglets" role="group" aria-label={t(lang, 'sets.filters')}>
      {/* 🆕 LOT 133 — LA LICENCE PASSE DEVANT LA MARQUE, et l'ordre est une
          mesure : 96 licences contre 1 492 marques au niveau set. L'axe le plus
          court est celui par lequel on commence. ⛔ Un filtre n'apparaît que
          s'il a au moins DEUX valeurs : à une seule, il ne sépare rien et il
          occupe la place d'un contrôle utile. */}
      {licences.length > 1 && (
        <button type="button" class="f-b" data-g="licence" aria-expanded="false" aria-controls="sp-licence">{t(lang, 'sets.licence')}<span class="cpt-f" hidden>0</span><Fragment set:html={chevron} /></button>
      )}
      {marques.length > 1 && (
        <button type="button" class="f-b" data-g="marque" aria-expanded="false" aria-controls="sp-marque">{t(lang, 'sets.brand')}<span class="cpt-f" hidden>0</span><Fragment set:html={chevron} /></button>
      )}
      {annees.length > 1 && (
        <button type="button" class="f-b" data-g="annee" aria-expanded="false" aria-controls="sp-annee">{t(lang, 'sets.year')}<span class="cpt-f" hidden>0</span><Fragment set:html={chevron} /></button>
      )}
      <button type="button" class="f-b" data-g="taille" aria-expanded="false" aria-controls="sp-taille">{t(lang, 'sets.size')}<span class="cpt-f" hidden>0</span><Fragment set:html={chevron} /></button>
      <button type="reset" class="f-b">{t(lang, 'movers.reset')}</button>
    </div>

    {licences.length > 1 && (
      <div class="f-panneau" id="sp-licence" hidden>
        <div class="f-panneau__t">{t(lang, 'sets.licence')}</div>
        {/* ⭐⭐ CHAQUE LICENCE PORTE SON NOMBRE DE SETS, et c'est ce qui rend la
            liste lisible : « Marvel 2 986 » dit d'un coup d'œil où est la
            matière. ⛔ Le nombre est celui des SETS, pas des pièces — c'est ce
            que la grille en dessous va montrer, et annoncer un chiffre qui ne
            correspond pas à ce qui s'affiche est la faute la plus coûteuse d'un
            filtre : il n'a pas l'air cassé, il a l'air faux.
            ⚠️ `data-b` COMME LE PANNEAU MARQUE : le champ de recherche du lot
            115b cherche cet attribut. Un second nom d'attribut aurait demandé un
            second script, pour le même geste. */}
        {/* LOT 143 - LA LISTE DES PUCES N'EST PLUS SERVIE, ELLE EST CONSTRUITE.
            Mesure du 12/08 sur la production : les 83 licences et les 469
            marques pesaient 84 423 o et 1 187 noeuds sur CHACUNE des visites,
            dans un formulaire porte par data-membre et hidden. Deux comptes
            existent ; les 3 097 pages sont pre-generees, donc tout le monde
            recevait le panneau, y compris ceux qui ne peuvent pas l'ouvrir.
            Aucune donnee ne disparait : chaque valeur etait DEJA dans le DOM,
            sur les cartes (data-lic et data-brand). Verifie a la mesure :
            83 sur 83 et 469 sur 469, et zero valeur absente du texte visible
            des cartes une fois les entites resolues.
            La construction lit LA CARTE, jamais le nom du set - c'est la meme
            source que garde() plus bas, donc les deux ne peuvent pas diverger.
            Le compteur se compte, il ne se recopie pas. */}
        {/* 🆕 LOT 170 — POINT `e` DE LA LISTE DE PREDA : UNE ZONE DE
            RECHERCHE DANS LE FILTRE LICENCE.
            🔴 LE COMMENTAIRE DU LOT 133 DISAIT L'INVERSE — « 96 licences
            tiennent à l'écran, 1 492 marques non » — et il faut écrire pourquoi
            on le retire plutôt que de le supprimer en silence.
            ⭐ SA PRÉMISSE A ÉTÉ REMESURÉE LE 21/08 sur `/rayon-index/sets.json`
            en production : **93 licences** pour 1 130 marques. Le chiffre tient
            donc encore. Ce qui a changé, c'est que Preda a demandé le champ
            APRÈS (point `e`), et 93 puces triées par nombre de sets décroissant
            ne se parcourent pas à l'œil quand on cherche un nom précis : elles
            ne sont pas dans l'ordre alphabétique.
            ⇒ *Un argument de conception juste ne survit pas à l'usage qu'il
            n'avait pas prévu.*
            ⭐⭐ COÛT RÉEL : ZÉRO NŒUD DE PLUS DANS LA LISTE. Les puces licence
            portent DÉJÀ `data-b` (posé par `remplirPuces()`, même attribut que
            les marques) — c'est le même pilote, appelé une seconde fois.
            ⛔ MÊMES GARDES QUE `#s-bq`, et pour les mêmes raisons : `name`
            absent et `form` absent, donc le champ ne part pas avec le
            formulaire et le bouton `reset` ne le vide pas ; il masque des
            étiquettes, il ne touche ni aux cases cochées ni à la grille. */}
        <label class="sr-only" for="s-lq">{t(lang, 'sets.licenceSearch')}</label>
        <input type="search" id="s-lq" class="champ-f" autocomplete="off"
               placeholder={t(lang, 'sets.licenceSearch')} />
        <div class="cols-l" id="s-lics" data-puces="lic"></div>
        <p class="etiq" id="s-lq-vide" hidden>{t(lang, 'sets.licenceNone')}</p>
      </div>
    )}

    {marques.length > 1 && (
      <div class="f-panneau" id="sp-marque" hidden>
        <div class="f-panneau__t">{t(lang, 'sets.brand')}</div>
        {/* 🔴 LOT 115b — UNE ZONE DE RECHERCHE DANS LE FILTRE MARQUE
            (demande Preda). Avec {marques.length} marques, une liste de cases à
            cocher se parcourt à l'œil ligne par ligne : chercher « Marvel »
            demande de le trouver, pas de le taper.
            ⭐ ELLE NE FILTRE QUE L'AFFICHAGE DES CASES, jamais les sets. Une
            case décochée reste décochée quand elle réapparaît — sinon taper
            trois lettres effacerait la sélection en cours, et personne ne
            comprendrait pourquoi la grille a bougé.
            ⛔ `type="search"` et non `type="text"` : le navigateur pose la
            croix d'effacement et l'annonce comme un champ de recherche.
            ⚠️ `form="..."` ABSENT ET `name` ABSENT : ce champ ne doit PAS
            partir avec le formulaire. Sans `name`, il n'est pas soumis — et le
            bouton `reset` du groupe ne le vide pas non plus, ce qui est le
            comportement voulu (on remet les cases à zéro, pas la recherche). */}
        <label class="sr-only" for="s-bq">{t(lang, 'sets.brandSearch')}</label>
        <input type="search" id="s-bq" class="champ-f" autocomplete="off"
               placeholder={t(lang, 'sets.brandSearch')} />
        {/* LOT 143 - construite, comme le panneau licence au-dessus.
            Le champ de recherche du lot 115b continue de chercher data-b : cet
            attribut est pose par la construction, avec la meme casse basse. */}
        <div class="cols-l" id="s-brands" data-puces="brand"></div>
        <p class="etiq" id="s-bq-vide" hidden>{t(lang, 'sets.brandNone')}</p>
      </div>
    )}

    {annees.length > 1 && (
      <div class="f-panneau" id="sp-annee" hidden>
        <div class="f-panneau__t">{t(lang, 'sets.year')}</div>
        <div class="tiroir__c">
          <div class="champ champ--sm" style="width:150px"><label class="etiq" for="s-a1">{t(lang, 'sets.yearFrom')}</label>
            <input id="s-a1" type="number" min={annees[0]} max={annees[annees.length - 1]} step="1" placeholder={annees[0]} /></div>
          <div class="champ champ--sm" style="width:150px"><label class="etiq" for="s-a2">{t(lang, 'sets.yearTo')}</label>
            <input id="s-a2" type="number" min={annees[0]} max={annees[annees.length - 1]} step="1" placeholder={annees[annees.length - 1]} /></div>
        </div>
        {/* ⭐ LA PHRASE QUI ÉVITE LA QUESTION SUIVANTE. Preda a demandé « par
            saison » ; ce panneau dit pourquoi c'est l'année, en un endroit où
            la question se pose. Une limite expliquée là où elle se rencontre
            coûte une phrase ; expliquée ailleurs, elle coûte un échange. */}
        <p class="etiq" style="margin:12px 0 0;color:var(--muted);max-width:60ch;text-transform:none;letter-spacing:0">
          {t(lang, 'sets.noSeason')}
        </p>
      </div>
    )}

    <div class="f-panneau" id="sp-taille" hidden>
      <div class="f-panneau__t">{t(lang, 'sets.size')}</div>
      <div class="tiroir__c">
        <div class="champ champ--sm" style="width:150px"><label class="etiq" for="s-tmin">{t(lang, 'sets.sizeMin')}</label>
          <input id="s-tmin" type="number" min="0" step="1" placeholder="1" /></div>
        <div class="champ champ--sm" style="width:150px"><label class="etiq" for="s-tmax">{t(lang, 'sets.sizeMax')}</label>
          <input id="s-tmax" type="number" min="0" step="1" placeholder={String(tailleMax)} /></div>
      </div>
    </div>

    <div class="actifs" id="s-actifs" aria-live="polite"></div>
    <p class="etiq" id="s-cpt" role="status"></p>
  </form>

  <p class="respire" id="s-vide" hidden>{t(lang, 'sets.empty')}</p>

  {/* 🔴🔴🔴 LOT 155-B — LES DEUX MORCEAUX QUE LE PILOTE NE DOIT PAS RÉÉCRIRE.
      Cette page ne rend plus que 60 cartes ; le pilote bâtit les autres depuis
      `/rayon-index/sets.json`. Deux morceaux d'une carte ne sont NI dans
      l'index NI dérivables : le glyphe de l'hexagone gris, et le libellé
      « pièces », qui est traduit.
      ⛔ ET ILS NE VOYAGENT PAS DANS UN ATTRIBUT `data-*`. C'est la panne de ce
      matin, payée 978 pages : `marquer_i18n.mjs` post-traite le HTML servi, et
      du HTML glissé dans un attribut désynchronise son analyse — build vert,
      aucun banc rouge. **Un `<template>` est fait exactement pour ça** : son
      contenu n'est jamais peint, il traverse le marquage i18n comme du corps de
      page, et `innerHTML` rend le glyphe DU SERVEUR.
      ⭐ Même mécanisme que `#r-cadenas` au lot 155-A, et pour la même raison :
      *quand deux fabriques doivent montrer la même chose, on transporte le
      RÉSULTAT, pas la recette.* */}
  <template id="s-hexa"><span class="forme forme--xl" style="--c-a:var(--rule-2)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M12 2.9 19.9 7.5v9L12 21.1 4.1 16.5v-9Z" /></svg></span></template>
  <template id="s-lot"><span class="etiq etiq--bleu"><b>0</b> {t(lang, 'collections.items')}</span></template>

  <span class="sep-v" aria-hidden="true"></span>
  <div class="grille grille--series" id="s-grille" data-rendu={String(PAR_TRANCHE)}>
    {/* ⭐ LE MÊME COMPOSANT QUE `/collections/`, AVEC ses attributs de filtre.
        `axes` est passé ici et seulement ici : c'est cette page qui porte le
        pilote qui les LIT (`data-n`, `data-brand`, `data-an`, `data-ty`,
        `data-taille`). ⛔ Le jour où le filtrage passe côté serveur, ces
        attributs disparaissent d'un seul endroit. */}
    {axes.slice(0, PAR_TRANCHE).map(({ c, an, ty }) => (
      <CarteSet lang={lang} col={c} axes={{ an, ty }} />
    ))}
  </div>
  {/* ⚡ LOT 139 — LE PILOTE DESCEND DANS LE SOCLE (mécanisme du lot 137).
      🔴 Il vivait ici en `is:inline`, et il ne mordait pas : il s'exécutait
      AVANT que `#s-plus` (3 935 octets plus bas) soit analysé, donc
      `getElementById` rendait `null` et la tranche montrait 910 cartes au lieu
      de 60. Le détail complet est en tête de `src/socle/modules/series.js`.
      ⭐ `defer` attend la fin de l'analyse par construction — la position du
      script dans le document cesse d'être un pari.
      ⛔ ET IL EST ÉMIS ICI, PAS DANS `Base.astro` : 3 096 pages sur 3 097 n'ont
      pas de grille de séries. Le verser au socle commun déplacerait le
      gaspillage au lieu de le supprimer — c'est l'arbitrage du cadran, lot 137. */}
  <script defer src={pilote.href}></script>
  {/* ═══ LOT 72 — LE DÉVOILEMENT PAR TRANCHES ═══
      🔴 Preda : « la page Sets met une limite d'affichage de 20 ». Il n'y avait
      AUCUNE limite dans le code — et c'est bien le problème : depuis que les
      comics sont regroupés par numéro, cette page rend **910 cartes portant
      chacune 3 vignettes**, soit près de 2 700 images. Un navigateur qui peine
      à poser 2 700 nœuds image donne exactement ce qu'il a décrit : une page
      qui s'arrête.
      ⭐⭐ « JE VOIS 20 CARTES » N'EST PAS FORCÉMENT « QUELQU'UN A ÉCRIT 20 ».
      J'ai cherché un plafond dans le CSS et dans le gabarit ; il n'y en avait
      pas. Ce que Preda décrivait n'était pas une règle, c'était une LIMITE DE
      RENDU — et c'est moi qui l'avais créée au lot précédent, en multipliant
      les sets par 1,2 sans toucher à la façon de les afficher.
      ⛔ Chercher la cause dans la couche où le symptôme s'exprime est le
      réflexe qui coûte le plus cher : la cause était deux lots en arrière.
      ⭐ 60 par tranche, comme le Marché en fait 20 : une carte de set est plus
      lourde qu'une ligne de tableau mais on en voit plus à l'écran. */}
  {axes.length > PAR_TRANCHE && (
    <p style="margin:var(--s5) 0 0;text-align:center">
      <button type="button" id="s-plus" class="btn btn--sm" data-pas={PAR_TRANCHE}
              data-total={String(axes.length)} data-index="/rayon-index/sets.json">{t(lang, 'movers.more')}</button>
      <span class="etiq" id="s-plus-cpt" style="display:block;margin-top:8px;color:var(--muted)"></span>
    </p>
  )}

  {/* ⛔ LOT 112 — LE SCEAU « REGISTRE INDÉPENDANT / jamais de prix modifié »
      EST RETIRÉ (demande Preda, 10/08). Il était le DERNIER endroit du site à
      le porter : `Market.astro` l'avait déjà perdu au lot 45.
      ⭐ LES DEUX CLÉS RESTENT VIVANTES dans les cinq dictionnaires —
      `home.independent` et `offer.p1`. `offer.p1` est encore rendue par
      `/offre/`, et `test:cles` ne dirait le contraire qu'APRÈS un build :
      c'est la panne du lot 34. On retire l'affichage, jamais le vocabulaire. */}
</Base>
