---
import Base from '../../layouts/Base.astro';
import { legalDoc } from '../../../engine/lib/legal.mjs';
import { t, localize } from '../../../engine/lib/i18n.mjs';
const { lang, doc, updatedAt } = Astro.props;
const { title, body } = legalDoc(lang, doc);
---
<Base lang={lang} path={`/legal/${doc}/`} title={title} description={title} updatedAt={updatedAt}
      crumbs={[{ name: t(lang, 'home.crumb'), url: localize(lang, '/') }, { name: title }]}>
  <h1>{title}</h1>
  <div class="legal" set:html={body} />
</Base>
