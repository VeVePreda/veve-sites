---
// ⚠️ VeVePreda/veve-sites — src/components/pages/Orientation.astro  (NEUF — lot 113)
//
// 🧭 `/collections/` DEVIENT UNE PAGE D'ORIENTATION — trois lignes, six cartes
//    chacune, un lien « tout voir » (arbitrage Preda, 10/08).
//
// ⛔ L'ADRESSE NE BOUGE PAS, ET C'EST LE POINT. `/collections/` est indexée ;
//    elle garde son autorité et change de rôle. La liste des sets qu'elle
//    portait part sur `/sets/`, qui est une adresse NEUVE — donc sans passé à
//    protéger. L'inverse (rediriger /collections/ vers /sets/) aurait dépensé
//    l'URL la plus évidente du site pour une page interne.
import Base from '../../layouts/Base.astro';
import Carte from '../Carte.astro';
import CarteSet from '../CarteSet.astro';
import AVenir from '../AVenir.astro';
import { dataset } from '../../../engine/lib/dataset.mjs';
import { t, localize, numberLocale } from '../../../engine/lib/i18n.mjs';

const { lang } = Astro.props;
const ds = await dataset();
const nf = numberLocale[lang] || 'en-GB';

// 🔴🔴 LOT 131 — `visuel` A DISPARU D'ICI, ET C'EST LE CŒUR DE LA CORRECTION.
//    Le lot 118 donnait à chaque set UNE image plate (`.col-carte__v`), pendant
//    que `/sets/` rendait le MÊME set en pile de trois vignettes. Preda,
//    10/08 : « les sets ne sont pas présentés de la façon habituelle ». Il ne
//    manquait pas une image : il en manquait deux, et une cartouche.
//    ⭐ La règle « prendre la première pièce QUI A une image, pas la première »
//    n'est pas perdue — elle a déménagé dans `CarteSet.astro`, où elle sert
//    maintenant les DEUX pages au lieu d'une.
//    ⛔ On ne garde pas `visuel` « au cas où » : un champ calculé que plus
//    personne ne lit est le faux positif de tout grep, et il ferait croire que
//    la forme plate est encore une option.
const sets = [...ds.collections.values()]
  .sort((a, b) => b.items.length - a.items.length).slice(0, 6);
// ⭐ On pioche dans `ds.items` (les 1 200 PUBLIÉES) et non dans `ds.rayon` :
//   une vitrine montre ce qui se clique. Le rayon complet est à un lien de là.
const parType = (k) => ds.items.filter((i) => (k === 'comic' ? i.type === 'comic' : i.type !== 'comic')).slice(0, 6);
const rangees = [
  { cle: 'sets', href: '/sets/', total: ds.collections.size },
  { cle: 'collectibles', href: '/collectibles/', total: ds.rayon.filter((r) => r.type !== 'comic').length },
  { cle: 'comics', href: '/comics/', total: ds.rayon.filter((r) => r.type === 'comic').length },
];
---
{/* ═══════════════════════════════════════════════════════════════════════
    🔴🔴 LOT 134 — SEO‑2 : CETTE PAGE PORTAIT LE TITRE DE `/sets/`
    ═══════════════════════════════════════════════════════════════════════
    `/collections/` et `/sets/` rendaient **le même `<title>`** — « Sets |
    VeVe Price » — depuis le lot 113, c'est-à-dire depuis que cette page a
    changé de rôle sans changer de titre. ⭐ Google n'en retient qu'une des
    deux : l'autre est indexée puis désindexée, et rien dans le dépôt ne le
    disait. C'est le défaut déjà corrigé le 29/07 pour les fiches, revenu par
    une autre porte.
    ⛔ ET LE `<h1>` CHANGE AVEC LE `<title>`, PAS APRÈS. Cette page n'est plus
    la liste des sets : elle oriente vers trois rayons. Un `<h1>` qui annonce
    « Sets » au-dessus de trois rangées dont une seule est faite de sets est
    exactement la même confusion, en plus visible. *Corriger le titre seul
    aurait laissé la page se contredire, et un titre qui ne dit pas ce que le
    `<h1>` dit est un signal négatif de plus, pas un de moins.*
    ⭐ `collections.title` (« Sets ») n'est pas perdue : elle reste le titre de
    `/sets/`, qui est bien la liste des sets, et elle sert toujours au libellé
    de rayon. Deux pages, deux clés — une clé partagée par deux pages qui
    divergent est le doublon qui revient.
    ⇒ `test:titres` (neuf) refuse désormais deux `<title>` identiques sur deux
    pages différentes. Il rougissait sur celle-ci avant ce lot. */}
<Base sect="sets" lang={lang} path="/collections/" updatedAt={ds.updatedAt}
      title={t(lang, 'orient.title')}
      description={t(lang, 'orient.desc')}
      crumbs={[{ name: t(lang, 'home.crumb'), url: localize(lang, '/') },
               { name: t(lang, 'orient.title') }]}>

  {/* 🔠 LOT 118 — LE TITRE REDESCEND D'UN CRAN. Preda, 10/08 : « titre de
      catégorie trop gros ». `sect-t--gd` est le format des TÊTES DE PAGE
      éditoriales (blog, offre), où le titre est le seul contenu au-dessus de
      la ligne de flottaison. Ici il coiffe trois rangées de cartes : il leur
      volait la vedette. ⛔ On ne touche pas au thème pour ça — la classe
      `sect-t--gd` est juste, elle était appliquée au mauvais endroit.
      *Corriger la règle CSS aurait rapetissé les titres des pages où elle a
      raison, sur les deux sites.* */}
  {/* 🔴🔴 LOT 139 — CETTE PAGE N'AVAIT PAS DE TÊTE DE PAGE, ET `/sets/` EN A
      UNE (demande Preda : « harmoniser le design de /collections/ avec les
      autres pages »). Mesuré avant de coder : **0 `tete-p`** ici, une sur
      `/sets/`. Or c'est CETTE page que le menu propose (`nav.collections`) —
      le visiteur voyait donc la forme pauvre en premier et la forme riche
      seulement s'il allait plus loin. ⭐ Exactement l'arbitrage du lot 131 sur
      les cartes de set, un cran au-dessus : *la page d'entrée d'un rayon ne
      peut pas être la moins soignée du rayon.*
      ⛔ ON RÉUTILISE `tete-p`, ON N'EN INVENTE PAS UNE DEUXIÈME : la classe
      existe, elle est servie, et une variante `tete-p--orient` serait la
      divergence qu'on passe ce lot à refermer.
      ⚠️ Le `<h1>` DÉMÉNAGE dans la tête, il n'est pas DUPLIQUÉ : `test:titres`
      exige un seul `<h1>` par page et il aurait rougi — c'est ce qu'on veut
      d'un banc. Le `sect-t` qui le portait disparaît avec lui. */}
  <div class="tete-p">
    <div>
      {/* ⛔ PAS DE `.toUpperCase()` ICI. `.etiq` porte déjà
          `text-transform:uppercase`, et la version markup détruirait la
          traduction : `t()` marque son libellé d'une clé, que la mise en
          capitales rendrait introuvable dans le dictionnaire (P30, 1 199
          libellés). La casse est une affaire de STYLE. */}
      <p class="etiq etiq--bleu">// {t(lang, 'orient.title')}</p>
      <h1 class="mono-t">{t(lang, 'orient.title')}</h1>
      <p class="respire">{t(lang, 'orient.desc')}</p>
    </div>
    {/* ⭐ LA PILE DIT DE QUOI PARLE L'ÉCRAN AVANT QU'ON LISE LE TITRE — et elle
        prend de VRAIES pièces. ⛔ On cherche l'image dans TOUT le set, pas dans
        ses trois premières : `items` est trié par plancher décroissant, donc
        les plus chères sont souvent des variantes rares sans couverture
        (6 609 comics n'ont pas d'`image_url`). Un set illustré à partir de sa
        4ᵉ pièce rendrait un hexagone vide — la faute du lot 118, déjà payée
        deux fois. */}
    <span class="tete-p__viz" aria-hidden="true">
      {sets.slice(0, 3).map((c) => {
        const img = (c.items || []).find((i) => i.image);
        return img
          ? <span class="socle"><img class="socle__net ok" src={img.image} alt=""
                   width="400" height="600" loading="lazy" decoding="async" /></span>
          : <span class="forme forme--xl" style="--c-a:var(--rule-2)">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
                <path d="M12 2.9 19.9 7.5v9L12 21.1 4.1 16.5v-9Z" />
              </svg>
            </span>;
      })}
    </span>
  </div>

  <AVenir lang={lang} />

  {rangees.map((r) => (
    <section class="orient">
      <div class="sect-t">
        <h2 class="mono-t">{t(lang, `rayon.${r.cle}`)}</h2>
        {/* ⭐ LE CHIFFRE EST CELUI DU RAYON ENTIER, pas des six cartes montrées.
            « 16 682 » dit ce qu'il y a derrière le lien ; « 6 » ne dirait rien. */}
        <a class="orient__t" href={localize(lang, r.href)}>{t(lang, 'orient.tout', { n: r.total.toLocaleString(nf) })}</a>
      </div>
      {r.cle === 'sets'
        ? <div class="grille grille--series">
            {/* ⭐ LE MÊME COMPOSANT QUE `/sets/`, SANS SES ATTRIBUTS DE FILTRE.
                `axes` n'est pas passé : cette page n'a pas de pilote de filtres,
                et des `data-*` que personne ne lit sont exactement le
                « paramètre posé et jamais lu » du lot 126. */}
            {sets.map((c) => (<CarteSet lang={lang} col={c} />))}
          </div>
        : <div class="grille">
            {parType(r.cle === 'comics' ? 'comic' : 'collectible').map((i, k) => (
              <Carte item={i} lang={lang} href={localize(lang, i.path)} nf={nf} i={k} />
            ))}
          </div>}
    </section>
  ))}
</Base>
