{
  "name": "veve-sites",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "node ./dist/server/entry.mjs",
    "slugs": "node engine/tools/freeze-slugs.mjs",
    "audit": "python3 engine/tools/audit_seo.py dist",
    "test:slugs": "python3 engine/tools/test_slugs.py",
    "test:donnees": "node engine/tools/test_concurrence.mjs",
    "test:quotas": "node engine/tools/test_quotas.mjs",
    "test": "npm run test:donnees && npm run test:quotas && npm run test:slugs"
  },
  "dependencies": {
    "@astrojs/node": "^11.0.2",
    "astro": "^7.1.1",
    "js-yaml": "^5.2.1"
  }
}